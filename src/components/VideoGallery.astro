---
/**
 * Lapozható mintavideó-galéria: a `src/data/demoVideos.ts` összes videója
 * telefonkeretben, alattuk cím + címkék. Csak a sáv – a szekciót (háttér, cím)
 * az oldal adja, így bármelyik oldalra bevágható.
 *
 * A videók kattintásra, HANGGAL indulnak (`DemoVideo mode="click"`), egyszerre
 * egy szól; ami kilapozódik, megáll. Desktopon 4, tableten 3/2, mobilon ~1 kártya
 * látszik (a kártya szélességét a `Carousel` konvenciója szerint ő adja meg).
 */
import type { Locale } from '../i18n/routes';
import Carousel from './Carousel.astro';
import DemoVideo from './DemoVideo.astro';
import { demoVideosFor } from '../data/demoVideos';

interface Props {
    locale: Locale;
    /** `dark`: sötét sávon (fehér szöveg), `light`: világos háttéren. */
    theme?: 'dark' | 'light';
}

const { locale, theme = 'light' } = Astro.props;
const videos = demoVideosFor(locale);

const ui = {
    hu: { label: 'AI-val készült mintavideók', prev: 'Előző videó', next: 'Következő videó', format: 'formátum' },
    en: { label: 'Sample videos made with AI', prev: 'Previous video', next: 'Next video', format: 'format' },
}[locale];

const titleClass = theme === 'dark' ? 'text-white' : 'text-dark';
const chipClass = theme === 'dark' ? 'bg-white/10 text-white/80' : 'bg-primary/10 text-primary';
const formatClass = theme === 'dark' ? 'text-white/50' : 'text-muted';
---

<Carousel label={ui.label} prevLabel={ui.prev} nextLabel={ui.next}>
    {videos.map((v) => (
        <div class="shrink-0 snap-start basis-[78%] sm:basis-[calc((100%-1.5rem)/2)] md:basis-[calc((100%-3rem)/3)] lg:basis-[calc((100%-4.5rem)/4)]">
            <DemoVideo
                locale={locale}
                src={v.src}
                poster={v.poster}
                label={v.title}
                fit={v.format === '9:16' ? 'cover' : 'contain'}
                mode="click"
                fill
            />
            <div class="mt-4 px-1">
                <h3 class:list={['font-bold text-base leading-snug', titleClass]}>{v.title}</h3>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    {v.tags.map((tag) => (
                        <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', chipClass]}>{tag}</span>
                    ))}
                </div>
                <p class:list={['mt-2 text-xs', formatClass]}>{v.format} {ui.format}</p>
            </div>
        </div>
    ))}
</Carousel>
