---
import { pathFor, type Locale, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { navModulesFor } from '../data/modules';
import MetaTechProvider from './MetaTechProvider.astro';
import UnasPartner from './UnasPartner.astro';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale } = Astro.props;
const ui = t(locale);
const bookDemo = pathFor('bookDemo', locale);
const APP_URL = 'https://app.getcontentninja.com';

// 2026 augusztusa óta MINDEN jogi oldal létezik mindkét nyelven, ezért mindegyik
// az aktuális locale saját verziójára mutat (korábban a terms és a dataDeletion
// fixen az EN oldalra ment).
const contact = pathFor('contact', locale);
const SUPPORT_EMAIL = 'support@getcontentninja.com';

// Publikus changelog: az app aldomainjén él, nyelvenként külön útvonalon.
const CHANGELOG_URL = locale === 'en' ? `${APP_URL}/changelog/en` : `${APP_URL}/changelog`;

// A blog egynyelvű (magyar), ezért csak a /hu/ oldalak láblécében szerepel.
const BLOG_URL = 'https://blog.getcontentninja.com/';
const showBlog = locale === 'hu';

const legal = {
  contact,
  privacy: pathFor('privacy', locale),
  imprint: pathFor('imprint', locale),
  terms: pathFor('terms', locale),
  dataDeletion: pathFor('dataDeletion', locale),
};

// A "Megoldások" hasáb ugyanabból a listából épül, mint a fejléc menü és a
// modulrács (`src/data/modules.ts`) – új modul itt is magától megjelenik.
const solutions = navModulesFor(locale);
---

<footer class="bg-dark text-muted">
  <!-- A hitelesítés-csík (Meta + UNAS) innen KIKERÜLT a hero alá – lásd
       `TrustBadges.astro`. Ne tedd vissza ide anélkül, hogy onnan kivennéd:
       kétszer ugyanaz a jelvénypár egy oldalon inflálja a bizonyítékot. -->
  <div class="py-14 px-4 md:px-10">
   <div class="max-w-[1200px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
      <!-- Brand -->
      <div>
        <div class="bg-white p-3 rounded-[10px] inline-block mb-4">
          <img src="/assets/logo.webp" alt={ui.logoAlt} class="h-9 w-auto object-contain" />
        </div>
        <p class="text-sm leading-relaxed max-w-[280px] mb-5">{ui.footer.tagline}</p>
        <a href={`mailto:${SUPPORT_EMAIL}`} class="flex items-center gap-2 text-sm mb-5 hover:text-white transition-colors">
          <span class="material-symbols-outlined text-[18px] text-white/70">mail</span>
          {SUPPORT_EMAIL}
        </a>
        <div class="flex items-center gap-3">
          <a
            href="https://www.facebook.com/profile.php?id=61582389145717"
            target="_blank"
            rel="noopener"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
            aria-label="Facebook"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-white">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          <a
            href="https://www.instagram.com/contentninjahu/"
            target="_blank"
            rel="noopener"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
            aria-label="Instagram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href="https://www.tiktok.com/@tamasmarko"
            target="_blank"
            rel="noopener"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
            aria-label="TikTok"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-white">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@ContentNinja_HU"
            target="_blank"
            rel="noopener"
            class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
            aria-label="YouTube"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-white">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z" />
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#1e1e2f" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Megoldások (modulok) -->
      <div>
        <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wide">{ui.nav.solutions}</h4>
        <ul class="space-y-2 text-sm">
          {solutions.map((item) => (
            <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Információk: elöl a nem jogi elemek (kapcsolat, changelog), utánuk a jogi oldalak -->
      <div>
        <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wide">{ui.footer.infoHeading}</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={legal.contact} class="hover:text-white transition-colors">{ui.footer.contact}</a></li>
          <li><a href={CHANGELOG_URL} class="hover:text-white transition-colors">{ui.footer.whatsNew}</a></li>
          {showBlog && <li><a href={BLOG_URL} class="hover:text-white transition-colors">{ui.nav.blog}</a></li>}
          <li><a href={legal.privacy} class="hover:text-white transition-colors">{ui.footer.privacy}</a></li>
          <li><a href={legal.imprint} class="hover:text-white transition-colors">{ui.footer.imprint}</a></li>
          <li><a href={legal.terms} class="hover:text-white transition-colors">{ui.footer.terms}</a></li>
          <li><a href={legal.dataDeletion} class="hover:text-white transition-colors">{ui.footer.dataDeletion}</a></li>
        </ul>
      </div>

      <!-- CTAs -->
      <div>
        <h4 class="text-white font-bold mb-4 text-sm uppercase tracking-wide">{ui.footer.startHeading}</h4>
        <div class="flex flex-col gap-3">
          <a href={bookDemo} class="cta-primary bg-primary hover:bg-primary-hover px-5 py-2.5 text-sm w-fit">
            <span class="material-symbols-outlined text-[16px]">calendar_month</span>
            {ui.cta.demo}
          </a>
          <a href={APP_URL} target="_blank" class="cta-outline-white px-5 py-2.5 text-sm w-fit">
            <span class="material-symbols-outlined text-[16px]">login</span>
            {ui.cta.login}
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 text-center text-xs">
      <p>{ui.footer.copyright}</p>
    </div>
   </div>
  </div>
</footer>
