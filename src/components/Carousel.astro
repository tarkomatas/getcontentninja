---
/**
 * Vízszintes, lapozgatható kártyasáv (scroll-snap + nyilak + pontok).
 *
 * A kártyák slotban jönnek, és ŐK határozzák meg, hány látszik egyszerre –
 * a szélességet a hívó oldal adja meg rajtuk (pl. a főoldali megoldás-kártyák
 * `lg:basis-[calc((100%-4.5rem)/4)]`, tehát desktopon 4 kártya látszik).
 * A nyíl EGY kártyát lép, így a látható sávban soha nincs üres hely.
 *
 * Külső könyvtár nélkül: natív scroll-snap + pár soros JS. Több példány is
 * lehet egy oldalon (a JS a `[data-carousel]` gyökérre szűkít).
 */
interface Props {
  label: string;
  prevLabel: string;
  nextLabel: string;
  /** Extra osztályok a külső wrapperre. */
  class?: string;
  /** `dark`: sötét sávra – áttetsző, árnyék nélküli nyilak és halvány pontok. */
  variant?: 'light' | 'dark';
  /**
   * Automatikus lapozás ennyi ms-onként (0 = ki). Megáll, amíg az egér/fókusz a
   * sávon van, amíg egy videó hanggal szól, ha a sáv nincs látótérben vagy a fül
   * háttérben van, és csökkentett mozgásnál sem fut. Kézi lapozás után újraindul.
   */
  autoAdvance?: number;
}

const { label, prevLabel, nextLabel, class: className = '', variant = 'light', autoAdvance = 0 } = Astro.props;

const arrowClass =
  variant === 'dark'
    ? 'w-12 h-12 rounded-full border border-white/25 bg-white/10 text-white backdrop-blur flex items-center justify-center transition-all hover:bg-primary hover:border-primary disabled:opacity-25 disabled:pointer-events-none'
    : 'w-11 h-11 rounded-full border border-border bg-card text-dark shadow-card flex items-center justify-center transition-all hover:border-primary hover:text-primary disabled:opacity-40 disabled:pointer-events-none';
// A pontok inaktív színe – a JS ezt váltja a `bg-primary`-vel.
const dotIdle = variant === 'dark' ? 'bg-white/25' : 'bg-border';
---

<div class={`relative ${className}`} data-carousel data-dot-idle={dotIdle} data-auto-advance={autoAdvance || undefined}>
  <div
    data-carousel-track
    class="flex gap-6 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-2"
    role="group"
    aria-label={label}
  >
    <slot />
  </div>

  <div class="flex items-center justify-center gap-4 mt-8">
    <button type="button" data-carousel-prev aria-label={prevLabel} class={arrowClass}>
      <span class="material-symbols-outlined text-[22px]">chevron_left</span>
    </button>

    <div class="flex items-center gap-2" data-carousel-dots></div>

    <button type="button" data-carousel-next aria-label={nextLabel} class={arrowClass}>
      <span class="material-symbols-outlined text-[22px]">chevron_right</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('[data-carousel-track]') as HTMLElement | null;
    const prev = root.querySelector('[data-carousel-prev]') as HTMLButtonElement | null;
    const next = root.querySelector('[data-carousel-next]') as HTMLButtonElement | null;
    const dotsWrap = root.querySelector('[data-carousel-dots]') as HTMLElement | null;
    if (!track || !prev || !next || !dotsWrap) return;
    const dotIdle = (root as HTMLElement).dataset.dotIdle ?? 'bg-border';

    const cards = Array.from(track.children) as HTMLElement[];
    if (cards.length === 0) return;

    // Egy lépés = kártyaszélesség + rés (a rés a tényleges pozíciókból jön ki).
    const step = () =>
      cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : cards[0].offsetWidth;

    // Hány kártya látszik egyszerre – ez töréspontonként más, ezért mérjük.
    const visible = () => Math.max(1, Math.round(track.clientWidth / step()));

    let dots: HTMLButtonElement[] = [];

    function renderDots() {
      // Csak annyi pont, ahány pozícióra tényleg lehet lapozni.
      const count = Math.max(1, cards.length - visible() + 1);
      if (dots.length === count) return;
      dotsWrap.innerHTML = '';
      dots = Array.from({ length: count }, (_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `h-2 rounded-full ${dotIdle} transition-all`;
        dot.setAttribute('aria-label', String(i + 1));
        dot.addEventListener('click', () => {
          track.scrollTo({ left: cards[i].offsetLeft - cards[0].offsetLeft, behavior: 'smooth' });
        });
        dotsWrap.appendChild(dot);
        return dot;
      });
    }

    function update() {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;

      renderDots();
      const active = Math.min(dots.length - 1, Math.round(track.scrollLeft / step()));
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-primary', i === active);
        dot.classList.toggle(dotIdle, i !== active);
        dot.classList.toggle('w-6', i === active);
        dot.classList.toggle('w-2', i !== active);
      });

      // Egyetlen "oldal" esetén (minden kártya kilátszik) nincs mit lapozni.
      const idle = max <= 2;
      prev.classList.toggle('hidden', idle);
      next.classList.toggle('hidden', idle);
      dotsWrap.classList.toggle('hidden', idle);
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Automatikus lapozás (csak ha a hívó kéri: `autoAdvance`).
    const autoMs = Number((root as HTMLElement).dataset.autoAdvance || 0);
    if (autoMs > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let onScreen = false;
      let held = false; // egér vagy billentyűzet-fókusz a sávon
      let timer = 0;

      // Ha egy videó épp hanggal szól, nem lapozunk el alóla.
      const soundPlaying = () =>
        Array.from(track.querySelectorAll('video')).some((v) => !v.muted && !v.paused);

      const tick = () => {
        if (!onScreen || held || document.hidden || soundPlaying()) return;
        const max = track.scrollWidth - track.clientWidth;
        if (max <= 2) return;
        if (track.scrollLeft >= max - 2) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: step(), behavior: 'smooth' });
      };
      // Kézi lapozás után elölről indul a várakozás, hogy ne ugorjon tovább azonnal.
      const restart = () => {
        window.clearInterval(timer);
        timer = window.setInterval(tick, autoMs);
      };

      // Csak valódi egér (érintésnél a koppintás „ráragadna") és csak billentyűzet-fókusz
      // (egérrel kattintott nyílon is ott marad a fókusz, az ne állítsa meg végleg).
      root.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') held = true;
      });
      root.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') held = false;
      });
      root.addEventListener('focusin', (e) => {
        if ((e.target as Element).matches(':focus-visible')) held = true;
      });
      root.addEventListener('focusout', () => (held = false));
      [prev, next, dotsWrap].forEach((el) => el.addEventListener('click', restart));
      track.addEventListener('pointerdown', restart);

      new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting), { threshold: 0.3 }).observe(root);
      restart();
    }
  });
</script>
