---
/**
 * A „Hogyan működik?" blokkok számozott lépéskártyái – EGY helyen.
 *
 * Kártyánként: a sorszám és a rövid cím egy sorban, alatta egy mondat. Balra
 * zárt, hogy a rövid szöveg ne essen szét rongyos, középre zárt sorokra.
 *
 * Szövegszabály (page-copy): a cím 1–2 szó (~15 karakter – a 4 hasábos
 * rácsban ennyi fér el a sorszám mellett egy sorban), a leírás EGY mondat.
 * A részletek a lenti szekciókba és a GYIK-be valók, nem ide.
 *
 * A `desc` HTML-t is kaphat (pl. `text-primary` kiemelés) – csak saját,
 * a forrásban álló szöveg kerülhet bele.
 */
interface Step {
    title: string;
    desc: string;
}

interface Props {
    steps: Step[];
    /** A kártya háttere: `bg-light` szekción `bg-card` (alap), `bg-card` szekción `bg-light`. */
    cardClass?: string;
}

const { steps, cardClass = 'bg-card' } = Astro.props;
const gridClass =
    steps.length === 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4';
---

<ol class:list={['grid gap-4 lg:gap-6', gridClass]}>
    {steps.map((s, i) => (
        <li class:list={[cardClass, 'rounded-[16px] border border-border p-5 sm:p-8 shadow-card']}>
            <div class="flex items-center gap-3 mb-3">
                <span class="w-9 h-9 rounded-full bg-primary text-white font-extrabold flex items-center justify-center shrink-0 shadow-primary-glow">{i + 1}</span>
                <h3 class="font-bold text-lg leading-snug">{s.title}</h3>
            </div>
            <p class="text-body text-sm leading-relaxed" set:html={s.desc} />
        </li>
    ))}
</ol>
