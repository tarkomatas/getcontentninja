---
import { homeFor, pathFor, type Locale, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { MODULE_UI, NAV_INTEGRATION, navGroupsFor } from '../data/modules';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const ui = t(locale);
const home = homeFor(locale);
const bookDemo = pathFor('bookDemo', locale);
const APP_URL = 'https://app.getcontentninja.com';

// Megj.: nincs külön "funkciók" szekció az oldalon, ezért a korábban árva
// (#funkciok) nav-elemet elhagytuk – csak létező horgonyokra mutatunk.
// A "Megoldások" lenyíló menü önálló kampányoldalakra mutat (nem horgonyokra),
// és a `src/data/modules.ts` NAV_GROUPS listájából épül – ami szándékosan NEM a
// modulok leképezése (lásd az ottani kommentet: a blogcikk író két csoportban
// szerepel, a Shopgrade két néven). Két hasáb, csoportonként egy blokk; a
// csoportcím maga is link, ha van gyűjtőoldala. A panel alján külön sávban a
// webshop-integráció, a támogatott boltmotorok logójával – ez válaszolja meg a
// leggyakoribb néma kérdést („az én rendszeremmel működik?").
// A fejléc elsődleges "Bemutatót kérek" CTA-ja ezzel szemben a bookDemo oldalra visz.
const solutionGroups = navGroupsFor(locale);
const integration = {
  href: pathFor(NAV_INTEGRATION.page, locale),
  label: NAV_INTEGRATION[locale].label,
  icon: NAV_INTEGRATION.icon,
  logos: NAV_INTEGRATION.logos,
};
const moduleUi = MODULE_UI[locale];
const navItems = [
  { href: `${home}#velemenyek`, label: ui.nav.testimonials },
  { href: `${home}#arazas`, label: ui.nav.pricing },
  { href: pathFor('contact', locale), label: ui.nav.contact },
];
---

<header id="top" class="bg-card border-b border-border sticky top-0 z-50 shadow-card">
  <div class="max-w-[1200px] mx-auto px-4 md:px-10 py-3 flex items-center justify-between gap-6">
    <!-- Logo -->
    <a href={home} class="shrink-0">
      <img src="/assets/logo.webp" alt={ui.logoAlt} class="h-12 md:h-14 w-auto object-contain" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8 lp-hide" aria-label={ui.nav.aria}>
      <!-- Megoldások lenyíló (hoverre + fókuszra nyílik, a pt-2 híd tartja a hovert) -->
      <div class="relative group">
        <button
          type="button"
          class="nav-link text-sm flex items-center gap-1 cursor-pointer"
          aria-haspopup="true"
        >
          {ui.nav.solutions}
          <span class="material-symbols-outlined text-[18px] transition-transform duration-150 group-hover:rotate-180">expand_more</span>
        </button>
        <div class="absolute left-0 top-full pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-150 z-50">
          <div class="w-[600px] max-w-[calc(100vw-3rem)] bg-card border border-border rounded-[14px] shadow-card-hover p-2">
            <div class="grid grid-cols-2 gap-x-1 gap-y-2 items-start">
              {solutionGroups.map((group) => (
                <div>
                  {group.href ? (
                    <a href={group.href} class="flex items-center gap-1 px-3 pt-1 pb-1.5 text-[11px] font-bold uppercase tracking-wider text-body/60 hover:text-primary transition-colors">
                      {group.label}
                      <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </a>
                  ) : (
                    <span class="block px-3 pt-1 pb-1.5 text-[11px] font-bold uppercase tracking-wider text-body/60">{group.label}</span>
                  )}
                  {group.items.map((item) => (
                    <a href={item.href} class="flex items-start gap-2.5 px-3 py-2 rounded-[10px] hover:bg-light transition-colors group/item">
                      <span class="material-symbols-outlined text-primary text-[20px] mt-0.5 shrink-0">{item.icon}</span>
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold text-dark group-hover/item:text-primary transition-colors">
                          {item.label}
                          {item.badge && (
                            <span class="ml-1.5 align-middle bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded-full">{item.badge}</span>
                          )}
                        </span>
                        <span class="block text-xs text-body mt-0.5 leading-snug">{item.desc}</span>
                      </span>
                    </a>
                  ))}
                </div>
              ))}
            </div>

            <!-- Integrációs sáv: a feltétel, nem megoldás – ezért van a csoportokon kívül -->
            <a href={integration.href} class="flex items-center justify-between gap-3 mt-1 px-3 py-2.5 border-t border-border hover:bg-light rounded-[10px] transition-colors group/int">
              <span class="flex items-center gap-2.5 min-w-0">
                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">{integration.icon}</span>
                <span class="text-sm font-semibold text-dark group-hover/int:text-primary transition-colors">{integration.label}</span>
              </span>
              <span class="flex items-center gap-2.5 shrink-0">
                {integration.logos.map((logo) => (
                  <img src={logo.src} alt={logo.alt} class="h-[20px] w-auto opacity-80" loading="lazy" />
                ))}
              </span>
            </a>

            <a href={`${home}#megoldasok`} class="flex items-center justify-center gap-1.5 pt-2 border-t border-border text-sm font-bold text-primary hover:bg-light rounded-[10px] py-2.5 transition-colors">
              {moduleUi.allSolutions}
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
      {navItems.map((item) => (
        <a href={item.href} class="nav-link text-sm">{item.label}</a>
      ))}
    </nav>

    <!-- CTAs + language + hamburger -->
    <div class="flex items-center gap-3 shrink-0">
      <LanguageSwitcher locale={locale} page={page} class="!hidden md:!inline-flex lp-show" />
      <a href={APP_URL} target="_blank" class="cta-secondary !hidden md:!inline-flex items-center gap-2 px-4 py-2 text-sm lp-hide">
        <span class="material-symbols-outlined text-[16px]">login</span>
        {ui.cta.login}
      </a>
      <!-- A demo-CTA landing módban IS látszik (lp-show), mobilon is: a főoldali hero
           CTA-gombok helyére az integrációs logósor került, így hirdetési forgalomnál
           ez az első kattintható konverziós pont. Mobilon rövid felirattal, hogy a
           logó + nyelvváltó mellett elférjen. (A nav és a login továbbra is lp-hide.) -->
      <a href={bookDemo} class="cta-primary !hidden md:!inline-flex items-center gap-2 px-4 py-2 text-sm lp-show">
        <span class="material-symbols-outlined text-[16px]">calendar_month</span>
        <span class="hidden md:inline">{ui.cta.demo}</span>
        <span class="md:hidden">{ui.cta.demoShort}</span>
      </a>
      <!-- Hamburger (mobile only) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden lp-hide flex items-center justify-center w-10 h-10 rounded-[10px] border border-border text-dark hover:bg-light transition-colors"
        aria-label={ui.nav.menuAria}
      >
        <span id="hamburger-icon" class="material-symbols-outlined text-[22px]">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile nav dropdown -->
  <div id="mobile-menu" class="hidden md:hidden lp-hide border-t border-border bg-card px-4 pb-4">
    <nav class="flex flex-col gap-1 pt-3" aria-label={ui.nav.mobileAria}>
      <!-- Megoldások szekció – ugyanazokkal a csoportokkal, mint a desktop panel -->
      <span class="px-3 pt-1 pb-1 text-xs font-semibold uppercase tracking-wide text-body/70">{ui.nav.solutions}</span>
      {solutionGroups.map((group) => (
        <>
          <span class="px-3 pt-2 pb-0.5 text-[11px] font-bold uppercase tracking-wider text-body/50">{group.label}</span>
          {group.items.map((item) => (
            <a href={item.href} class="mobile-nav-link flex items-center gap-3 text-sm px-3 py-2.5 rounded-[8px] hover:bg-light">
              <span class="material-symbols-outlined text-primary text-[20px]">{item.icon}</span>
              <span class="font-medium text-dark">
                {item.label}
                {item.badge && (
                  <span class="ml-1.5 align-middle bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded-full">{item.badge}</span>
                )}
              </span>
            </a>
          ))}
        </>
      ))}
      <!-- Az integráció mobilon is külön sáv: elválasztó vonal, nehogy a
           tartalommarketing csoport negyedik elemének látsszon. -->
      <div class="border-t border-border mt-3 mb-2"></div>
      <a href={integration.href} class="mobile-nav-link flex items-center gap-3 text-sm px-3 py-2.5 rounded-[8px] hover:bg-light">
        <span class="material-symbols-outlined text-primary text-[20px]">{integration.icon}</span>
        <span class="font-medium text-dark">{integration.label}</span>
        <span class="flex items-center gap-2.5 ml-auto">
          {integration.logos.map((logo) => (
            <img src={logo.src} alt={logo.alt} class="h-[18px] w-auto opacity-80" loading="lazy" />
          ))}
        </span>
      </a>
      <div class="border-t border-border my-2"></div>
      {navItems.map((item) => (
        <a href={item.href} class="mobile-nav-link nav-link text-sm px-3 py-2.5 rounded-[8px] hover:bg-light">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex flex-col gap-2 mt-4 pt-4 border-t border-border">
      <LanguageSwitcher locale={locale} page={page} class="justify-center px-4 py-2.5 rounded-[8px] hover:bg-light" />
      <a href={APP_URL} target="_blank" class="cta-secondary flex items-center justify-center gap-2 px-4 py-2.5 text-sm">
        <span class="material-symbols-outlined text-[16px]">login</span>
        {ui.cta.loginApp}
      </a>
      <a href={bookDemo} class="cta-primary flex items-center justify-center gap-2 px-4 py-2.5 text-sm">
        <span class="material-symbols-outlined text-[16px]">calendar_month</span>
        {ui.cta.demo}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('hamburger-icon');

  if (btn && menu && icon) {
    btn.addEventListener('click', function () {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      icon.textContent = isOpen ? 'menu' : 'close';
    });

    document.querySelectorAll('.mobile-nav-link').forEach(function (link) {
      link.addEventListener('click', function () {
        menu.classList.add('hidden');
        icon.textContent = 'menu';
      });
    });
  }
</script>
