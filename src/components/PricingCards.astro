---
/**
 * Az ároldali/kampányoldali árblokk: számlázási ciklus csúszka + két kártya
 * (előfizetés · bemutató bónusz).
 *
 * EGY forrás: korábban ez a blokk 18 oldalfájlban volt kézzel másolva, ezért
 * csúszott el egymástól (lásd a ModuleGrid tanulságát a CLAUDE.md-ben). Ha az
 * ár vagy a kredit változik, CSAK ezt a fájlt kell átírni.
 *
 * A ciklusváltó úgy működik, hogy MINDKÉT állapot markupja benne marad a
 * HTML-ben, és csak CSS rejti a nem aktívat (`.cycle-monthly` / `.cycle-annual`
 * a global.css-ben). Két haszna van:
 *   1. a kereső és az AI-fetcherek mindkét árat látják (nem JS rajzolja ki),
 *   2. nincs villanás betöltéskor – az alapállapotot a `data-cycle="annual"`
 *      adja már szerveroldalon, a script csak billent.
 *
 * A bemutató bónusz kártya SZÁNDÉKOSAN statikus: mindig a havi bevezető árat
 * mutatja, nem követi a csúszkát. A címe ezért ciklus-semleges.
 *
 * Props:
 *   locale  – 'hu' | 'en'
 *   ctaHref – hova visz mindkét gomb (kampányoldalakon '#hero', egyébként a
 *             bemutató-kérő oldal)
 *   cardBg  – a kártyák háttere. Alap: 'bg-card' (világosszürke `bg-light`
 *             szekcióban). Ahol a SZEKCIÓ maga fehér (`bg-card`) – ilyen a
 *             teljes-rendszer és az all-in-one –, ott 'bg-light' kell, különben
 *             a kártya beleolvad a háttérbe.
 */
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
  ctaHref?: string;
  cardBg?: string;
}

const { locale, ctaHref, cardBg = 'bg-card' } = Astro.props;

const href = ctaHref ?? (locale === 'hu' ? '/hu/online-bemutato/' : '/en/book-demo/');

const t = {
  hu: {
