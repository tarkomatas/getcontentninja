---
/**
 * Hero-jelenet: „egy termékből négy tartalom" – a főoldal (HU) jobb oldali
 * látványa. Élő HTML/CSS, nem videó: a szöveg a markupban van, a végleges,
 * KÉSZ állapotában, így JS nélkül, reduced motion mellett és a GSAP letöltése
 * előtt is teljes a kép (nincs elrejtve semmi, nincs LCP- és CLS-hatása).
 *
 * A mozgás: a GSAP-ot az oldal teljes betöltése UTÁN, üresjáratban töltjük le
 * (jsdelivr), és onnantól végtelenítve lebontja, majd újraépíti a jelenetet
 * (termék → beolvasás → AI → 4 kártya, gépelt szöveggel, Shopgrade-mérővel).
 * Csak akkor fut, amikor látszik. A `html.m-motion` nélkül el sem indul.
 *
 * A mintaadatok (Pilea, 8 990 Ft, 42 → 91) illusztrációk. Új hero-szintű
 * jelenetet csak előzetes egyeztetés után készítünk (DESIGN.md „Mozgás").
 * A jelenet ikonjai: src/data/icons.ts (progress_activity és check_circle JS-ből).
 */
---

<div class="hs-wrap">
    <div class="hs" role="img"
        aria-label="A Content Ninja egy webshop-termékből Facebook-, Instagram- és TikTok-posztot, blogcikket, hírlevelet és jobb termékleírást készít">
        <div class="hs-bg" aria-hidden="true"></div>

        <div class="hs-label hs-label-in" aria-hidden="true">
            <span class="material-symbols-outlined">storefront</span>A webshopodból
        </div>
        <div class="hs-label hs-label-out" aria-hidden="true">
            <span class="material-symbols-outlined">auto_awesome</span>Kész tartalmak
        </div>

        <!-- Összekötő vonalak: a termékből a hubba, onnan a 4 kártyába.
             base = kirajzolódó vonal, flow = utána végtelenül áramló szaggatott -->
        <svg class="hs-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="hs-base hs-trunk" pathLength="1" d="M41 48 H46" />
            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 19.5, 54 19.5" />
            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 40.5, 54 40.5" />
            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 61.5, 54 61.5" />
            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 82.5, 54 82.5" />
            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 19.5, 54 19.5" />
            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 40.5, 54 40.5" />
            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 61.5, 54 61.5" />
            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 82.5, 54 82.5" />
        </svg>

        <!-- A termék -->
        <div class="hs-product" aria-hidden="true">
            <div class="hs-product-img">
                <img src="/assets/motion-termek-cserep.webp" width="1024" height="1024" alt="" />
                <div class="hs-scan"></div>
            </div>
            <div class="hs-product-name">Pilea levendula kaspóban</div>
            <div class="hs-product-meta"><span class="hs-price">8 990 Ft</span><span class="hs-stock">Raktáron</span></div>
        </div>

        <!-- AI hub -->
        <div class="hs-hub" aria-hidden="true">
            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">auto_awesome</span>
        </div>

        <!-- Állapotjelző -->
        <div class="hs-status" aria-hidden="true">
            <span class="hs-status-icon material-symbols-outlined" style="font-variation-settings:'FILL' 1">check_circle</span>
            <span class="hs-status-text">4 tartalom kész</span>
        </div>

        <!-- 1. Poszt -->
        <div class="hs-card" style="top:10%" aria-hidden="true">
            <img class="hs-thumb" src="/assets/motion-termek-cserep.webp" width="1024" height="1024" alt="" />
            <div class="hs-body">
                <div class="hs-row">
                    <span class="hs-kicker">Poszt</span>
                    <span class="hs-socials">
                        <svg viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#1877F2"/><path d="M14.9 12.5l.35-2.3h-2.2V8.7c0-.63.31-1.24 1.3-1.24h1V5.5s-.9-.15-1.77-.15c-1.8 0-2.98 1.1-2.98 3.07v1.78H8.6v2.3h1.99V18h2.45v-5.5h1.86z" fill="#fff"/></svg>
                        <svg viewBox="0 0 24 24"><defs><linearGradient id="igGradHs" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse"><stop stop-color="#FEDA75"/><stop offset=".35" stop-color="#FA7E1E"/><stop offset=".6" stop-color="#D62976"/><stop offset="1" stop-color="#962FBF"/></linearGradient></defs><rect width="24" height="24" rx="6" fill="url(#igGradHs)"/><rect x="6" y="6" width="12" height="12" rx="4" fill="none" stroke="#fff" stroke-width="1.5"/><circle cx="12" cy="12" r="2.8" fill="none" stroke="#fff" stroke-width="1.5"/><circle cx="16.2" cy="7.8" r="1" fill="#fff"/></svg>
                        <svg viewBox="0 0 24 24"><path fill="#000000" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                    </span>
                </div>
                <div class="hs-title hs-type">Új zöld kedvenc 🌿 A Pilea levendula kaspóban érkezik!</div>
                <div class="hs-meta"><span class="material-symbols-outlined">schedule</span>Ütemezve · ma 18:00</div>
            </div>
        </div>

        <!-- 2. Blogcikk -->
        <div class="hs-card" style="top:31%" aria-hidden="true">
            <div class="hs-ico"><span class="material-symbols-outlined">article</span></div>
            <div class="hs-body">
                <div class="hs-row">
                    <span class="hs-kicker">Blogcikk</span>
                    <span class="hs-badge"><span class="material-symbols-outlined">check</span>Publikálva</span>
                </div>
                <div class="hs-title hs-type">Pilea gondozása: 7 tipp kezdőknek</div>
                <div class="hs-lines-sk"><i style="width:92%"></i><i style="width:70%"></i></div>
            </div>
        </div>

        <!-- 3. Hírlevél -->
        <div class="hs-card" style="top:52%" aria-hidden="true">
            <div class="hs-ico"><span class="material-symbols-outlined">mail</span></div>
            <div class="hs-body">
                <div class="hs-row">
                    <span class="hs-kicker">Hírlevél</span>
                    <span class="hs-badge"><span class="material-symbols-outlined">check</span>Kiküldve</span>
                </div>
                <div class="hs-title hs-type">Tavaszi zöld újdonságok 🌱</div>
                <div class="hs-lines-sk"><i style="width:84%"></i><i style="width:58%"></i></div>
            </div>
        </div>

        <!-- 4. Termékleírás (Shopgrade) -->
        <div class="hs-card" style="top:73%" aria-hidden="true">
            <div class="hs-gauge">
                <svg viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15" class="hs-gauge-track" />
                    <circle cx="18" cy="18" r="15" class="hs-gauge-bar" pathLength="100" />
                </svg>
                <span class="hs-gauge-num">91</span>
            </div>
            <div class="hs-body">
                <div class="hs-row">
                    <span class="hs-kicker">Termékleírás</span>
                    <span class="hs-badge"><span class="material-symbols-outlined">check</span>Kész</span>
                </div>
                <div class="hs-title hs-type">SEO- és GEO-barát, eladósabb leírás</div>
                <div class="hs-meta"><span class="material-symbols-outlined">trending_up</span>Shopgrade pontszám</div>
            </div>
        </div>
    </div>
</div>

<style is:global>
@media (prefers-reduced-motion: reduce) {
  .hs-flow, .hs-hub::after { animation: none !important; }
}
/* ═══ Hero jelenet: minden méret a jelenet szélességéhez kötött (cqw) ═══ */
/* A konténer a SZÜLŐ: a .hs saját font-size-a csak így számol a saját szélességéből. */
.hs-wrap { container-type: inline-size; }
.hs { position: relative; aspect-ratio: 1 / 1; container-type: inline-size; overflow: hidden; border-radius: 20px;
  background: #fbfaff; border: 1px solid rgba(108, 92, 231, 0.12); box-shadow: 0 8px 30px rgba(108, 92, 231, 0.18);
  font-size: 2.6cqw; color: #1e1e2f; }
.hs-bg { position: absolute; inset: 0;
  background: radial-gradient(circle at 28% 50%, rgba(108, 92, 231, 0.13), transparent 55%),
    radial-gradient(#e3defc 1px, transparent 1.3px) 0 0 / 4.2cqw 4.2cqw; }
.hs-label { position: absolute; display: flex; align-items: center; gap: 0.4em; font-size: 0.78em; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.08em; color: #6c5ce7; }
.hs .hs-label .material-symbols-outlined { font-size: 1.35em; }
.hs-label-in { left: 5%; top: 19.5%; }
.hs-label-out { left: 54%; top: 4.2%; }

.hs-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.hs-base { fill: none; stroke: #c9c1fb; stroke-width: 0.45; stroke-dasharray: 1; stroke-dashoffset: 0; }
.hs-flow { fill: none; stroke: #6c5ce7; stroke-width: 0.5; stroke-linecap: round; stroke-dasharray: 0.8 1.6;
  animation: hs-flow 1.1s linear infinite; }
@keyframes hs-flow { to { stroke-dashoffset: -2.4; } }

.hs-product { position: absolute; left: 5%; top: 25%; width: 36%; padding: 1.6cqw; background: #fff;
  border: 1px solid #e8e8ef; border-radius: 2.4cqw; box-shadow: 0 10px 30px rgba(30, 30, 47, 0.08); }
.hs-product-img { position: relative; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 1.6cqw; background: #f4f2fb; }
.hs-product-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
html.m-motion .hs-product-img img { animation: m-breathe 8s ease-in-out infinite; }
@keyframes m-breathe { 50% { transform: scale(1.05); } }
.hs-scan { position: absolute; left: 0; right: 0; top: 0; height: 35%; opacity: 0; transform: translateY(-100%);
  background: linear-gradient(180deg, transparent, rgba(108, 92, 231, 0.3) 75%, rgba(108, 92, 231, 0.95)); }
.hs-product-name { margin-top: 1.2cqw; font-weight: 700; line-height: 1.25; }
.hs-product-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 0.6cqw; font-size: 0.9em; }
.hs-price { font-weight: 800; color: #6c5ce7; }
.hs-stock { font-size: 0.8em; font-weight: 700; color: #15803d; background: #dcfce7; border-radius: 99px; padding: 0.15em 0.6em; }

.hs-hub { position: absolute; left: 47.5%; top: 48%; width: 6.4cqw; height: 6.4cqw; margin: -3.2cqw 0 0 -3.2cqw;
  display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff;
  background: linear-gradient(135deg, #6c5ce7, #9d8df9);
  box-shadow: 0 0 0 0.9cqw rgba(108, 92, 231, 0.15), 0 6px 18px rgba(108, 92, 231, 0.45); }
.hs .hs-hub .material-symbols-outlined { font-size: 3.6cqw; }
.hs-hub::after { content: ''; position: absolute; inset: -1.4cqw; border-radius: 50%; border: 2px solid rgba(108, 92, 231, 0.35);
  animation: hs-ping 2.2s ease-out infinite; }
@keyframes hs-ping { from { transform: scale(0.7); opacity: 1; } to { transform: scale(1.5); opacity: 0; } }

.hs-status { position: absolute; left: 5%; top: 78.5%; width: 36%; display: flex; align-items: center; gap: 0.5em;
  padding: 0.7em 1em; background: #fff; border: 1px solid #e8e8ef; border-radius: 99px; white-space: nowrap; overflow: hidden;
  font-size: 0.86em; font-weight: 700; box-shadow: 0 4px 14px rgba(30, 30, 47, 0.06); }
.hs .hs-status-icon { font-size: 1.4em; color: #22c55e; }
.hs .hs-status.is-working .hs-status-icon { color: #6c5ce7; animation: hs-spin 1s linear infinite; }
@keyframes hs-spin { to { transform: rotate(360deg); } }

.hs-card { position: absolute; left: 54%; width: 42%; height: 19%; display: flex; align-items: center; gap: 1.6cqw;
  padding: 1.5cqw 1.7cqw; background: #fff; border: 1px solid #e8e8ef; border-radius: 2.2cqw;
  box-shadow: 0 8px 24px rgba(30, 30, 47, 0.07); }
.hs-thumb, .hs-ico, .hs-gauge { width: 11cqw; height: 11cqw; flex-shrink: 0; border-radius: 1.4cqw; }
.hs-thumb { object-fit: cover; }
.hs-ico { display: flex; align-items: center; justify-content: center; background: rgba(108, 92, 231, 0.1); color: #6c5ce7; }
.hs .hs-ico .material-symbols-outlined { font-size: 5cqw; }
.hs-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.35em; }
.hs-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5em; }
.hs-kicker { font-size: 0.72em; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #9090a7; }
.hs-socials { display: flex; gap: 0.3em; }
.hs-socials svg { width: 1.15em; height: 1.15em; }
.hs-badge { display: inline-flex; align-items: center; gap: 0.15em; padding: 0.15em 0.55em 0.15em 0.35em; border-radius: 99px;
  font-size: 0.68em; font-weight: 700; color: #15803d; background: #dcfce7; white-space: nowrap; }
.hs .hs-badge .material-symbols-outlined { font-size: 1.2em; }
.hs-title { min-height: 2.5em; font-size: 0.9em; font-weight: 700; line-height: 1.25; overflow: hidden;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.hs-meta { display: flex; align-items: center; gap: 0.3em; font-size: 0.72em; font-weight: 500; color: #9090a7; }
.hs .hs-meta .material-symbols-outlined { font-size: 1.25em; }
.hs-lines-sk { display: flex; flex-direction: column; gap: 0.35em; }
.hs-lines-sk i { display: block; height: 0.4em; border-radius: 99px; background: #eceaf6; }
.hs-gauge { position: relative; border-radius: 50%; }
.hs-gauge svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.hs-gauge-track { fill: none; stroke: #eceaf6; stroke-width: 3.4; }
.hs-gauge-bar { fill: none; stroke: #22c55e; stroke-width: 3.4; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 9; }
.hs-gauge-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.05em; }

</style>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('m-motion')) return;
    var $ = function (s, c) { return (c || document).querySelector(s); };
    var $$ = function (s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); };
    initHeroScene();

    function initHeroScene() {
      var hs = $('.hs');
      if (!hs) return;
      function idle(fn) {
        var go = function () {
          if ('requestIdleCallback' in window) requestIdleCallback(fn, { timeout: 2500 });
          else setTimeout(fn, 1200);
        };
        if (document.readyState === 'complete') go(); else addEventListener('load', go, { once: true });
      }
      idle(function () {
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js';
        s.async = true;
        s.onload = function () { if (window.gsap) buildHeroTimeline(hs); };
        document.head.appendChild(s);
      });
    }

    function buildHeroTimeline(hs) {
      var cards = $$('.hs-card', hs);
      var types = $$('.hs-type', hs);
      var chars = types.map(function (t) { return Array.from(t.textContent.trim()); }); // emoji-biztos
      var bases = $$('.hs-base', hs);
      var flows = $$('.hs-flow', hs);
      var badges = $$('.hs-badge', hs);
      var sks = $$('.hs-lines-sk i', hs);
      var status = $('.hs-status', hs);
      var statusText = $('.hs-status-text', hs);
      var statusIcon = $('.hs-status-icon', hs);
      var gaugeBar = $('.hs-gauge-bar', hs);
      var gaugeNum = $('.hs-gauge-num', hs);

      function setStatus(txt, working) {
        return function () {
          statusText.textContent = txt;
          statusIcon.textContent = working ? 'progress_activity' : 'check_circle';
          status.classList.toggle('is-working', working);
        };
      }

      // immediateRender: false – a jelenet kész állapotban áll, a felépítés
      // kezdőállapotai csak akkor lépnek életbe, amikor a lejátszás odaér.
      var tl = gsap.timeline({ repeat: -1, defaults: { ease: 'power3.out', immediateRender: false } });

      // 1) Tartás a kész állapotban, majd lebontás
      tl.to({}, { duration: 2.5 })
        .to(cards.slice().reverse(), { autoAlpha: 0, x: 12, duration: 0.35, stagger: 0.06, ease: 'power2.in' })
        .to(['.hs-hub', status, '.hs-product', '.hs-label'].concat(flows), { autoAlpha: 0, duration: 0.35 }, '-=0.15')
        .to(bases, { strokeDashoffset: 1, duration: 0.3 }, '<')
        .call(function () { types.forEach(function (t) { t.textContent = ''; }); gaugeNum.textContent = '42'; })
        .set(badges, { autoAlpha: 0, scale: 0 })
        .set(sks, { scaleX: 0, transformOrigin: '0 50%' })
        .set(gaugeBar, { strokeDashoffset: 58, stroke: '#f59e0b' })
        .to({}, { duration: 0.3 });

      // 2) Felépítés: termék → beolvasás → AI → kártyák egyenként
      tl.fromTo('.hs-label', { autoAlpha: 0, y: 8 }, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.1 })
        .fromTo('.hs-product', { autoAlpha: 0, y: 24, scale: 0.94 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.7 }, '<')
        .fromTo(status, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.4 }, '-=0.2')
        .call(setStatus('AI elemzi…', true), null, '<')
        .fromTo('.hs-scan', { yPercent: -100, autoAlpha: 1 }, { yPercent: 290, duration: 1.3, ease: 'sine.inOut' })
        .to('.hs-scan', { autoAlpha: 0, duration: 0.2 })
        .to(bases[0], { strokeDashoffset: 0, duration: 0.35, ease: 'none' }, '-=0.3')
        .fromTo('.hs-hub', { autoAlpha: 0, scale: 0 }, { autoAlpha: 1, scale: 1, duration: 0.5, ease: 'back.out(2.2)' })
        .call(setStatus('Tartalom készül…', true));

      cards.forEach(function (card, i) {
        var el = types[i], txt = chars[i], o = { n: 0 };
        tl.to(bases[i + 1], { strokeDashoffset: 0, duration: 0.4, ease: 'power1.inOut' }, i === 0 ? '+=0.05' : '-=0.45')
          .fromTo(card, { autoAlpha: 0, x: -18, scale: 0.92 }, { autoAlpha: 1, x: 0, scale: 1, duration: 0.55, ease: 'back.out(1.6)' }, '-=0.1')
          .fromTo(o, { n: 0 }, { n: txt.length, duration: txt.length * 0.026, ease: 'none',
            onUpdate: function () { el.textContent = txt.slice(0, Math.round(o.n)).join(''); } }, '-=0.2');
        var sk = $$('.hs-lines-sk i', card);
        if (sk.length) tl.to(sk, { scaleX: 1, duration: 0.4, stagger: 0.1 }, '-=0.35');
        if (gaugeBar && card.contains(gaugeBar)) {
          var g = { v: 42 };
          tl.to(gaugeBar, { strokeDashoffset: 9, stroke: '#22c55e', duration: 1, ease: 'power2.out' }, '-=0.6')
            .fromTo(g, { v: 42 }, { v: 91, duration: 1, ease: 'power2.out',
              onUpdate: function () { gaugeNum.textContent = Math.round(g.v); } }, '<');
        }
        var badge = $('.hs-badge', card);
        if (badge) tl.to(badge, { autoAlpha: 1, scale: 1, duration: 0.35, ease: 'back.out(3)' }, '-=0.1');
      });

      tl.to(flows, { autoAlpha: 1, duration: 0.4 })
        .call(setStatus('4 tartalom kész', false), null, '<')
        .fromTo(status, { scale: 0.94 }, { scale: 1, duration: 0.45, ease: 'back.out(3)' }, '<');

      // Csak akkor fusson, amikor látszik (akku, CPU)
      new IntersectionObserver(function (en) { en[0].isIntersecting ? tl.play() : tl.pause(); }).observe(hs);
    }
  })();
</script>
