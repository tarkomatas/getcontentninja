---
import '../styles/global.css';
// A sorrend számít: global.css → Tailwind (preflight + utility-k) → mozgásréteg.
import '../styles/tailwind.css';
import '../styles/motion.css';
import { pathFor, alternatesFor, type Locale, type PageKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import IntakeClient from '../components/IntakeClient.astro';
import AttributionScript from '../components/AttributionScript.astro';
import { BRAND_NAME, brandJsonLd } from '../data/brand';
import MotionScript from '../components/MotionScript.astro';
import { ICONS } from '../data/icons';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Felülírja a page+locale alapján számolt kanonikus URL-t. */
  canonical?: string;
  /** Ne indexelje a kereső (pl. köszönő oldal). */
  noindex?: boolean;
  /**
   * Ne adjon ki canonicalt és hreflang alternatívákat. Egyetlen oldalnak kell:
   * a 404-nek, aminek nincs saját címe (bármelyik nem létező URL-en megjelenik),
   * így se kanonikus párja, se nyelvi változata nem értelmezhető. A `page` propot
   * ott is meg kell adni (a fejléc nyelvváltója kéri) – ez a kapcsoló mondja meg,
   * hogy abból SEO-állítás ne szülessen.
   */
  suppressCanonical?: boolean;
  /** A <body> osztályai (alapból a marketing oldalak beállítása). */
  bodyClass?: string;
  /**
   * Landing (hirdetési) mód engedélyezése: ?type=ld (vagy ?lp=1) paraméterre
   * a fejléc minimalistára vált (html.lp-mode + .lp-hide/.lp-show osztályok
   * a global.css-ben). Jogi/technikai oldalakon ne kapcsold be.
   */
  lpEnabled?: boolean;
  /**
   * Mozgásréteg (beúszás, hero-belépő, számlálók, lágy GYIK …) – lásd
   * `src/styles/motion.css`, `MotionScript.astro`, DESIGN.md „Mozgás".
   * Alapból be van kapcsolva; `false`-szal az oldal teljesen statikus.
   */
  motion?: boolean;
}

const {
  locale,
  page,
  title,
  description,
  keywords,
  ogTitle,
  ogDescription,
  // Alapértelmezett megosztási kép: a főoldali all-in-one illusztráció (1200×630).
  // A modul-oldalak saját `ogImage`-et adnak; a jogi/technikai oldalak ezt kapják.
  ogImage = '/assets/og-fooldal.jpg',
  canonical,
  noindex = false,
  suppressCanonical = false,
  bodyClass = 'bg-card text-dark font-display antialiased',
  lpEnabled = false,
  motion = true,
} = Astro.props;

// Material Symbols: csak a honlapon használt ikonok töltődnek le (src/data/icons.ts;
// a build ellenőrzi, hogy egy sem hiányzik). A Google ábécérendben várja őket.
const iconQuery = `&icon_names=${[...new Set(ICONS)].sort().join(',')}`;

const site = Astro.site!;
const canonicalUrl = canonical ?? new URL(pathFor(page, locale), site).href;
const alternates = alternatesFor(page).map((a) => ({
  hreflang: a.hreflang,
  href: new URL(a.path, site).href,
}));
const ui = t(locale);
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <!--
      Google Ads (gtag.js) – NEM tölt be magától. Itt csak a parancssor áll fel:
      a gtag() hívások a dataLayerbe gyűlnek, hálózati kérés és süti nélkül.
      Magát a gtag.js-t a `public/assets/cookie.js` húzza be, kizárólag a
      süti-hozzájárulás után (ugyanúgy, mint a Meta Pixelt), és onnantól a
      queue visszamenőleg lefut. Így egy jövőbeli konverziós gtag('event', …)
      hívás sem száll el, ha a látogató még nem döntött.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
    </script>

    <!-- Érkezéskori kampány-forrás (`cn_attr` süti, csak hozzájárulással) – lásd `src/data/attribution.ts`. -->
    <AttributionScript />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      Favicon. A fájlok a `public/` gyökerében vannak (a logó „CN” jeléből
      generálva: `npm run gen:favicon`), tehát a build után a domain gyökeréről
      szolgálódnak ki. A `/favicon.ico` böngésző nélkül is megtalálható – több
      ellenőrző (pl. hirdetési márkaellenőrzés) csak ezt az egy címet nézi –,
      de a `rel="icon"` sorok is kellenek, mert az automata ellenőrzők egy
      része a HTML-ben keresi a hivatkozást.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6c5ce7" />

    <!-- Landing (hirdetési) mód: a script még az első kirajzolás előtt fut, így nincs villanás -->
    {lpEnabled && (
      <script is:inline>
        (function () {
          var q = new URLSearchParams(location.search);
          if (q.get('type') === 'ld' || q.get('lp') === '1') {
            document.documentElement.classList.add('lp-mode');
          }
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!suppressCanonical && <link rel="canonical" href={canonicalUrl} />}

    <!-- hreflang alternatívák -->
    {!suppressCanonical && alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- Open Graph.
         A megosztási képek 1200×630-as JPEG-ek (`public/assets/og-*.jpg`) – JPEG,
         mert a LinkedIn a WebP OG-képet gyakran nem rendereli. A méret-meta azért
         fix, mert minden og-*.jpg pontosan 1200×630 (lásd a generálást). -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'hu' ? 'hu_HU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={new URL(ogImage, site).href} />

    <!-- Márkanév a Google-nek (webhely neve a találatokban) – lásd `src/data/brand.ts`. -->
    {page === 'home' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(brandJsonLd)} />
    )}

    <!-- Fonts. A preconnect a két Google-domainhez előre felépíti a kapcsolatot,
         így a betűtípus hamarabb megérkezik (a fontfájlok a gstatic-ról jönnek). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1${iconQuery}&display=swap`}
      rel="stylesheet"
    />

    <!-- Tailwind: build-lépésben készül (src/styles/tailwind.css, tailwind.config.mjs,
         a téma: src/styles/tailwind-theme.mjs) – 2026-10-10-ig CDN-ről, futásidőben
         gyártotta a böngésző, ami render-blokkoló volt. -->

    <!-- Mozgásréteg kapcsolója: még az első kirajzolás előtt fut. Reduced motion
         mellett be sem kapcsol; ha a MotionScript 4 mp alatt nem jelzi, hogy
         elindult, visszavonjuk, és minden látszik. -->
    {motion && (
      <script is:inline>
        (function () {
          if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var d = document.documentElement;
          d.classList.add('m-motion');
          setTimeout(function () { if (!window.__mReady) d.classList.remove('m-motion'); }, 4000);
        })();
      </script>
    )}

    <slot name="head" />
  </head>

  <body class={bodyClass} style="overflow-x: clip;">
    <slot />

    <!-- Mozgásréteg: a tartalom UTÁN, hogy lássa a szakaszokat és felülírhassa a
         lapok saját toggleFaq-ját. -->
    {motion && <MotionScript />}

    <!--
      Űrlap-küldés: window.cnIntake + a localStorage retry-sor. MINDEN oldalon
      ott van, mert a sikeres beküldés után azonnal átirányítunk – a bent maradt
      beküldést a köszönőoldal küldi el. Nem mérés, nem süti: hozzájárulás
      nélkül is működnie kell, különben pont a mentőövet vágnánk el.
    -->
    <IntakeClient />

    <!-- Consent-gated Meta Pixel + cookie banner -->
    <script is:inline src="/assets/cookie.js"></script>
  </body>
</html>
