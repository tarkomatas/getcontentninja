---
// 404 – nem létező URL.
//
// A GitHub Pages minden nem létező cím helyett a build gyökerében lévő
// `404.html`-t szolgálja ki (valódi 404-es státusszal), ezért ELÉG ez az EGY
// fájl: nincs `/hu/404/` és `/en/404/`, és nem is kell. Astro a
// `src/pages/404.astro`-ból pontosan `dist/404.html`-t épít.
//
// Emiatt viszont az oldal nem tudhat előre a nyelvről: KÉTNYELVŰ, és a
// megjelenítendő változatot egy rövid inline script választja ki (a hibás URL
// `/en/` prefixe, különben a böngésző nyelve; fallback: magyar). JS nélkül a
// magyar látszik – ez a site alapértelmezett nyelve.
//
// Szándékosan NEM használja a `BaseLayout`-ot és a közös `Header`-t: mindkettő
// egy konkrét `locale`-t vár (canonical + hreflang egy adott oldalkulcsra), egy
// 404-nek viszont se kanonikus párja, se nyelve nincs. A stílus ezért – a
// gyökér-átirányító `index.astro`-hoz hasonlóan – inline, a márkatokenekkel.
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 – A keresett oldal nem található | Content Ninja</title>
    <meta name="description" content="Ez az oldal nem található. Válassz a Content Ninja főoldala, a megoldások vagy az árak közül." />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#6c5ce7" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --primary: #6c5ce7;
        --primary-hover: #5a4bd6;
        --dark: #1e1e2f;
        --body: #4a4a68;
        --muted: #9090a7;
        --border: #e8e8ef;
        --light: #f8f9fb;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--body);
        background: #fff;
        -webkit-font-smoothing: antialiased;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding: 1rem 1.5rem;
      }
      header .inner {
        max-width: 1200px;
        margin: 0 auto;
      }
      header img {
        height: 3.5rem;
        width: auto;
        display: block;
      }
      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3.5rem 1.5rem;
        background:
          radial-gradient(60% 60% at 50% 0%, rgba(108, 92, 231, 0.08), transparent 70%),
          #fff;
      }
      .card {
        width: 100%;
        max-width: 40rem;
        text-align: center;
      }
      .code {
        display: inline-block;
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary);
        background: rgba(108, 92, 231, 0.08);
        border: 1px solid rgba(108, 92, 231, 0.18);
        border-radius: 999px;
        padding: 0.375rem 0.875rem;
      }
      h1 {
        font-size: 2rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 800;
        color: var(--dark);
        margin: 1.25rem 0 0.75rem;
      }
      @media (min-width: 768px) {
        h1 { font-size: 2.5rem; }
      }
      .lead {
        font-size: 1.0625rem;
        line-height: 1.6;
        margin: 0 auto;
        max-width: 34rem;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin: 2rem 0 2.5rem;
      }
      .actions a {
        display: inline-block;
        padding: 0.875rem 1.75rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s, box-shadow 0.2s, transform 0.2s;
      }
      .btn-primary {
        background: var(--primary);
        color: #fff;
        box-shadow: 0 8px 30px rgba(108, 92, 231, 0.18);
      }
      .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
      .btn-ghost {
        background: #fff;
        color: var(--dark);
        box-shadow: inset 0 0 0 1px var(--border);
      }
      .btn-ghost:hover { background: var(--light); }
      .links {
        border-top: 1px solid var(--border);
        padding-top: 1.5rem;
      }
      .links p {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.875rem;
      }
      .links div {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        justify-content: center;
      }
      .links a {
        color: var(--body);
        font-size: 0.9375rem;
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .links a:hover { color: var(--primary); border-bottom-color: var(--primary); }
      footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem;
        text-align: center;
        font-size: 0.8125rem;
        color: var(--muted);
      }
      footer a { color: var(--muted); }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <header>
      <div class="inner">
        <a id="logo-link" href="/hu/">
          <img src="/assets/logo.webp" alt="Content Ninja" width="260" height="78" />
        </a>
      </div>
    </header>

    <main>
      <!-- Magyar változat (alapértelmezett – JS nélkül is ez látszik) -->
      <div class="card" id="cn-404-hu">
        <span class="code">404</span>
        <h1>Ez az oldal nincs meg</h1>
        <p class="lead">
          Lehet, hogy elírtad a címet, vagy időközben átkerült máshová. Az alábbi
          linkekkel egy kattintással visszatalálsz.
        </p>
        <div class="actions">
          <a class="btn-primary" href="/hu/">Vissza a főoldalra</a>
          <a class="btn-ghost" href="/hu/online-bemutato/">Bemutatót kérek</a>
        </div>
        <div class="links">
          <p>Népszerű oldalak</p>
          <div>
            <a href="/hu/#megoldasok">Megoldások</a>
            <a href="/hu/arak/">Árak</a>
            <a href="/hu/posztolas/">Automata posztolás</a>
            <a href="/hu/shopgrade/">Termékleírás optimalizálás</a>
            <a href="/hu/blogcikk-iro/">Blogcikk író</a>
            <a href="/hu/kapcsolat/">Kapcsolat</a>
          </div>
        </div>
      </div>

      <!-- Angol változat -->
      <div class="card" id="cn-404-en" hidden>
        <span class="code">404</span>
        <h1>This page doesn’t exist</h1>
        <p class="lead">
          The address may be mistyped, or the page has moved. Use the links below
          to get back on track.
        </p>
        <div class="actions">
          <a class="btn-primary" href="/en/">Back to home</a>
          <a class="btn-ghost" href="/en/book-demo/">Book a demo</a>
        </div>
        <div class="links">
          <p>Popular pages</p>
          <div>
            <a href="/en/#megoldasok">Solutions</a>
            <a href="/en/pricing/">Pricing</a>
            <a href="/en/demo/">Automated posting</a>
            <a href="/en/shopgrade/">Product description optimisation</a>
            <a href="/en/blog-writer/">Blog writer</a>
            <a href="/en/contact/">Contact</a>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <span id="cn-404-foot-hu">Content Ninja · <a href="/hu/impresszum/">Impresszum</a> · <a href="/hu/adatkezeles/">Adatkezelési tájékoztató</a></span>
      <span id="cn-404-foot-en" hidden>Content Ninja · <a href="/en/imprint/">Imprint</a> · <a href="/en/privacy-policy/">Privacy policy</a></span>
    </footer>

    <!--
      Nyelvválasztás. A sorrend szándékos: a hibás URL prefixe erősebb jel, mint
      a böngésző nyelve (aki az /en/ ágon téved el, angolul olvas – akkor is, ha
      magyar a böngészője). Csak akkor váltunk angolra, ha biztos a jel.
    -->
    <script is:inline>
      (function () {
        var path = location.pathname.toLowerCase();
        var isEn;
        if (path.indexOf('/en/') === 0 || path === '/en') {
          isEn = true;
        } else if (path.indexOf('/hu/') === 0 || path === '/hu') {
          isEn = false;
        } else {
          var lang = (navigator.language || navigator.userLanguage || 'hu').toLowerCase();
          isEn = lang.indexOf('hu') !== 0;
        }
        if (!isEn) return;

        document.documentElement.lang = 'en';
        document.title = '404 – Page not found | Content Ninja';
        document.getElementById('cn-404-hu').hidden = true;
        document.getElementById('cn-404-en').hidden = false;
        document.getElementById('cn-404-foot-hu').hidden = true;
        document.getElementById('cn-404-foot-en').hidden = false;
        document.getElementById('logo-link').href = '/en/';
      })();
    </script>
  </body>
</html>
