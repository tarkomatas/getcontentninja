---
// 404 – nem létező URL.
//
// A GitHub Pages minden nem létező cím helyett a build gyökerében lévő
// `404.html`-t szolgálja ki (valódi 404-es státusszal), ezért ELÉG ez az EGY
// fájl: nincs `/hu/404/` és `/en/404/`, és nem is kell. Astro a
// `src/pages/404.astro`-ból pontosan `dist/404.html`-t épít.
//
// Emiatt viszont az oldal nem tudhat előre a nyelvről: MINDKÉT nyelvi változat
// benne van a HTML-ben – fejléccel és lábléccel együtt –, és egy inline script
// a felesleget KITÖRLI a DOM-ból. Nem elrejti: a `Header` fix id-ket használ
// (`mobile-menu-btn`, `mobile-menu`, `hamburger-icon`), két példányból a
// `getElementById` az elsőt találná meg, és a másik hamburgere némán halott
// lenne. A törlés a body-ban, klasszikus inline scriptben történik, tehát még
// az elemzés közben – a `Header` bundle-elt modul-scriptje (defer) csak utána
// fut, addigra egyetlen fejléc marad. JS nélkül a magyar változat látszik.
//
// A nyelvválasztás sorrendje szándékos: a hibás URL `/en/` prefixe erősebb jel,
// mint a böngésző nyelve (aki az angol ágon téved el, angolul olvas – akkor is,
// ha magyar a böngészője).
//
// Az angol blokk rejtése INLINE STÍLUSSAL megy, nem `hidden` attribútummal: a
// böngésző `[hidden]{display:none}` szabályát a `flex` osztály felülütné, és
// JS nélkül mindkét nyelv egymás alatt látszana.
//
// `suppressCanonical`: a 404-nek nincs saját címe (bármelyik nem létező URL-en
// megjelenik), így se kanonikus párja, se hreflang alternatívája nem
// értelmezhető. A `page="home"` csak a fejléc nyelvváltójának kell – onnan a
// másik nyelv főoldalára visz, ami egy 404-en a helyes cél.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const copy = {
  hu: {
    badge: '404 – nincs meg az oldal',
    h1: 'Ezt az oldalt a nindzsánk túl jól elrejtette',
    lead: 'Vagy elírtad a címet, vagy időközben átkerült máshová. A lenti linkekkel egy kattintással visszatalálsz.',
    ctaHome: 'Vissza a főoldalra',
    ctaDemo: 'Bemutatót kérek',
    linksHeading: 'Népszerű oldalak',
    imgAlt: 'Nindzsa kandikál ki egy füstfelhő mögül egy üres böngészőablak mellett',
    home: '/hu/',
    demo: '/hu/online-bemutato/',
    links: [
      { href: '/hu/#megoldasok', label: 'Megoldások' },
      { href: '/hu/arak/', label: 'Árak' },
      { href: '/hu/posztolas/', label: 'Automata posztolás' },
      { href: '/hu/shopgrade/', label: 'Termékleírás optimalizálás' },
      { href: '/hu/blogcikk-iro/', label: 'Blogcikk író' },
      { href: '/hu/kapcsolat/', label: 'Kapcsolat' },
    ],
  },
  en: {
    badge: '404 – page not found',
    h1: 'Our ninja hid this page a little too well',
    lead: 'The address may be mistyped, or the page has moved. The links below will get you back on track.',
    ctaHome: 'Back to home',
    ctaDemo: 'Book a demo',
    linksHeading: 'Popular pages',
    imgAlt: 'A ninja peeking out of a puff of smoke next to an empty browser window',
    home: '/en/',
    demo: '/en/book-demo/',
    links: [
      { href: '/en/#megoldasok', label: 'Solutions' },
      { href: '/en/pricing/', label: 'Pricing' },
      { href: '/en/demo/', label: 'Automated posting' },
      { href: '/en/shopgrade/', label: 'Product description optimisation' },
      { href: '/en/blog-writer/', label: 'Blog writer' },
      { href: '/en/contact/', label: 'Contact' },
    ],
  },
} as const;
---

<BaseLayout
  locale="hu"
  page="home"
  title="404 – A keresett oldal nem található | Content Ninja"
  description="Ez az oldal nem található. Válassz a Content Ninja főoldala, a megoldások vagy az árak közül."
  noindex={true}
  suppressCanonical={true}
  bodyClass="bg-card text-dark font-display antialiased"
>
  {(['hu', 'en'] as const).map((loc) => (
    <div id={`cn-404-${loc}`} class="min-h-screen flex flex-col" style={loc === 'en' ? 'display:none' : undefined}>
      <Header locale={loc} page="home" />

      <main class="flex-1 flex items-center justify-center px-4 md:px-10 py-14 md:py-20 hero-gradient">
        <div class="max-w-[560px] w-full text-center">
          <img
            src="/assets/404-ninja.webp"
            alt={copy[loc].imgAlt}
            width="1024"
            height="1024"
            class="w-[220px] md:w-[280px] h-auto mx-auto -mb-2"
          />

          <span class="inline-block text-xs font-bold uppercase tracking-[0.08em] text-primary bg-primary/10 border border-primary/20 rounded-full px-3.5 py-1.5">
            {copy[loc].badge}
          </span>

          <h1 class="text-3xl md:text-4xl font-extrabold text-dark tracking-[-0.02em] leading-tight mt-5 mb-4">
            {copy[loc].h1}
          </h1>
          <p class="text-body leading-relaxed max-w-[34rem] mx-auto">{copy[loc].lead}</p>

          <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
            <a href={copy[loc].home} class="cta-primary px-6 py-3 text-sm">
              <span class="material-symbols-outlined text-[18px]">home</span>
              {copy[loc].ctaHome}
            </a>
            <a href={copy[loc].demo} class="cta-secondary px-6 py-3 text-sm">
              <span class="material-symbols-outlined text-[18px]">calendar_month</span>
              {copy[loc].ctaDemo}
            </a>
          </div>

          <div class="border-t border-border mt-10 pt-6">
            <p class="text-xs font-semibold uppercase tracking-[0.06em] text-muted mb-3.5">
              {copy[loc].linksHeading}
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
              {copy[loc].links.map((link) => (
                <a href={link.href} class="text-sm text-body hover:text-primary transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </main>

      <Footer locale={loc} page="home" />
    </div>
  ))}

  <script is:inline>
    (function () {
      var path = location.pathname.toLowerCase();
      var isEn;
      if (path.indexOf('/en/') === 0 || path === '/en') {
        isEn = true;
      } else if (path.indexOf('/hu/') === 0 || path === '/hu') {
        isEn = false;
      } else {
        var lang = (navigator.language || navigator.userLanguage || 'hu').toLowerCase();
        isEn = lang.indexOf('hu') !== 0;
      }

      var keep = document.getElementById(isEn ? 'cn-404-en' : 'cn-404-hu');
      var drop = document.getElementById(isEn ? 'cn-404-hu' : 'cn-404-en');
      if (drop) drop.remove();
      if (keep) keep.style.display = '';

      if (isEn) {
        document.documentElement.lang = 'en';
        document.title = '404 – Page not found | Content Ninja';
      }
    })();
  </script>
</BaseLayout>
