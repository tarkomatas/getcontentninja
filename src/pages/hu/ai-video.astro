                            'Tippek és tudnivalók, röviden',
                            'Megjegyezhető tanulsággal zár',
                            'A blogcikkeid így közösségi médiában is dolgoznak',
                        ],
                    },
                ].map((c) => (
                    <div class="bg-card rounded-[16px] border border-border p-8 shadow-card flex flex-col">
