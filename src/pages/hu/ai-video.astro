    <!-- 3. Mintavideók – az oldal fő bizonyítéka, a két videótípus után.
         A CTA vissza a hero űrlaphoz visz. -->
    <VideoShowcase locale={locale} id="videok" ctaHref="#hero" ctaLabel="Ezt szeretném a webshopomnak" ctaStyle="button" />

    <!-- 3. Hogyan működik? -->
    <section id="hogyan-mukodik" class="bg-light py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center max-w-[760px] mx-auto mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Hogyan működik? 🎬</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Termékoldalból kész videó, négy lépésben</h2>
                <p class="text-body text-lg leading-relaxed">
                    A videó egy poszthoz készül, ugyanabban a szerkesztőben, ahol a szöveg és a kép. Külön videós eszköz
