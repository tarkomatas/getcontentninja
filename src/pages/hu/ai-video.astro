                        <li class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[20px]">upload</span>
                            </div>
                            <span class="text-body font-medium text-lg leading-snug pt-1">Saját videót is feltölthetsz,
                                <strong>200 MB-ig</strong></span>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[20px]">money_off</span>
                            </div>
                            <span class="text-body font-medium text-lg leading-snug pt-1">A publikálás <strong>nem
                                fogyaszt kreditet</strong></span>
                        </li>
                    </ul>
                    <div class="flex items-center gap-4 flex-wrap">
                        <a href="#hero" class="inline-flex items-center justify-center rounded-[10px] h-14 px-8 cta-primary text-lg">
                            Automatizálni akarom!
                        </a>
                        <a href="/hu/tiktok-posztolas/" class="text-primary font-bold text-sm inline-flex items-center gap-1">
                            A TikTok-posztolásról
                            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                        </a>
                    </div>
                </div>
                <div class="order-1 md:order-2">
                    <img src="/assets/naptar-latvanykep.webp"
                        alt="Content Ninja tartalomnaptár: az ütemezett posztok és videók egy naptárban"
                        loading="lazy" class="w-full h-auto rounded-[16px] shadow-card hover:shadow-card-hover transition-all">
                </div>
            </div>
        </div>
    </section>

    <!-- 8. És amit a rendszer amúgy is tud (közös modulrács). A két videós modul ennek az
         oldalnak a témája, ezért kimarad: 8 kártya, `compact` = 4 hasáb, két tiszta sor. -->
    <ModuleGrid
        locale={locale}
        exclude={['video', 'narration']}
        sectionId="features-cards"
        sectionClass="bg-card py-20 md:py-28"
        cardClass="bg-light"
        heading="És amit a rendszer amúgy is tud"
        lead="A Content Ninja egy teljes AI marketing platform – minden, ami egy webshop tartalomgyártásához kell."
        compact
    />

    <!-- 9. Árazás -->
    <section id="arazas" class="bg-light py-20 md:py-28">
        <div class="max-w-[900px] mx-auto px-4 md:px-10">
            <div class="text-center mb-10 md:mb-16">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Árazás</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">A videó az előfizetés része</h2>
                <p class="text-body text-lg">Nincs külön videós díj. A videó a havi AI kreditből készül.</p>
            </div>

            <PricingCards locale={locale} ctaHref="#hero" />

            <!-- Kredit-példák: app `docs/features/narrator-unified.md` §3/D (Nano Banana képekkel). -->
            <div class="bg-card rounded-[16px] border border-border p-5 sm:p-8 shadow-card mt-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                    <div>
                        <h3 class="text-xl font-bold text-dark mb-3">Mennyibe kerül egy videó?</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-body">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">photo_library</span>
                                <span>15 mp, 4 kép: <strong class="text-dark">10 kredit</strong></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">music_note</span>
                                <span>30 mp, 7 kép + zene: <strong class="text-dark">17 kredit</strong></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">face</span>
                                <span>30 mp, beszélő szereplő: <strong class="text-dark">32 kredit</strong></span>
                            </div>
                        </div>
                        <p class="text-sm text-body mt-3">A generálás gombja mellett az app előre kiírja a becsült
                            összeget. Csak azért fizetsz, ami a videóba kerül.</p>
                    </div>
                    <a href="/hu/arak/#kreditek" class="text-primary font-bold text-sm whitespace-nowrap inline-flex items-center gap-1">
                        Részletes kreditdíjak
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 10. GYIK – ugyanabból a `faqs` tömbből, mint a FAQPage JSON-LD -->
    <section id="gyik" class="bg-card py-20 md:py-28 px-4 md:px-10">
        <div class="max-w-[800px] mx-auto">
            <div class="text-center mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">GYIK</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Gyakran ismételt kérdések az AI videókészítésről</h2>
            </div>

            <div class="space-y-3">
                {faqs.map((f) => (
                    <div class="faq-item bg-light rounded-[12px] border border-border overflow-hidden">
                        <button class="w-full flex items-center justify-between p-4 sm:p-5 text-left font-semibold text-dark text-base gap-4"
                            onclick="toggleFaq(this)">
                            {f.q}
                            <span class="material-symbols-outlined faq-icon text-primary shrink-0 text-[20px]">add</span>
                        </button>
                        <div class="faq-answer px-5 pb-5 text-body text-sm leading-relaxed">
                            {f.a}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 11. Záró CTA -->
    <section class="bg-primary py-16 md:py-20">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Nézzük meg, milyen videó készülne a termékeidből</h2>
            <p class="text-white/80 text-lg mb-8 max-w-[620px] mx-auto">
                Egy online bemutatón végigmegyünk a rendszeren – akár a te saját webáruházad termékeivel.
            </p>
            <a href="#hero" class="cta-on-primary px-8 h-14 text-base inline-flex">
                Bemutatót kérek
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>
    </section>

    <!-- Footer (kampányoldali, minimál – a tiktok oldal mintájára) -->
    <footer id="contact" class="py-12 bg-dark text-muted text-sm border-t border-dark/90">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
                <div>
                    <div class="bg-white p-3 rounded-xl inline-block mb-4"><img src="/assets/logo.webp" alt="Content Ninja logó" class="h-8 md:h-10"></div>
                    <p class="text-muted">Egy rendszer, ami a webshopod nevében készít marketing tartalmakat
                        futószalagon – közvetlenül a webáruházad termékeiből.</p>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-4">Információk</h4>
                    <ul class="space-y-2">
                        <li><a href="https://app.getcontentninja.com/changelog" class="hover:text-white">Újdonságok</a></li>
                        <li><a href="https://blog.getcontentninja.com/" class="hover:text-white">Blog</a></li>
                        <li><a href="/hu/adatkezeles/" class="hover:text-white">Adatkezelési tájékoztató</a></li>
                        <li><a href="/hu/impresszum/" class="hover:text-white">Impresszum</a></li>
                        <li><a href="/hu/aszf/" class="hover:text-white">ÁSZF</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p>Copyright © getcontentninja.com | 2026</p>
            </div>
        </div>
    </footer>

    <!-- GYIK script -->
    <script is:inline>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
    </script>

    <!-- Lead form script -->
    <LeadFormScript locale={locale} source="ai-video" />
  </div>
</BaseLayout>
