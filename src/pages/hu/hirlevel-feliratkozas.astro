---
/**
 * A MI hírlevelünk céloldala – ide linkelünk a levelekből, a supportból és a
 * közösségi profilokból. **Nem keverendő** a `/hu/hirlevel/` oldallal: az a
 * TERMÉK hírlevél-moduljának kampányoldala (a webshop küld hírlevelet), ez
 * pedig a látogató feliratkozása a mi levelünkre.
 *
 * **Szándékosan csak hero.** Egy hírlevél-feliratkozás nem igényel
 * érvelő oldalt: a döntés két másodperces, és minden továbbgörgetett szekció
 * csak halasztja. A fejléc és a lábléc marad (indexelhető, nyilvános céloldal,
 * nem squeeze-oldal), a hero alatt viszont nincs több szekció.
 *
 * A beküldés a `NewsletterForm` komponensen megy, saját végpontra
 * (`/api/newsletter/subscribe`) – az app naplóz, és a cím azonnal felkerül a
 * MailerLite-ba (egylépcsős feliratkozás, nincs megerősítő levél).
 *
 * ⚠️ **`NEWSLETTER_LIVE === false` esetén az oldal `noindex`** és nincs rajta
 * űrlap: az app végpontja még nem létezik, tehát nincs mit indexelni sem. Az
 * élesítés egyetlen lépés a `src/data/newsletter.ts`-ben.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { NEWSLETTER_LIVE } from '../../data/newsletter';

const locale = 'hu';
const page = 'newsletterSignup';
const title = 'Hírlevél – tarts lépést a webshopoddal az AI korszakban | Content Ninja';
const description =
  'Content Ninja hírlevél hazai webáruházaknak: új funkciók, bevált gyakorlatok és a legfontosabb e-kereskedelmi hírek. Nem adjuk ki a címed, egy kattintással leiratkozhatsz.';
---

<BaseLayout
  locale={locale}
  page={page}
  title={title}
  description={description}
  noindex={!NEWSLETTER_LIVE}
  lpEnabled
>
  <Header locale={locale} page={page} />

  <main>
    <section id="feliratkozas" class="hero-gradient py-12 md:py-24 px-4 md:px-10">
      <div class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

          <div class="flex flex-col gap-5 md:gap-7 max-w-[560px]">
            <span class="inline-flex items-center gap-2 self-start bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full">
              <span class="material-symbols-outlined text-[16px]">mail</span>
              Hírlevél
            </span>

            <h1 class="text-4xl md:text-[2.6rem] lg:text-[2.85rem] font-extrabold leading-[1.1] tracking-[-0.03em] text-dark">
              Tarts lépést a <span class="text-primary">webshopoddal</span> az
              <span class="text-primary">AI korszakban</span>
            </h1>

            <p class="text-body text-[1.1rem] font-medium leading-relaxed">
              Content Ninja hírlevél hazai webáruházaknak.
            </p>

            <ul class="space-y-3.5 text-body">
              <li class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                <span>Mindig <strong>értesülsz a legfontosabb új funkciókról</strong></span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                <span>Megismered a <strong>legjobb gyakorlatokat</strong> a rendszer használatához</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                <span>Megkapod a <strong>legfontosabb híreket</strong> az e-kereskedelmi szektorból</span>
              </li>
            </ul>

            <div class="flex items-center gap-3">
              <div class="flex -space-x-2">
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
              </div>
              <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ hazai webshop</span> dolgozik velünk</p>
            </div>
          </div>

          <div class="w-full">
            <NewsletterForm
              locale={locale}
              source="hirlevel_oldal"
              heading="Kérem a hírlevelet"
              note="Add meg az e-mail címed – új funkciókról, bevált gyakorlatokról és a szektor híreiről írunk."
            />
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} page={page} />
</BaseLayout>
