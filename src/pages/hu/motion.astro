  <!-- FAQ accordion toggle (globális, mert onclick attribútumból hívjuk).
       Mozgás-módban a magasság lágyan nyílik/csukódik a böngésző saját
       animációs API-jával (Web Animations) – könyvtár nélkül. -->
  <script is:inline>
    function toggleFaq(btn) {
      var item = btn.closest('.faq-item');
      var isOpen = item.classList.contains('open');
      var anim = document.documentElement.classList.contains('m-motion') && !!Element.prototype.animate;
      document.querySelectorAll('.faq-item.open').forEach(function (i) { if (i !== item) closeItem(i); });
      if (isOpen) closeItem(item); else openItem(item);

      function frames(a) {
        return [
          { height: '0px', paddingBottom: '0px', opacity: 0 },
          { height: a.offsetHeight + 'px', paddingBottom: getComputedStyle(a).paddingBottom, opacity: 1 },
        ];
      }
      function openItem(i) {
        i.classList.add('open');
        if (!anim) return;
        var a = i.querySelector('.faq-answer');
        a.style.overflow = 'hidden';
        a.animate(frames(a), { duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' })
          .onfinish = function () { a.style.overflow = ''; };
      }
      function closeItem(i) {
        if (!anim) { i.classList.remove('open'); return; }
        var a = i.querySelector('.faq-answer');
        a.style.overflow = 'hidden';
        var f = frames(a).reverse();
        a.animate(f, { duration: 260, easing: 'ease-in', fill: 'forwards' }).onfinish = function (e) {
          i.classList.remove('open');
          a.style.overflow = '';
          e.target.cancel();
        };
      }
    }
  </script>

