---
/**
 * MOTION DEMÓ – a főoldal (`hu/index.astro`) másolata, motion graphics-szel.
 *
 * Kísérleti oldal: `noindex`, canonical és hreflang nélkül, sitemapbe és
 * robots.txt-be NEM kerül, és sehonnan nem linkeljük. Az élő főoldal
 * változatlan; ha a mozgás bevált, innen emeljük át a darabokat.
 *
 * A mozgás szabályai:
 * - Minden szöveg a HTML-ben van, a végleges állapotában. JS nélkül (kereső,
 *   AI-fetcher, márkaellenőrző) és `prefers-reduced-motion` mellett a statikus,
 *   kész kép látszik. Az elrejtést csak a <head>-ben feltett `html.m-motion`
 *   osztály kapcsolja be, és 4 mp után visszavonjuk, ha a GSAP nem indult el.
 * - A GSAP (+ ScrollTrigger, TextPlugin) CDN-ről jön, csak erre az oldalra.
 * - Csak `transform` és `opacity` mozog; a hero H1-e és bekezdése nem rejtőzik
 *   el (LCP).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HowItWorksVideo from '../../components/HowItWorksVideo.astro';
import Carousel from '../../components/Carousel.astro';
import VideoShowcase from '../../components/VideoShowcase.astro';
import { videos, hasVideo } from '../../data/videos';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import PlatformLogos from '../../components/PlatformLogos.astro';

const locale = 'hu';
const page = 'home';

const title = 'Content Ninja – All-in-one AI marketing webshopoknak | Posztolás, blog, hírlevél';
const description =
  'A Content Ninja all-in-one AI marketing rendszer webshopoknak: posztol Facebookra, Instagramra és TikTokra, SEO-blogcikket ír a webshopod blogjába, hírlevelet tervez és küld, a termékleírásaidat és kategóriaoldalaidat pedig eladósabbra írja – mindezt a saját termékadataidból. Kérj díjmentes bemutatót!';
const keywords =
  'Content Ninja, all-in-one AI marketing, AI tartalomgyártás, webshop marketing, automatikus posztolás, TikTok posztolás, AI blogcikk író, termékleírás újraírás, kategóriaoldal szöveg, Shopgrade, AI hírlevél, social media automatizálás, tartalomnaptár';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Mi az a Content Ninja?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A Content Ninja egy all-in-one AI marketing rendszer webshopoknak. Egy fiókból, ugyanabból a termékkatalógusból dolgozik: social media posztokat ír és publikál Facebookra, Instagramra és TikTokra, SEO- és GEO-barát blogcikket ír a webshopod blogjába, hírlevelet tervez és küld a MailerLite vagy Salesautopilot fiókodból, a meglévő termékleírásaidat és kategóriaoldalaid szövegét pedig eladósabb szövegre írja át – a képeket és videókat is az AI készíti hozzá.',
      },
    },
    {
      '@type': 'Question',
      name: 'Milyen modulok vannak benne, és mind az előfizetés része?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hat modulnak van saját oldala: automata posztolás, blogcikk író, Shopgrade (termékleírás- és kategóriaoldal-újraírás), AI hírlevél, webshop mélyintegráció és nemzetközi terjeszkedés. Ezekhez jön az AI kép-, videó- és narrátorvideó-generálás, valamint a Meta hirdetésgeneráló – és hamarosan a Facebook- és Instagram-posztok kiemelése. Mind a 39.990 Ft + ÁFA / hó előfizetés része, nincs modulonkénti felár – a havi 500 AI kreditet szabadon oszthatod el közöttük.',
      },
    },
    {
      '@type': 'Question',
      name: 'Tud a Content Ninja hírlevelet is küldeni?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Igen. A posztolás mellett a Content Ninja egy teljes AI hírlevél-modult is tartalmaz: az AI megírja a szöveget, megtervezi a dizájnt, képeket rak bele, majd a bekötött MailerLite vagy Salesautopilot fiókodból a meglévő listáidra automatikusan kiküldi – akár egyetlen levelet, akár egy egész kampánysorozatot, rendszeres vagy szezon eleji automatizmusokkal.',
      },
    },
    {
      '@type': 'Question',
      name: 'Mennyibe kerül a Content Ninja előfizetés?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A havi előfizetés 39.990 Ft + ÁFA / hó (bruttó 50.787 Ft), amely havi 500 megújuló AI kreditet tartalmaz. Éves előfizetéssel 12 hónapot kapsz 10 havi díjért: 399.900 Ft + ÁFA / év (bruttó 507.873 Ft), 6.000 kredittel, amit egy összegben, az időszak elején írunk jóvá. A bemutatóért járó 19.995 Ft + ÁFA kedvezmény és a +250 bónusz kredit az első előfizetési időszakra szól, mindkét ciklusnál.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kell-e marketing tudás a Content Ninja használatához?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nem, a Content Ninja pont azoknak készült, akiknek nincs ideje vagy háttértudása a marketing menedzsmenthez. Az AI elvégzi a szakértők munkáját automatikusan.',
      },
    },
  ],
};
---

<BaseLayout locale={locale} page={page} title={title} description={description} ogImage="/assets/og-fooldal.jpg" keywords={keywords} lpEnabled noindex suppressCanonical>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

  <!-- A mozgás kapcsolója: még az első kirajzolás előtt fut. Reduced motion
       mellett be sem kapcsol; ha a motion-script 4 mp alatt nem jelzi, hogy
       elindult (pl. a CDN nem töltött be), visszavonjuk, és minden látszik. -->
  <script slot="head" is:inline>
    (function () {
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var d = document.documentElement;
      d.classList.add('m-motion');
      setTimeout(function () { if (!window.__mReady) d.classList.remove('m-motion'); }, 4000);
    })();
  </script>

  <Header locale={locale} page={page} />

  <!-- Görgetésjelző csík (csak mozgás-módban látszik) -->
  <div class="m-progress" aria-hidden="true"></div>

  <main>
    <!-- ═══════════════════════════════════════
     HERO
═══════════════════════════════════════ -->
    <section id="hero" class="hero-gradient relative py-12 md:py-16 px-4 md:px-10 overflow-hidden">
        <!-- Lassan sodródó háttérfoltok (csak transform; reduced motion mellett állnak) -->
        <div class="m-blob m-blob-a" aria-hidden="true"></div>
        <div class="m-blob m-blob-b" aria-hidden="true"></div>

        <div class="relative z-10 max-w-[1200px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

                <!-- Left: szöveg. A H1 és a bekezdés SOSEM rejtőzik el (LCP) –
                     csak a kiemelés aláhúzása rajzolódik ki, és a lista érkezik. -->
                <div class="flex flex-col gap-5">
                    <span class="text-primary font-bold text-sm uppercase tracking-widest">6 modul · 1 előfizetés</span>

                    <h1
                        class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        All-in-one AI marketing rendszer <span class="m-swash-wrap text-primary">webshopoknak<svg class="m-swash" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 15 C 70 5, 190 3, 296 11" pathLength="1" /></svg></span>
                    </h1>

                    <p class="text-lg text-body leading-snug max-w-[520px]">
                        Posztolás, blogcikk, hírlevél és termékleírás <strong class="text-dark">egy rendszerben</strong>:
                        bekötöd a webshopod, és az AI a termékeidből megírja, megtervezi és publikálja a tartalmat
                        helyetted.
                    </p>

                    <ul class="space-y-2 text-body">
                        <li class="flex items-start gap-2.5" data-hero-in>
                            <span class="m-check material-symbols-outlined text-primary text-[20px] mt-0.5"
                                style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong class="text-dark">Hat modul egy előfizetésben</strong> – posztolás, blogcikk,
                                hírlevél, termékleírás, kép és videó</span>
                        </li>
                        <li class="flex items-start gap-2.5" data-hero-in>
                            <span class="m-check material-symbols-outlined text-primary text-[20px] mt-0.5"
                                style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong class="text-dark">Folyamatos, profi jelenlét</strong> a Google-ben, a social
                                médiában és a postaládákban</span>
                        </li>
                        <li class="flex items-start gap-2.5" data-hero-in>
                            <span class="m-check material-symbols-outlined text-primary text-[20px] mt-0.5"
                                style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span>Több látogató és vásárló, <strong class="text-dark">kevesebb ráfordított
                                    munkaórával</strong></span>
                        </li>
                    </ul>

                    <!-- Webshop mélyintegráció – a hero CTA-gombok helyett a támogatott rendszerek -->
                    <div class="flex items-center gap-2.5 flex-wrap pt-1" data-hero-in>
                        <span class="text-sm font-semibold text-muted">Webshop mélyintegráció:</span>
                        <PlatformLogos variant="pill" lazy={false} />
                    </div>

                    <!-- Social proof (balra helyezve) -->
                    <div class="flex items-center gap-3" data-hero-in>
                        <div class="flex -space-x-2">
                            <div
                                class="m-avatar w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">
                                Sz</div>
                            <div
                                class="m-avatar w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">
                                L</div>
                            <div
                                class="m-avatar w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">
                                ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark"><span data-count="50">50</span>+ webshop</span> már
                            használja</p>
                    </div>

                </div>

                <!-- Right: ÉLŐ jelenet – „egy termékből négy tartalom".
                     A markup a VÉGÁLLAPOTOT írja le (minden kártya kész), így JS
                     nélkül és reduced motion mellett is teljes a kép. A GSAP
                     idővonal ebből indulva rejti el, majd rakja össze újra,
                     végtelenítve. Dekoratív: a képernyőolvasó az aria-labelt kapja. -->
                <div class="hs-wrap">
                    <div class="hs" role="img"
                        aria-label="A Content Ninja egy webshop-termékből Facebook-, Instagram- és TikTok-posztot, blogcikket, hírlevelet és jobb termékleírást készít">
                        <div class="hs-bg" aria-hidden="true"></div>

                        <div class="hs-label hs-label-in hs-anim" aria-hidden="true">
                            <span class="material-symbols-outlined">storefront</span>A webshopodból
                        </div>
                        <div class="hs-label hs-label-out hs-anim" aria-hidden="true">
                            <span class="material-symbols-outlined">auto_awesome</span>Kész tartalmak
                        </div>

                        <!-- Összekötő vonalak: a termékből a hubba, onnan a 4 kártyába.
                             base = kirajzolódó vonal, flow = utána végtelenül áramló szaggatott -->
                        <svg class="hs-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                            <path class="hs-base hs-trunk" pathLength="1" d="M41 48 H46" />
                            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 19.5, 54 19.5" />
                            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 40.5, 54 40.5" />
                            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 61.5, 54 61.5" />
                            <path class="hs-base" pathLength="1" d="M49 48 C 51.6 48, 51.4 82.5, 54 82.5" />
                            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 19.5, 54 19.5" />
                            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 40.5, 54 40.5" />
                            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 61.5, 54 61.5" />
                            <path class="hs-flow" d="M49 48 C 51.6 48, 51.4 82.5, 54 82.5" />
                        </svg>

                        <!-- A termék -->
                        <div class="hs-product hs-anim" aria-hidden="true">
                            <div class="hs-product-img">
                                <img src="/assets/motion-termek-cserep.webp" width="1024" height="1024" alt=""
                                    fetchpriority="high" />
                                <div class="hs-scan"></div>
                            </div>
                            <div class="hs-product-name">Pilea levendula kaspóban</div>
                            <div class="hs-product-meta"><span class="hs-price">8 990 Ft</span><span class="hs-stock">Raktáron</span></div>
                        </div>

                        <!-- AI hub -->
                        <div class="hs-hub hs-anim" aria-hidden="true">
                            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">auto_awesome</span>
                        </div>

                        <!-- Állapotjelző -->
                        <div class="hs-status hs-anim" aria-hidden="true">
                            <span class="hs-status-icon material-symbols-outlined" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span class="hs-status-text">4 tartalom kész</span>
                        </div>

                        <!-- 1. Poszt -->
                        <div class="hs-card hs-anim" style="top:10%" aria-hidden="true">
                            <img class="hs-thumb" src="/assets/motion-termek-cserep.webp" width="1024" height="1024" alt="" />
                            <div class="hs-body">
                                <div class="hs-row">
                                    <span class="hs-kicker">Poszt</span>
                                    <span class="hs-socials">
                                        <svg viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#1877F2"/><path d="M14.9 12.5l.35-2.3h-2.2V8.7c0-.63.31-1.24 1.3-1.24h1V5.5s-.9-.15-1.77-.15c-1.8 0-2.98 1.1-2.98 3.07v1.78H8.6v2.3h1.99V18h2.45v-5.5h1.86z" fill="#fff"/></svg>
                                        <svg viewBox="0 0 24 24"><defs><linearGradient id="igGradHs" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse"><stop stop-color="#FEDA75"/><stop offset=".35" stop-color="#FA7E1E"/><stop offset=".6" stop-color="#D62976"/><stop offset="1" stop-color="#962FBF"/></linearGradient></defs><rect width="24" height="24" rx="6" fill="url(#igGradHs)"/><rect x="6" y="6" width="12" height="12" rx="4" fill="none" stroke="#fff" stroke-width="1.5"/><circle cx="12" cy="12" r="2.8" fill="none" stroke="#fff" stroke-width="1.5"/><circle cx="16.2" cy="7.8" r="1" fill="#fff"/></svg>
                                        <svg viewBox="0 0 24 24"><path fill="#000000" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                                    </span>
                                </div>
                                <div class="hs-title hs-type">Új zöld kedvenc 🌿 A Pilea levendula kaspóban érkezik!</div>
                                <div class="hs-meta"><span class="material-symbols-outlined">schedule</span>Ütemezve · ma 18:00</div>
                            </div>
                        </div>

                        <!-- 2. Blogcikk -->
                        <div class="hs-card hs-anim" style="top:31%" aria-hidden="true">
                            <div class="hs-ico"><span class="material-symbols-outlined">article</span></div>
                            <div class="hs-body">
                                <div class="hs-row">
                                    <span class="hs-kicker">Blogcikk</span>
                                    <span class="hs-badge"><span class="material-symbols-outlined">check</span>Publikálva</span>
                                </div>
                                <div class="hs-title hs-type">Pilea gondozása: 7 tipp kezdőknek</div>
                                <div class="hs-lines-sk"><i style="width:92%"></i><i style="width:70%"></i></div>
                            </div>
                        </div>

                        <!-- 3. Hírlevél -->
                        <div class="hs-card hs-anim" style="top:52%" aria-hidden="true">
                            <div class="hs-ico"><span class="material-symbols-outlined">mail</span></div>
                            <div class="hs-body">
                                <div class="hs-row">
                                    <span class="hs-kicker">Hírlevél</span>
                                    <span class="hs-badge"><span class="material-symbols-outlined">check</span>Kiküldve</span>
                                </div>
                                <div class="hs-title hs-type">Tavaszi zöld újdonságok 🌱</div>
                                <div class="hs-lines-sk"><i style="width:84%"></i><i style="width:58%"></i></div>
                            </div>
                        </div>

                        <!-- 4. Termékleírás (Shopgrade) -->
                        <div class="hs-card hs-anim" style="top:73%" aria-hidden="true">
                            <div class="hs-gauge">
                                <svg viewBox="0 0 36 36">
                                    <circle cx="18" cy="18" r="15" class="hs-gauge-track" />
                                    <circle cx="18" cy="18" r="15" class="hs-gauge-bar" pathLength="100" />
                                </svg>
                                <span class="hs-gauge-num">91</span>
                            </div>
                            <div class="hs-body">
                                <div class="hs-row">
                                    <span class="hs-kicker">Termékleírás</span>
                                    <span class="hs-badge"><span class="material-symbols-outlined">check</span>Kész</span>
                                </div>
                                <div class="hs-title hs-type">SEO- és GEO-barát, eladósabb leírás</div>
                                <div class="hs-meta"><span class="material-symbols-outlined">trending_up</span>Shopgrade pontszám</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hitelesitesek: Meta Tech Provider + UNAS partner (kozos komponens) -->
    <TrustBadges locale={locale} />


    <!-- ═══════════════════════════════════════
     MEGOLDÁSOK / USE-CASE-EK
═══════════════════════════════════════ -->
    <section id="megoldasok" class="bg-light py-20 md:py-28 px-4 md:px-10">
        <div class="max-w-[1200px] mx-auto">
            <div class="text-center max-w-[700px] mx-auto mb-14" data-reveal>
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Megoldások</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Mire használják a Content Ninját?</h2>
                <p class="text-body text-lg">Minden modul ugyanabból a termékkatalógusból dolgozik – válaszd ki, mi
                    a te helyzeted, és megmutatjuk, hogyan segít a rendszer.</p>
            </div>

            <Carousel label="Megoldások" prevLabel="Előző megoldások" nextLabel="További megoldások">

                <!-- ChatGPT hirdetéskezelő – ELSŐ helyen, mert ez az újdonság, és a lapozó
                     desktopon négy kártyát mutat egyszerre.
                     A „Hamarosan" pill a KÁRTYÁN marad (a menüből kikerült): egy megoldás-rács
                     különben azt ígérné, hogy ez ma is használható. -->
                <a href="/hu/chatgpt-ads/"
                    class="group snap-start shrink-0 basis-full sm:basis-[calc((100%-1.5rem)/2)] lg:basis-[calc((100%-4.5rem)/4)] bg-card rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5 flex flex-col">
                    <div class="flex items-start justify-between gap-3 mb-5">
                        <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0">
                            <span class="material-symbols-outlined text-[22px]">ads_click</span>
                        </div>
                        <span class="bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-wide px-2 py-1 rounded-full">Hamarosan</span>
                    </div>
                    <h3 class="font-bold text-xl mb-2 text-dark">ChatGPT hirdetéskezelő</h3>
                    <p class="text-body text-sm leading-relaxed mb-5 flex-1">A webshopod termékeiből automata
                        kampányt indít a ChatGPT-ben. Naponta kielemzi a számokat, és segít optimalizálni a
                        kampányokat.</p>
                    <!-- Az OpenAI jele EREDETI, módosítatlan formában (fekete) – átszínezni tilos, és
                         semmi nem utalhat partnerségre. -->
                    <div class="flex items-center gap-2 mb-4">
