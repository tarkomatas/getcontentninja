  <!-- FAQ accordion toggle (globális, mert onclick attribútumból hívjuk).
       Mozgás-módban a magasság lágyan nyílik/csukódik; anélkül a régi kapcsoló. -->
  <script is:inline>
    function toggleFaq(btn) {
      var item = btn.closest('.faq-item');
      var isOpen = item.classList.contains('open');
      var anim = window.gsap && document.documentElement.classList.contains('m-motion');
      document.querySelectorAll('.faq-item.open').forEach(function (i) { if (i !== item) closeItem(i); });
      if (isOpen) closeItem(item); else openItem(item);

      function openItem(i) {
        i.classList.add('open');
        if (!anim) return;
        var a = i.querySelector('.faq-answer');
        gsap.fromTo(a, { height: 0, opacity: 0, paddingBottom: 0, overflow: 'hidden' },
          { height: 'auto', opacity: 1, paddingBottom: 20, duration: 0.4, ease: 'power2.out', clearProps: 'all' });
      }
      function closeItem(i) {
        if (!anim) { i.classList.remove('open'); return; }
        var a = i.querySelector('.faq-answer');
        gsap.to(a, { height: 0, opacity: 0, paddingBottom: 0, overflow: 'hidden', duration: 0.3, ease: 'power2.in',
          onComplete: function () { i.classList.remove('open'); gsap.set(a, { clearProps: 'all' }); } });
      }
    }
  </script>

