        scoreTo.textContent = '42';
        gsap.set(S, { autoAlpha: 0 });

        var tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.out', duration: 0.5 } });

        // 1. Alapbeállítás (0–3)
        tl.set(S[0], { autoAlpha: 1 }, 0)
          .fromTo($$('[data-scene="0"] > *', sc), { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, stagger: 0.28, duration: 0.45 }, 0.05)
          .set('.s1-url', { text: '' }, 0)
          .to('.s1-url', { text: { value: 'zoldsarok.hu' }, duration: 0.8, ease: 'none' }, 0.25)
          .fromTo('.s1-logo', { scale: 0, rotate: -40 }, { scale: 1, rotate: 0, ease: 'back.out(2.5)' }, 0.5)
          .fromTo('.s1-logos span', { scale: 0.6, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, stagger: 0.1, ease: 'back.out(2)' }, 0.75)
          .fromTo('.s1-ok', { scale: 0.7 }, { scale: 1, ease: 'back.out(3)' }, 1.05)
          .fromTo('.s1-tiles i', { scale: 0 }, { scale: 1, stagger: 0.07, duration: 0.35, ease: 'back.out(2)' }, 1.3)
          .to(S[0], { autoAlpha: 0, y: -14, duration: 0.4 }, 2.6);

        // 2. Ötletvadászat (3–6)
        var lens = $('.s2-lens', sc);
        var picks = q('.s2-tile.is-pick');
        function lensAt(tile) {
          return {
            x: function () { return tile.offsetLeft + tile.offsetWidth / 2 - lens.offsetWidth / 2; },
            y: function () { return tile.offsetTop + tile.offsetHeight * 0.4 - lens.offsetHeight / 2; },
          };
        }
        tl.fromTo(S[1], { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.4 }, 3)
          .fromTo(q('.s2-tile'), { autoAlpha: 0, scale: 0.9 }, { autoAlpha: 1, scale: 1, stagger: 0.07, duration: 0.35 }, 3.1)
          .fromTo(lens, Object.assign({ autoAlpha: 0, scale: 0.6 }, lensAt(picks[0])), { autoAlpha: 1, scale: 1, duration: 0.3 }, 3.6);
        picks.forEach(function (p, i) {
          var t = 3.75 + i * 0.6;
          if (i) tl.to(lens, Object.assign({ duration: 0.45, ease: 'power2.inOut' }, lensAt(p)), t - 0.45);
          tl.fromTo($('.s2-ring', p), { autoAlpha: 0, scale: 1.15 }, { autoAlpha: 1, scale: 1, duration: 0.25 }, t)
            .fromTo($('.s2-check', p), { scale: 0 }, { scale: 1, duration: 0.3, ease: 'back.out(3)' }, t + 0.05);
        });
        tl.to(lens, { autoAlpha: 0, scale: 0.6, duration: 0.25 }, 5.2)
          .fromTo(q('.s2-idea'), { autoAlpha: 0, y: 10, scale: 0.9 }, { autoAlpha: 1, y: 0, scale: 1, stagger: 0.12, duration: 0.35, ease: 'back.out(2)' }, 5.0)
          .to(S[1], { autoAlpha: 0, y: -14, duration: 0.4 }, 5.7);

        // 3. Tartalomgyártás (6–9)
        tl.fromTo(S[2], { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.4 }, 6)
          .fromTo(q('.s3-card'), { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, stagger: 0.12, duration: 0.4 }, 6.1)
          .fromTo(q('.s3-sk'), { autoAlpha: 1 }, { autoAlpha: 0, stagger: 0.35, duration: 0.35 }, 6.8)
          .fromTo(q('.s3-card > :not(.s3-sk):not(.s3-kicker)'), { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, stagger: 0.09, duration: 0.3 }, 6.85)
          .fromTo(score, { v: 42 }, { v: 91, duration: 0.8, onUpdate: function () { scoreTo.textContent = Math.round(score.v); } }, 8.0)
          .to(S[2], { autoAlpha: 0, y: -14, duration: 0.4 }, 8.7);

        // 4. Publikálás (9–12)
        tl.fromTo(S[3], { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.4 }, 9)
          .fromTo(q('.s4-pill'), { autoAlpha: 0, y: -10, scale: 0.8 }, { autoAlpha: 1, y: 0, scale: 1, stagger: 0.07, duration: 0.3, ease: 'back.out(2.5)' }, 9.3)
          .fromTo(q('.s4-toast'), { autoAlpha: 0, x: 40 }, { autoAlpha: 1, x: 0, stagger: 0.35, duration: 0.4, ease: 'back.out(1.6)' }, 10.1)
          .to({}, { duration: 0.6 }, 11.4);

        var total = tl.duration();
        var lastIdx = -1;
        tl.eventCallback('onUpdate', function () {
          var t = tl.time();
          var idx = Math.min(3, Math.floor(t / 3));
          gsap.set(fill, { scaleY: Math.min(1, t / (total - 0.6)) });
          if (idx === lastIdx) return;
          lastIdx = idx;
          steps.forEach(function (s, i) {
            s.classList.toggle('is-active', i === idx);
            s.classList.toggle('is-done', i < idx);
          });
          barText.textContent = (idx + 1) + ' · ' + names[idx];
        });
        tl.progress(0.001).progress(0);

        var mm = gsap.matchMedia();
        // Desktop: a blokk rögzül, a görgetés viszi a jeleneteket. Az idővonal
        // már a beúszáskor elindul (top 70%), hogy rögzítéskor ne üres ablak fogadjon;
        // a vége a rögzítés végéhez igazodik.
        mm.add('(min-width: 1024px)', function () {
          var header = $('#top');
          var pinST = ScrollTrigger.create({
            trigger: '.sc-pin', pin: true, anticipatePin: 1, invalidateOnRefresh: true,
            start: function () { return 'top top+=' + (header ? header.offsetHeight : 0); },
            end: '+=2600',
          });
          var animST = ScrollTrigger.create({
            trigger: '.sc-pin', animation: tl, scrub: 0.6, invalidateOnRefresh: true,
            start: 'top 70%',
            end: function () { return pinST.end; },
          });
          return function () { animST.kill(); pinST.kill(); };
        });
        // Mobil: nincs rögzítés, a jelenetek maguktól futnak, amíg látszanak
        mm.add('(max-width: 1023px)', function () {
          tl.repeat(-1).repeatDelay(0.8);
          var st = ScrollTrigger.create({ trigger: '.sc-stage', start: 'top 85%', end: 'bottom 10%',
            onToggle: function (self) { self.isActive ? tl.play() : tl.pause(); } });
          return function () { st.kill(); tl.pause().repeat(0); };
        });
      }

      /* ── Beúszó blokkok görgetéskor (a komponensek belsejét is itt jelöljük) ── */
      function initReveals() {
        ['#megoldasok .snap-start', '#videok > div > *', '.ti-card', '#arazas .grid > div', '.faq-item'].forEach(function (s) {
          $$(s).forEach(function (el) { el.setAttribute('data-reveal', ''); });
        });
        gsap.set('[data-reveal]', { y: 28, transition: 'none' });
        ScrollTrigger.batch('[data-reveal]', {
          start: 'top 88%',
          once: true,
          onEnter: function (batch) {
            gsap.to(batch, { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.08, overwrite: true,
              clearProps: 'transform,transition' });
            batch.forEach(function (el) {
              var stars = $$('.text-yellow-400', el);
              if (stars.length) gsap.fromTo(stars, { scale: 0, rotate: -30 },
                { scale: 1, rotate: 0, duration: 0.4, stagger: 0.06, delay: 0.35, ease: 'back.out(3)' });
            });
          },
        });
      }

      /* ── Számlálók: a HTML a végső számot tartalmazza, innen futunk fel 0-ról ── */
      function initCounters() {
        $$('[data-count]').forEach(function (el) {
          var end = Number(el.getAttribute('data-count'));
          var o = { v: 0 };
          el.textContent = '0';
          ScrollTrigger.create({ trigger: el, start: 'top 92%', once: true, onEnter: function () {
            gsap.to(o, { v: end, duration: 1.6, ease: 'power2.out',
              onUpdate: function () { el.textContent = Math.round(o.v).toLocaleString('hu-HU'); } });
          } });
        });
      }
    });
  </script>
</BaseLayout>
