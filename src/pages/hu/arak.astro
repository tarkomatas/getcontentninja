---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';

const locale = 'hu';
const page = 'pricing';

const title = 'Árak és kreditdíjak – Content Ninja';
const description =
  'A Content Ninja ára: 34.990 Ft + ÁFA / hó havi 500 megújuló AI kredittel, vagy 349.900 Ft + ÁFA / év — 12 hónap 10 havi díjért, 6.000 kredittel egy összegben. Nézd meg a részletes kreditdíjakat műveletenként, az extra kreditcsomagok árát és a fizetés menetét.';
const keywords =
  'Content Ninja ár, Content Ninja árazás, éves előfizetés, AI kredit, kreditdíjak, kreditfogyasztás, extra kredit, előfizetés, AI tartalomgyártás ára';

// A kreditvásárlás és az előfizetés-kezelés az appon keresztül indul (nem
// közvetlen Stripe-linkkel), így a felhasználó előbb belép a saját fiókjába.
const APP_URL = 'https://app.getcontentninja.com';

const faqs = [
  {
    q: 'Mennyibe kerül a Content Ninja?',
    a: 'Egyetlen csomag van, kétféle számlázási ciklussal. Havi előfizetés: 34.990 Ft + ÁFA / hó (bruttó 44.437 Ft), havi 500 megújuló AI kredittel. Éves előfizetés: 349.900 Ft + ÁFA / év (bruttó 444.373 Ft) — 12 hónap 10 havi díjért, 6.000 kredittel, amit egy összegben írunk jóvá. Mindkettő tartalmazza az összes modult. Ha bemutatót kérsz, 17.495 Ft + ÁFA kedvezményt kapsz az első előfizetési időszak díjából, +250 bónusz kredittel: a havi csomag első hónapja így 17.495 Ft + ÁFA (750 kredit), az éves első éve pedig 332.405 Ft + ÁFA (6.250 kredit).',
  },
  {
    q: 'Miben más az éves előfizetés, mint a havi?',
    a: 'Két dologban. Egyrészt olcsóbb: 12 hónapot 10 havi díjért kapsz, vagyis egy éven 69.980 Ft + ÁFA-t (bruttó 88.871 Ft-ot) spórolsz. Másrészt — sokaknak ez a fontosabb — nincs havi plafon: a 6.000 kredit (pontosan annyi, mint 12×500) az előfizetési időszak kezdetén, egy összegben érkezik, és 12 hónapon belül szabadon, saját ütemezés szerint használod fel. Egy 3.000 termékes katalógus újraírását így az első hetekben végigviheted, nem kell hat hónapra elosztanod.',
  },
  {
    q: 'Van hűségidő vagy határozott idejű szerződés?',
    a: 'A havi előfizetésnek nincs hűségideje: határozatlan időre szól, bármikor lemondható, és a hónapfordulóig utána is korlátlanul használhatod. Az éves előfizetés ezzel szemben 12 hónapos, egybefüggő időszakra szól, amelynek díját egy összegben, előre fizeted ki: lemondani bármikor lehet, de a felmondás a kifizetett 12 hónap végén lép hatályba, és az éves díj időarányos része nem téríthető vissza. Felmondási díj egyik ciklusnál sincs.',
  },
  {
    q: 'Mi történik az éves 6.000 kredittel az év végén?',
    a: 'A fel nem használt kreditek az előfizetési időszak végén lejárnak, és nem vihetők át a megújított időszakra — a megújuláskor friss 6.000 kredit érkezik. A külön vásárolt extra kredit ettől független: az a vásárlástól számított 365 napig érvényes.',
  },
  {
    q: 'Átválthatok havi előfizetésről évesre?',
    a: 'Igen, bármikor, és a váltás azonnal hatályba lép. A kifizetett havi időszakból hátralévő idő időarányos részét jóváírjuk az éves díjba, a váltáskor megmaradt havi kreditjeid pedig nem vesznek el: a lejáratuk kitolódik az éves időszak végéig, és a 6.000 kredites éves kereten felül állnak rendelkezésedre. Visszafelé — évesről havira — a váltás csak a kifizetett 12 hónap lejártával lép életbe.',
  },
  {
    q: 'Van olcsóbb, kisebb csomag?',
    a: 'Nincs. Kisebb, kevesebb kreditet tartalmazó szint nem választható: egyetlen csomagot kínálunk, amelyben minden modul benne van — csak a számlázási ciklust, a havit vagy az évest választod meg.',
  },
  {
    q: 'Mi az az AI kredit, és mire elég 500?',
    a: 'A kredit az AI műveletek elszámolási egysége: minden generálás (posztszöveg, kép, videó, hírlevél) meghatározott számú kreditet von le. Egy posztszöveg 1 kredit, egy Nano Banana kép 2 kredit, vagyis egy képes poszt 3 kredit — ebből havi 500 kredit nagyjából 166 képes posztra elég. Egy blogcikk szövege 3 kredit (a cikkbe kerülő képek 2 kredit/kép), egy termékleírás újraírása pedig 1 kredit / termékoldal (kategóriaoldalnál 2 kredit). A publikálás és az időzítés nem AI művelet, azért nem vonunk kreditet.',
  },
  {
    q: 'Mi történik, ha elfogy a keretem?',
    a: 'Az AI-alapú tartalomgenerálás a következő keret megnyílásáig szünetel — havi előfizetésnél a következő hónapfordulóig, éves előfizetésnél az éves megújulásig —, a rendszer többi funkciója (naptár, ütemezés, publikálás, statisztikák) viszont változatlanul működik. Ha nem akarsz várni, bármikor vásárolhatsz extra kreditet.',
  },
  {
    q: 'Mennyibe kerül az extra kredit, és meddig érvényes?',
    a: 'Két csomag közül választhatsz: 500 kredit 14.990 Ft + ÁFA áron (bruttó 19.037 Ft), nagyobb projektre pedig 5.000 kredit 134.990 Ft + ÁFA áron (bruttó 171.437 Ft, kb. 10% kedvezmény a kreditárban). A megvásárolt extra kredit a vásárlástól számított 365 napig érvényes, és a havi kereted mellé adódik hozzá.',
  },
  {
    q: 'Átgörgethető a fel nem használt havi kredit a következő hónapra?',
    a: 'Nem. A havidíjban foglalt 500 kredit az adott számlázási időszakra szól, és minden hónapfordulókor nullázódik, majd újratöltődik. Egy kivétel van: ha éves előfizetésre váltasz, a megmaradt havi kreditek lejárata kitolódik az éves időszak végéig. Az éves csomag 6.000 kreditjét havonta semmi nem nullázza, az a 12 hónap egészére szól. A külön vásárolt extra kredit ettől függetlenül 365 napig megmarad. Előfizetés lemondása esetén a fel nem használt extra kreditek is elvesznek az időszak végén.',
  },
  {
    q: 'Hogyan történik a fizetés?',
    a: 'A fizetés bankkártyával, a Stripe felületén keresztül történik, mindig előre: a havi előfizetést havonta, az éves előfizetést egy összegben, az időszak kezdetekor számlázzuk. A kártyaadatok kezelését a Stripe végzi, a saját biztonsági szabványai szerint. A számlát a regisztrációkor megadott számlázási adatokra állítjuk ki, külön adatmegadás nem szükséges.',
  },
  {
    q: 'Hogyan módosíthatom a bankkártyámat vagy mondhatom le az előfizetést?',
    a: 'Mindkettőt az appból intézheted, miután beléptél a fiókodba. Kártyacserénél először mindig az új fizetési módot add hozzá, és csak utána töröld a régit. Lemondásnál nyisd meg az előfizetésed, majd erősítsd meg a lemondást — a hónapfordulóig utána is használhatod a rendszert.',
  },
  {
    q: 'Több webshopot is kezelhetek egy előfizetéssel?',
    a: 'Igen. Egy előfizetésen belül több brandet (webshopot) is felvehetsz, mindegyikhez saját alapinformációkkal, logóval és tudásforrásokkal, és brandenként több közösségi média fiókot is bekötsz — a fiókok száma nincs korlátozva. Technikai okokból viszont jelenleg előfizetésenként egy felhasználót tudunk biztosítani.',
  },
  {
    q: 'Visszatérítitek a már kifizetett díjat?',
    a: 'A már kifizetett előfizetési díjak nem visszatéríthetők — ez az éves előfizetés egy összegben, előre megfizetett díjára is vonatkozik, annak időarányos része sem írható jóvá. Lemondás esetén a szolgáltatás a kifizetett időszak végéig aktív marad, tehát nem veszíted el azt, amit már kifizettél.',
  },
  {
    q: 'Hogyan tudom követni a saját fogyasztásomat?',
    a: 'Az appban a Fogyasztás menüpont valós időben mutatja az aktuális kreditegyenleged, a műveletenkénti fogyasztási előzményeket és az extra kreditek lejárati dátumát.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const textOps = [
  { op: 'Poszt szöveg generálás / újragenerálás', credit: '1' },
  { op: 'Hírlevél szöveg generálás / újragenerálás', credit: '3' },
  { op: 'Blogcikk szöveg generálás / újragenerálás', credit: '3' },
  { op: 'Blogcikk mély kutatás (opcionális, internetes kereséssel)', credit: '5' },
  { op: 'Termékleírás újraírás (Shopgrade)', credit: '1 / termék' },
  { op: 'Kategóriaoldal újraírás (Shopgrade)', credit: '2 / kategória' },
  { op: 'Hirdetés szöveg generálás / újragenerálás', credit: '1' },
  { op: 'HTML sablon generálás hírlevélhez (egyszeri)', credit: '2' },
];

const imageOps = [
  { op: 'Új / meglévő kép generálása (Nano Banana)', credit: '2' },
  { op: 'Új / meglévő kép generálása (Nano Banana Pro)', credit: '5' },
  { op: 'Új / meglévő kép generálása (GPT Image)', credit: '5' },
  { op: 'Blogcikk képei (borító + beágyazott, Nano Banana)', credit: '2 / kép' },
  { op: 'Képből rövid animáció (WAN Video)', credit: '2' },
  { op: 'Képből rövid animáció (Grok Imagine Video)', credit: '1 / mp' },
];

const videoOps = [
  { op: 'Videó forgatókönyv generálás', credit: '1' },
  { op: 'Videó generálás', credit: '1 / mp' },
];

const narrationOps = [
  { op: 'Képgenerálás', credit: '2 / kép' },
  { op: 'Narráció generálás', credit: '1' },
  { op: 'Háttérzene generálás', credit: '1' },
  { op: 'Felirat generálás', credit: '1' },
  { op: 'Videógenerálás indítása + az első 30 mp', credit: '5' },
  { op: 'Minden további megkezdett 30 mp', credit: '4' },
];

const freeOps = [
  'Publikálás és időzítés (Facebook, Instagram)',
  'Képre logó elhelyezése',
  'Marketing naptár, jóváhagyás, szerkesztés',
  'Statisztikák megtekintése',
  'Az első hozzászólás megírása a poszt alá',
];
---

<BaseLayout
  locale={locale}
  page={page}
  title={title}
  description={description}
  keywords={keywords}
  lpEnabled
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

  <Header locale={locale} page={page} />

  <main>
    <!-- ═══════════════════════════════════════
     HERO
═══════════════════════════════════════ -->
    <section id="hero" class="hero-gradient py-12 md:py-24">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10">
        <div class="max-w-[760px] mx-auto text-center flex flex-col gap-5 animate-fade-up">
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">ÁRAZÁS</span>
          <!-- A „-tól" nem stílus, hanem pontosság: a 29.158 Ft éves előfizetéssel
               érhető el, havi ciklusban 34.990 Ft. -->
          <h1 class="text-3xl md:text-5xl font-extrabold tracking-[-0.03em] leading-tight">
            Egy csomag <span class="text-primary">webshopoknak</span>, havi
            <span class="text-primary">29.158 Ft + ÁFA</span>-tól
          </h1>
          <p class="text-body text-lg leading-relaxed">
            Minden modul benne van — posztolás, blogcikk, Shopgrade, hírlevél, kép- és
            videógenerálás.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 mt-1">
            <span class="inline-flex items-center gap-2 bg-success/10 border border-success/30 text-success rounded-[10px] px-4 py-2 text-sm font-bold">
              <span class="material-symbols-outlined text-[18px]">savings</span>
              Éves csomag: 2 hónap ingyen
            </span>
            <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-4 py-2 text-sm font-medium text-body">
              <span class="material-symbols-outlined text-primary text-[18px]">lock_open</span>
              A havi csomagnak nincs hűségideje
            </span>
            <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-4 py-2 text-sm font-medium text-body">
              <span class="material-symbols-outlined text-primary text-[18px]">credit_card</span>
              Fizetés Stripe-pal
            </span>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-4">
            <a href="/hu/online-bemutato/" class="cta-primary px-6 h-12 text-sm w-full sm:w-auto justify-center">
              Bemutatót kérek
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
            <a href="#kreditek" class="cta-secondary px-6 h-12 text-sm w-full sm:w-auto justify-center">
              Részletes kreditdíjak
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Hitelesitesek: Meta Tech Provider + UNAS partner (kozos komponens) -->
    <TrustBadges locale={locale} />

    <!-- ═══════════════════════════════════════
     CSOMAG
═══════════════════════════════════════ -->
    <section id="csomag" class="bg-light py-20 md:py-28">
      <div class="max-w-[900px] mx-auto px-4 md:px-10">
        <div class="text-center mb-10">
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">A CSOMAG</span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Próbáld ki kedvezményes áron!</h2>
          <!-- A „havi előfizetés esetén" nem szőrszálhasogatás: az éves 12 hónapos,
               egybefüggő időszak, időarányos visszatérítés nélkül (ÁSZF 4.3, 5.2). -->
          <p class="text-body text-lg">
            Ha nem tetszik, havi előfizetés esetén bármikor lemondhatod. Nincs kockázat.
          </p>
        </div>

        <PricingCards locale={locale} />
      </div>
    </section>

    <!-- ═══════════════════════════════════════
     MIRE ELÉG 500 KREDIT
═══════════════════════════════════════ -->
    <section id="mire-eleg" class="bg-card py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10">
        <div class="text-center mb-14">
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">SZÁMPÉLDÁK</span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Mire elég havi 500 kredit?</h2>
          <p class="text-body text-lg">Hat tipikus felhasználás — ha csak egy dologra költenéd a keretet.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          {[
            {
              icon: 'edit_note',
              title: '≈ 166 képes poszt',
              detail: 'Posztszöveg (1) + Nano Banana kép (2) = 3 kredit / poszt',
            },
            {
              icon: 'article',
              title: '≈ 71 blogcikk',
              detail: 'Cikkszöveg (3) + 2 kép, Nano Banana (2×2) = 7 kredit / cikk. A mély kutatás opcionális, +5.',
            },
            {
              icon: 'edit_document',
              title: '≈ 500 termékleírás',
              detail: 'Shopgrade: 1 kredit / termékoldal, 2 kredit / kategóriaoldal – tömegesen is.',
            },
            {
              icon: 'mail',
              title: '≈ 100 hírlevél',
              detail:
                'Hírlevél szöveg (3) + 1 kép, Nano Banana (2) = 5 kredit / levél. A HTML sablont elég egyszer legenerálni.',
            },
            {
              icon: 'movie',
              title: '≈ 25 narrációvideó',
              detail: '1 perces, 4 képes videó = 20 kredit / videó',
            },
            {
              icon: 'image',
              title: '≈ 250 AI kép',
              detail: 'Nano Banana kép: 2 kredit / kép, brandazonos, logózott kreatív.',
            },
          ].map((card) => (
            <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all">
              <div class="w-12 h-12 rounded-[12px] bg-primary/10 flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-primary text-[22px]">{card.icon}</span>
              </div>
              <h3 class="text-xl font-bold text-dark mb-2">{card.title}</h3>
              <p class="text-body text-sm leading-relaxed">{card.detail}</p>
            </div>
          ))}
        </div>

        <div class="bg-light rounded-[16px] border border-border p-5 sm:p-8 shadow-card">
          <h3 class="text-xl font-bold text-dark mb-4">Egy reális, vegyes hónap</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm">
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">edit_note</span>
              <span>15 képes poszt (heti 3–4) <strong class="text-dark">45</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">article</span>
              <span>5 blogcikk, képekkel <strong class="text-dark">35</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">edit_document</span>
              <span>350 termékleírás újraírása <strong class="text-dark">350</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">mail</span>
              <span>6 hírlevél <strong class="text-dark">30</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">movie</span>
              <span>2 narrátorvideó <strong class="text-dark">40</strong></span>
            </div>
            <div class="flex items-center gap-2 font-bold text-dark">
              <span class="material-symbols-outlined text-success text-[20px]">check_circle</span>
              <span>összesen 500 kredit</span>
            </div>
          </div>
          <p class="text-muted text-sm mt-4">
            A publikálás mindezek mellett korlátlan és ingyenes. Az appban a Fogyasztás
            menüpontban valós időben követheted az egyenleged.
          </p>
        </div>

        <!-- Éves keret: ugyanaz a kreditmennyiség, de havi plafon nélkül -->
        <div class="bg-primary/5 rounded-[16px] border border-primary/20 p-5 sm:p-8 mt-8">
          <h3 class="text-xl font-bold text-dark mb-2">És mire elég az éves 6.000 kredit?</h3>
          <p class="text-body text-sm leading-relaxed mb-5">
            Pontosan ugyanannyi, mint 12 hónapnyi havi keret — a különbség az, hogy
            <strong class="text-dark">nincs havi plafon</strong>: a teljes keret az első napon
            megérkezik, és 12 hónapon belül szabadon osztod be. Ezért fér bele egy nagy
            indulóroham is, amit a havi keretből fél éven át kellene adagolnod:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm">
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">edit_document</span>
              <span>3.000 termékleírás az induláskor <strong class="text-dark">3.000</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">category</span>
              <span>200 kategóriaoldal <strong class="text-dark">400</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">article</span>
              <span>40 blogcikk, képekkel <strong class="text-dark">280</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">edit_note</span>
              <span>180 képes poszt (heti 3–4, egész évben) <strong class="text-dark">540</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">mail</span>
              <span>48 hírlevél (hetente egy) <strong class="text-dark">240</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">movie</span>
              <span>24 narrátorvideó (havi kettő) <strong class="text-dark">480</strong></span>
            </div>
            <div class="flex items-center gap-2 text-body">
              <span class="material-symbols-outlined text-primary text-[20px]">inventory_2</span>
