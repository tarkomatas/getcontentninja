---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';

/**
 * „Teljes rendszer" kampányoldal – az all-in-one szög fizetett landingje.
 *
 * Az AJÁNLAT azonos az `/hu/online-bemutato/` oldaléval (díjmentes online
 * bemutató, ugyanaz az űrlap, ugyanazok a minősítő kérdések, ugyanaz a
 * köszönőoldal) – szándékosan, hogy a két oldal eredménye összehasonlítható
 * legyen. Ami más, az a HOROG a hajtás fölött: itt nem a bemutató eseménye,
 * hanem az „egy rendszer az egész webshop-marketingedre" ígéret.
 *
 * A minősítő kérdéseket NE változtasd meg a bemutató oldalhoz képest – ha
 * eltérnek, a két oldal lead-minősége már nem vethető össze.
 *
 * `noindex`: ugyanaz az ígéret, mint a főoldalé, és ugyanaz az ajánlat, mint az
 * online-bemutatóé – organikusan kannibalizálná mindkettőt. Tisztán hirdetési
 * cél, a robots.txt is tiltja.
 */
const locale = 'hu';
const page = 'allInOne';
const title = 'All-in-one AI marketing rendszer webshopoknak | Content Ninja';
const description =
  'Posztolás, blogcikk, hírlevél és termékleírás egy rendszerben: bekötöd a webshopod, és az AI a saját termékadataidból írja, tervezi és publikálja a tartalmat. Kérj díjmentes online bemutatót.';
---

<BaseLayout
  locale={locale}
  page={page}
  title={title}
  description={description}
  ogImage="/assets/og-teljes-rendszer.webp"
  noindex
  lpEnabled
>
  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-primary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Közös fejléc – ?type=ld (lp-mode) esetén minimálra vált (logó + nyelvváltó) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + Jelentkezési űrlap -->
    <section id="hero" class="hero-gradient py-12 md:py-16 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        All-in-one AI marketing rendszer <span class="text-primary">webshopoknak</span>
                    </h1>
                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        Bekötöd a webshopod, és az AI a saját webáruház adataidból írja, tervezi és publikálja a
                        tartalmat.
                    </p>

                    <!-- A négy tartalomtípus kártyákban – a hero-képlet „platform chip" eleme.
                         Az ikonok a `modules.ts` modulikonjaival egyeznek, hogy a lentebbi
                         modulrácsban ugyanaz a jel vezesse a szemet. -->
                    <div class="flex flex-wrap gap-2">
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">auto_awesome</span>
                            Poszt
                        </span>
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">article</span>
                            Blogcikk
                        </span>
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">mail</span>
                            Hírlevél
                        </span>
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">edit_document</span>
                            Termékleírás
                        </span>
                    </div>

                    <!-- Fájdalompont + vágy, nem funkciófelsorolás: a funkciók a chipekben és a
                         lentebbi modulrácsban vannak. A pipa így is működik, mert minden pont a
                         megoldott állapotot mondja ki, nem a problémát. -->
                    <ul class="space-y-2.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Nem áll üresen a Facebook-oldalad és a blogod</strong> – akkor is megy a tartalom, ha épp nincs időd rá</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Nem kell öt appban ugrálnod</strong> – a poszt, a cikk, a hírlevél és a termékleírás egy helyen készül</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Nem nő tovább a marketingköltséged</strong> – egy fix havidíj a külön eszközök és a külsős szövegíró helyett</span>
                        </li>
                    </ul>

                    <!-- Webshop mélyintegráció – a főoldali hero mintájára: a bekötés maga a
                         bizonyíték arra, hogy a modulok ugyanabból az adatból dolgoznak. -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Webshop mélyintegráció:</span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/unas_logo.png" alt="Unas" class="h-[18px] w-auto" />
                        </span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/shoprenter-logo.png" alt="Shoprenter" class="h-[18px] w-auto" />
                        </span>
                    </div>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ hazai webshop</span> már használja</p>
                    </div>


                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h2 class="text-2xl font-bold text-center mb-2 text-primary">Jelentkezés online bemutatóra</h2>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">Közvetlen kipróbálásra
                                    nincs lehetőség</strong> – de egy online megbeszélés keretében bemutatjuk neked a
                                    teljes rendszert, akár a te saját termékeiddel.</p>
                            </div>
                        </div>

                        <!-- A KISZŰRŐ kérdések SZÁNDÉKOSAN azonosak az /hu/online-bemutato/ oldaléval,
                             hogy a két szög lead-minősége összevethető legyen. A modul-kérdés ezen felül
                             van: nincs rajta `data-reject`, tehát a minősítés eredményét nem befolyásolja,
                             csak elmondja az értékesítésnek, mire hegyezze a bemutatót. -->
                        <!-- A többi kampányoldalon `max-h-[500px] overflow-hidden` van a formon, mert ott
                             négy kérdés fér a step 1-be. Itt öt van + a modul-pipák, és a plafon levágta a
                             „Tovább" gombot – ezért NINCS magasságkorlát: a kártya a tartalmához igazodik. -->
                        <form id="leadForm" class="space-y-4 pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Van webshopod / online
                                            áruházad?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Igen, van webshopom">Igen, van webshopom</option>
                                            <option value="Igen, hamarosan tervezek nyitni" data-reject="soft">Igen, hamarosan tervezek
                                                nyitni</option>
                                            <option value="Nem, más típusú vállalkozásom van" data-reject="hard">Nem, más típusú
                                                vállalkozásom van</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Milyen szinten van a céged
                                            a marketingben?</label>
                                        <select name="marketing_level" id="marketingLevel"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Egyáltalán nem értünk semmit a témához" data-reject="hard">Egyáltalán nem értünk
                                                semmit a témához</option>
                                            <option value="Kezdő, minimális tudással">Kezdő, minimális tudással</option>
                                            <option value="Haladó">Haladó</option>
                                            <option value="Profi">Profi</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Ki csinálja jelenleg a
                                            marketinget?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Én, cégvezetőként">Én, cégvezetőként</option>
                                            <option value="Belsős marketing csapat">Belsős marketing csapat</option>
                                            <option value="Külsős ügynökség">Külsős ügynökség</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Ha a bemutató alapján
                                            tetszik, mikor tudnád elkezdeni használni a szoftvert?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Azonnal">Azonnal</option>
                                            <option value="1 hónapon belül">1 hónapon belül</option>
                                            <option value="2-3 hónapon belül" data-reject="soft">2-3 hónapon belül</option>
                                            <option value="Még csak érdeklődöm" data-reject="soft">Még csak érdeklődöm</option>
                                        </select>
                                    </div>
                                    <!-- Modul-érdeklődés: több is választható. A gyűjtő mezőnként EGY
                                         értéket olvas, ezért a pipák egy rejtett `module_interest` mezőbe
                                         fűződnek össze – így a `LeadFormScript` szerződése változatlan.
                                         A rejtett mező üresen marad, amíg nincs pipa, tehát a „válaszolj
                                         minden kérdésre" ellenőrzés magától kötelezővé teszi. -->
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Melyik modul érdekel a
                                            leginkább? <span class="font-normal text-muted">(legfeljebb 3)</span></label>
                                        <div id="moduleInterest"
                                            class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 rounded-[10px] border border-border bg-light p-3 shadow-card">
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Automata posztolás"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Automata posztolás</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Blogcikk író"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Blogcikk író</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <!-- A `value` szándékosan változatlan: az app egy oszlopban szűri, és
                                                     egy átnevezés kettévágná a régi és az új leadeket. -->
                                                <input type="checkbox" value="Termékleírás írás (Shopgrade)"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Termékleírás- és kategóriaoldal-írás</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="AI hírlevél"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>AI hírlevél</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Kép- és videógenerálás"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Kép- és videógenerálás</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Nemzetközi terjeszkedés"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Nemzetközi terjeszkedés</span>
                                            </label>
                                        </div>
                                        <input type="hidden" name="module_interest" id="moduleInterestValue">
                                    </div>

                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Tovább
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h3 class="text-xl font-bold text-dark">Köszönjük az érdeklődésedet!</h3>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        A megadott adatok alapján úgy látjuk, hogy nem lenne a platformunk megfelelő
                                        számodra. Így nem is szeretnénk az idődet húzni, megértésed köszönjük!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen (timing not ideal) -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h3 class="text-xl font-bold text-dark">Köszönjük az érdeklődésedet!</h3>
                                        <p class="text-body leading-relaxed text-sm">
                                            A bemutatót csak olyanoknak tudjuk vállalni, akik azonnal használni szeretnék
                                            a rendszert. Maradjunk kapcsolatban addig is – szívesen elküldenénk egy
                                            <strong>videós bemutatót</strong> neked.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email cím</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="pl. janos@ceg.hu">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            Az <a href="/hu/adatkezeles/" target="_blank"
                                                class="underline hover:text-primary">Adatkezelési Tájékoztatóban</a>
                                            foglaltakat elolvastam, megértettem és tudomásul vettem.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            Érdekelnek hasonló izgalmas tartalmak! Feliratkozom a hírlevélre.
                                            (<a href="/hu/adatkezeles/"
                                                class="underline hover:text-primary">Adatkezelési tájékoztató</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject(this)"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Kérem a videót
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-dark">Megkaptuk!</h3>
                                    <!-- Két változat: az „újdonságok" csak akkor igaz, ha a hírlevelet is kérte.
                                         A videó minden esetben megy – a script választ közülük. -->
                                    <p data-thanks="plain" class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Néhány percen belül elküldjük a bemutató videót. Köszönjük az érdeklődésedet!
                                    </p>
                                    <p data-thanks="newsletter" class="hidden text-body leading-relaxed max-w-[400px] mx-auto">
                                        Néhány percen belül elküldjük a bemutató videót, és ezentúl az aktuális
                                        újdonságokról is hírt adunk. Köszönjük az érdeklődésedet!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Név</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="pl. Kovács János">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Céges email cím</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="pl. janos@ceg.hu">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Telefonszám</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+36 30 123 4567">
                                    </div>

