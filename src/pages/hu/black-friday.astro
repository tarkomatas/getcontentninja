  </dialog>

  <!-- Helytartó: a fix alsó sáv ne takarja el a lábléc alját. -->
  <div class="h-[76px] md:h-[96px]" data-bf-cta aria-hidden="true"></div>

  <!-- Folyamatosan látszó alsó sáv, MINDEN nézetben (user-kérés): nagy visszaszámláló
       + gomb, asztalin az ajánlat és az ár is. Ugyanaz a tick frissíti, mint a záró
       számlálót; lejárat után a helytartóval együtt eltűnik (`data-bf-cta`). -->
  <div
    id="bf-sticky"
    class="fixed inset-x-0 bottom-0 z-40 bg-dark text-white shadow-[0_-8px_24px_rgba(0,0,0,0.18)] px-4 md:px-10 py-3"
    data-bf-cta
    data-bf-countdown
    data-start={START_ISO}
    data-end={END_ISO}
  >
    <div class="max-w-[1200px] mx-auto flex items-center gap-3 md:gap-6">
      <div class="hidden lg:block flex-1 min-w-0">
        <p class="text-xs font-bold uppercase tracking-widest text-white/60">Black Friday</p>
        <p class="font-bold leading-snug">3 hónap ajándék + 500 kredit · 12 hónap 9 havidíj áráért</p>
      </div>
      <div class="flex-1 lg:flex-none min-w-0">
        <p class="hidden md:block text-xs font-semibold text-white/60 mb-1 text-center" data-bf-label>Az akció november 27-én éjfélig tart.</p>
        <div class="hidden flex gap-1.5 md:gap-2 md:justify-center" data-bf-clock>
          {[['d', 'nap'], ['h', 'óra'], ['m', 'perc'], ['s', 'mp']].map(([k, l]) => (
            <div class="w-12 md:w-16 bg-white/10 border border-white/15 rounded-[10px] py-1 md:py-1.5 text-center">
              <span class="block text-xl md:text-3xl font-extrabold tabular-nums leading-tight" data-bf-unit={k}>00</span>
              <span class="block text-[10px] md:text-xs text-white/60 uppercase tracking-wide">{l}</span>
            </div>
          ))}
        </div>
      </div>
      <a href={REGISTER_URL} data-bf-offer class="cta-primary px-4 md:px-6 h-12 md:h-14 text-sm md:text-base justify-center shrink-0">
        <span class="md:hidden">Kérem</span>
        <span class="hidden md:inline">Kérem az ajánlatot</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  </div>

  <script is:inline>
    // Hero H1: a középső kifejezés kitörlődik és újragépelődik, a következővel.
    (function () {
      var root = document.getElementById('bf-rotate');
      if (!root) return;
      var out = root.querySelector('[data-rotate-text]');
      var words = JSON.parse(root.dataset.words || '[]');
      if (words.length < 2) return;
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var caret = document.createElement('span');
      caret.className = 'm-caret m-caret-blink';
      root.appendChild(caret);
      var i = 0, inView = true;
      new IntersectionObserver(function (en) { inView = en[0].isIntersecting; }).observe(root);
      function wait(ms, fn) { setTimeout(fn, ms); }
      function cycle() {
        if (!inView || document.hidden) return wait(1000, cycle);
        caret.className = 'm-caret';
        var txt = out.textContent;
        (function del() {
          txt = txt.slice(0, -1);
          out.textContent = txt;
          if (txt.length) return wait(35, del);
          i = (i + 1) % words.length;
          var w = words[i], k = 0;
          wait(250, function type() {
            out.textContent = w.slice(0, ++k);
            if (k < w.length) return wait(65, type);
            caret.className = 'm-caret m-caret-blink';
            wait(2600, cycle);
          });
        })();
      }
      wait(2600, cycle);
    })();

    // Az egyetlen ajánlat-gomb: választó ablakot nyit (új ügyfél / előfizető).
    (function () {
      var dlg = document.getElementById('bf-choose');
      if (!dlg || typeof dlg.showModal !== 'function') return; // régi böngésző: marad a sima link
      document.querySelectorAll('[data-bf-offer]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          dlg.showModal();
        });
      });
      dlg.querySelector('[data-bf-close]').addEventListener('click', function () { dlg.close(); });
      dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); }); // háttérre kattintás
    })();

    // Kalkulátor: 12 hónap = 9 × a választott havidíj.
    (function () {
      var root = document.getElementById('bf-calc');
      var sel = document.getElementById('bf-fee');
      if (!root || !sel) return;
      var gift = (Number(root.dataset.creditGift) || 0) + (Number(root.dataset.consult) || 0);
      var fmt = function (n) { return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
      function set(k, v) {
        root.querySelectorAll('[data-calc="' + k + '"]').forEach(function (el) { el.textContent = fmt(v); });
      }
      function calc() {
        var m = Number(sel.value) || 0;
        set('fee', m);
        set('year', 12 * m);
        set('bf', 9 * m);
        set('avg', Math.round((9 * m) / 12 / 100) * 100);
        set('save', 3 * m);
        set('total', 3 * m + gift);
        set('gross', 9 * m * 1.27);
      }
      sel.addEventListener('change', calc);
      calc();
    })();

    function toggleFaq(btn) {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }

    // Visszaszámláló: az akció indulásáig, majd a lejáratig. Lejárat után a
    // gombok helyén egy „lejárt" sor áll. JS nélkül a lejárati dátum látszik.
    (function () {
      var boxes = document.querySelectorAll('[data-bf-countdown]');
      if (!boxes.length) return;
      var pad = function (n) { return String(n).padStart(2, '0'); };
      function tick() {
        var now = Date.now();
        boxes.forEach(function (box) {
          var start = Date.parse(box.dataset.start);
          var end = Date.parse(box.dataset.end);
          var label = box.querySelector('[data-bf-label]');
          var clock = box.querySelector('[data-bf-clock]');
          var target;
          if (now < start) {
            target = start;
            label.textContent = 'Indulásig:';
          } else if (now <= end) {
            target = end;
            label.textContent = 'Az akció végéig:';
          } else {
            label.textContent = 'A Black Friday-akció lejárt. Köszönjük, hogy velünk voltál!';
            clock.classList.add('hidden');
            return;
          }
          var diff = Math.max(0, Math.floor((target - now) / 1000));
          var u = {
            d: Math.floor(diff / 86400),
            h: Math.floor((diff % 86400) / 3600),
            m: Math.floor((diff % 3600) / 60),
            s: diff % 60,
          };
          Object.keys(u).forEach(function (k) {
            var el = box.querySelector('[data-bf-unit="' + k + '"]');
            if (el) el.textContent = pad(u[k]);
          });
          clock.classList.remove('hidden');
        });
        if (now > Date.parse(boxes[0].dataset.end)) {
          document.querySelectorAll('[data-bf-cta]').forEach(function (el) { el.classList.add('hidden'); });
          clearInterval(timer);
        }
      }
      var timer = setInterval(tick, 1000);
      tick();
    })();

  </script>
</BaseLayout>
