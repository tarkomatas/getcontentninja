---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import PlatformLogos from '../../components/PlatformLogos.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';

const locale = 'hu';
const page = 'blackFriday';

const title = 'Black Friday: 3 hónap ajándék + 500 kredit – Content Ninja';
const description =
  'Black Friday 2026 (november 16–27.): Content Ninja éves előfizetés 9 havidíj áráért, 359.910 Ft + ÁFA / év. Mellé 500 ajándék kredit, ár-garancia a következő évre, 20.000 Ft értékű személyes konzultáció és 20.000 Ft értékű fiók audit. Új és meglévő havi ügyfeleknek is.';

// ── Az akció időkerete (Europe/Budapest, novemberben CET = +01:00) ──
// A visszaszámláló és a lejárat utáni állapot is ebből dolgozik.
const START_ISO = '2026-11-16T00:00:00+01:00';
const END_ISO = '2026-11-27T23:59:59+01:00';

// ── A hero H1 váltakozó kifejezései („Éves előfizetéshez exkluzív ___ kedvezmény") ──
// Mind listaáron igaz. Rövidek maradjanak: mobilon is egy sorba kell férniük.
const HERO_ROTATE = ['3 hónapos', '25%-os', '+500 kredites', '174.960 Ft értékű'];

// ── CTA: EGY link minden „Kérem az ajánlatot" gombon (az app brief-je, 2026-11-14) ──
// Az app saját oldala dönti el, ki érkezik (új ügyfél, havi előfizető, lemondott ügyfél),
// ő adja hozzá a kupont és az éves csomagot, és ő kezeli az időzítést is: nov. 16. előtt
// „hamarosan indul", nov. 27. éjfél után „lejárt" oldalt mutat. Ezért a link végére
// SEMMI nem kerül, és ugyanabban a lapon nyílik (nincs target="_blank").
const OFFER_URL = 'https://app.getcontentninja.com/black-friday';

// ── Kalkulátor: választható havidíjak (nettó Ft) ──
// A meglévő ügyfelek eltérő havidíjon lehetnek (régi listaár, partner-ár). A
// kalkulátor mindenkinek a SAJÁT havidíjából számol: 12 hónap = 9 × havidíj.
// Az első elem az alapértelmezett (mai listaár). Egyedi árakat ide csak akkor
// tegyél, ha nyilvánosan is vállalható — a lista mindenkinek látszik.
// TODO: a 24.990 Ft-os sor az app példája (annual-plan.md) — megerősítendő.
const FEE_OPTIONS = [
  { value: 39990, label: '39.990 Ft / hó – mai listaár, új ügyfél' },
  { value: 34990, label: '34.990 Ft / hó – korábbi listaár' },
  { value: 24990, label: '24.990 Ft / hó' },
];
const AUDIT_HUF = 20000; // fiók audit: elemzés + javaslatok e-mailben (user-döntés)
const CONSULT_HUF = 20000; // a személyes konzultáció értéke (user-döntés): beüzemelő (új) vagy hatékonyságnövelő (meglévő)
const CREDIT_GIFT_HUF = 14990; // 500 kredit = az 500 kredites extra csomag ára

// A korlátozó feltételek egy sorban, minden fő gomb alatt (hero, záró CTA).
const TERMS_LINE =
  'Az éves díj előre fizetendő, és nem téríthető vissza. Az ajándék kredit 1 évig érvényes. Az akció november 27-én éjfélig tart.';

// ── Árak (nettó) ──
// Normál árak forrása: /hu/arak/ (PricingCards). Ha ott változik, itt is.
// 359.910 = 9 × 39.990; bruttó 359.910 × 1,27 = 457.086 Ft.
const offerCards = [
  {
    icon: 'redeem',
    title: '3 hónap ajándék',
    body: '12 hónapot kapsz 9 havidíj áráért. Listaáron ez 119.970 Ft megtakarítás egy évre.',
  },
  {
    icon: 'bolt',
    title: '+500 kredit ajándék',
    body: '14.990 Ft értékű extra kredit. Így 6.500 kredited lesz 6.000 helyett, 1 évig érvényes.',
  },
  {
    icon: 'verified_user',
    title: 'Ár-garancia',
    body: 'Jövőre is ugyanezzel a kedvezménnyel újíthatod meg. Akkor sem fizetsz többet, ha nő a listaár.',
  },
  {
    icon: 'support_agent',
    title: 'Személyes konzultáció',
    body: '20.000 Ft értékben. Beüzemelő, ha új vagy, és hatékonyságnövelő, ha már használod a Ninját.',
  },
  {
    icon: 'fact_check',
    title: 'Fiók audit',
    body: '20.000 Ft értékben. Kielemezzük a fiókodat, és e-mailben elküldjük a fejlesztési javaslatainkat.',
  },
  {
    icon: 'savings',
    title: 'A kredit nem vész el havonta',
    body: 'Havi előfizetésnél a maradék kredit nullázódik. Az éves csomagban mind 1 évig megmarad.',
  },
];




const testimonials = [
  {
    quote: '20-30 tartalmat legenerálok 1 óra alatt – ez korábban ennek a sokszorosa volt. Az is nagy előny, hogy egyetlen átlátható felületen belül látom az összes posztomat.',
    name: 'Dr. Madarász Tamás',
    shop: 'DoktorDivat',
    initials: 'MT',
  },
  {
    quote: 'Kevés időm jut marketingre, de ezzel mégis tudok rendszeresen posztolni. Tömegesen generál tartalmakat, témákat is javasol magától, a videós funkciói pedig egyre jobbak. Komoly időmegtakarítás.',
    name: 'Luca Márió',
    shop: 'PanDani.hu Játékbolt és webshop',
    initials: 'L',
  },
  {
    quote: 'Rengeteg időt spórol azzal, hogy terméklink alapján magától generál szöveget, képet és automatikusan posztol is. Nagy segítség!',
    name: 'Szabad Mária',
    shop: 'Károlyi-plast webáruház',
    initials: 'Sz',
  },
];

const faqs = [
  {
    q: 'Meddig tart az akció?',
    a: '2026. november 16-tól november 27-én éjfélig. Az akciós árat az kapja, aki eddig az időpontig előfizet. Utána az éves csomag a normál, 399.900 Ft + ÁFA áron érhető el.',
  },
  {
    q: 'Kedvezményes havidíjon vagyok. Nekem mennyibe kerül?',
    a: 'Neked is 12 hónap 9 havidíj áráért, a saját havidíjadból számolva. A kedvezményed tehát nem vész el, és erre jön rá a 3 hónap ajándék. Az oldal tetején lévő kalkulátorban kiválaszthatod a mostani havidíjad, és látod a pontos árat.',
  },
  {
    q: 'Korábban lemondtam az előfizetésem. Nekem is jár?',
    a: 'Igen, neked is jár mind az öt ajándék. Nálad a mai listaárból számolunk: 12 hónap 9 × 39.990 Ft-ért, vagyis 359.910 Ft + ÁFA-ért. A korábbi kedvezményes havidíjad nem él vissza.',
  },
  {
    q: 'Már havi előfizető vagyok. Nekem is jár?',
    a: 'Igen. Ha az akció ideje alatt éves csomagra váltasz, ugyanazt kapod, mint egy új ügyfél: az akciós árat, az 500 ajándék kreditet, az ár-garanciát, a személyes konzultációt (nálad a hatékonyságnövelőt) és a fiók auditot. Ugyanazzal a „Kérem az ajánlatot" gombbal lépsz be, és ott válthatsz évesre. Az ajánlatot az appban is megtalálod: belépés után a felső csíkon vagy az Előfizetés oldalon.',
  },
  {
    q: 'Mit jelent az ár-garancia?',
    a: 'Aki most előfizet, a következő évben is ugyanezzel a kedvezménnyel újíthatja meg az éves csomagot. Akkor sem kell többet fizetned, ha addig a normál ár változik.',
  },
  {
    q: 'Milyen konzultációt kapok, és hogyan zajlik?',
    a: 'Egy személyes, közös alkalmat, 20.000 Ft + ÁFA értékben, ajándékba. A vásárlás után felvesszük veled a kapcsolatot, és egyeztetünk egy időpontot. Ha új ügyfél vagy, beüzemelő konzultációt kapsz: bekötjük a webshopodat, beállítjuk a márkádat, és elkészítjük az első tartalmakat. Ha már használod a Ninját, hatékonyságnövelő konzultációt kapsz: átnézzük a beállításaidat, és megmutatjuk, hogyan hozhatsz ki belőle többet.',
  },
  {
    q: 'Mi az a fiók audit?',
    a: 'Egy 20.000 Ft + ÁFA értékű elemzés, amit ajándékba kapsz. Átnézzük a fiókodat és a beállításaidat, és e-mailben elküldjük a fejlesztési javaslatainkat: mit érdemes másképp csinálnod, hogy többet hozz ki a Ninjából.',
  },
  {
    q: 'Meddig használhatom fel az 500 ajándék kreditet?',
    a: 'A vásárlástól számított 1 évig. A csomag 6.000 kreditjével együtt, egy összegben kapod meg, így összesen 6.500 kredited lesz.',
  },
  {
    q: 'Mire elég 6.500 kredit?',
    a: 'Egy képes poszt 3 kredit, egy képes blogcikk kb. 7, egy hírlevél kb. 5, egy 30 mp-es narrátorvideó kb. 17. A kreditet nem kell havonta beosztanod: az év során akkor használod, amikor kell. A részletes kreditdíjakat az Árak oldalon találod.',
  },
  {
    q: 'Lemondhatom év közben?',
    a: 'Lemondani bármikor lehet, de a lemondás a kifizetett 12 hónap végén lép életbe. Az éves díjat egy összegben, előre fizeted, és az ÁSZF szerint nem téríthető vissza, az időarányos része sem. Addig viszont minden funkciót korlátlanul használhatsz.',
  },
  {
    q: 'Hogyan fizetek?',
    a: 'Bankkártyával, a Stripe felületén, egy összegben. A számlát a regisztrációkor megadott adataidra állítjuk ki.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  locale={locale}
  page={page}
  title={title}
  description={description}
  noindex
  lpEnabled
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

  <Header locale={locale} page={page} />

  <main>
    <!-- ═══════════════════════════════════════
     HERO
═══════════════════════════════════════ -->
    <section id="hero" class="hero-gradient py-12 md:py-16">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10">
        <!-- Két hasáb (user-kérés): bal = az ajánlat, jobb = a matek. Mobilon egymás alatt. -->
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-10 lg:gap-14 items-center">
          <!-- BAL: ajánlat -->
          <div class="flex flex-col gap-5 text-center lg:text-left">
            <!-- H1 (user-kérés): „Éves előfizetéshez exkluzív ___ kedvezmény", a középső sor
                 váltakozik (HERO_ROTATE). A váltakozó sor SAJÁT sorban áll, fix magassággal és
                 nowrap-pel, így a hosszabb/rövidebb kifejezés nem tördeli újra a címet (CLS = 0).
                 A kiemelésben belső span van, ezért a MotionScript közös gépelő kurzora
                 kihagyja – a forgatást a lenti saját script végzi. JS nélkül az első kifejezés áll. -->
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-[-0.03em] leading-tight">
              Éves előfizetéshez exkluzív
              <span class="block min-h-[1.25em] text-primary whitespace-nowrap" id="bf-rotate" data-words={JSON.stringify(HERO_ROTATE)}>
                <span class="sr-only">{HERO_ROTATE[0]}</span><span aria-hidden="true" data-rotate-text>{HERO_ROTATE[0]}</span>
              </span>
              kedvezmény
            </h1>
            <!-- Alcím = az akció neve és ideje (user-kérés). -->
            <p class="inline-flex items-center justify-center lg:justify-start gap-2 text-primary font-bold text-sm uppercase tracking-widest">
              <span class="material-symbols-outlined text-[18px]">sell</span>
              Black Friday · november 16–27.
            </p>

            <!-- A 3 legfontosabb előny (user-kérés), pipás listaként: a mozgásréteg sorban hozza be. -->
            <ul class="flex flex-col gap-2.5 text-left self-center lg:self-start">
              {[
                ['12 hónap 9 havidíj áráért,', 'jövőre is ezen az áron.'],
                ['+500 kredit ajándékba,', 'és 1 évig megmarad.'],
                ['Személyes konzultáció és fiók audit', 'ajándékba.'],
              ].map(([strong, rest]) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-success text-[22px] shrink-0">check_circle</span>
                  <span class="text-body leading-snug"><strong class="text-dark">{strong}</strong> {rest}</span>
                </li>
              ))}
            </ul>

            <!-- Lejárat után ez látszik a gomb helyén (a számláló-script kapcsolja be). -->
            <p class="hidden font-bold text-dark text-lg" data-bf-expired>A Black Friday-akció november 27-én éjfélkor véget ért.</p>

            <!-- EGY gomb mindenkinek: az app /black-friday oldala dönti el, ki érkezik. -->
            <div class="flex flex-col items-center lg:items-start gap-3 mt-2" data-bf-cta>
              <!-- Kis számláló a gomb fölött (4. ötlet). JS nélkül rejtve marad. -->
              <span class="hidden items-center gap-2 bg-primary/10 text-primary font-bold text-sm rounded-full px-3 py-1.5 tabular-nums" data-bf-pill>
                <span class="bf-dot w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
                <span data-bf-pill-text></span>
              </span>
              <a href={OFFER_URL} class="cta-primary px-8 h-14 text-base w-full sm:w-auto justify-center">
                Kérem az ajánlatot
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
              <!-- A korlátozó feltételek a gomb mellett, nem csak a GYIK-ben (GVH-gyakorlat). -->
              <p class="text-xs text-muted max-w-[480px]">{TERMS_LINE}</p>
            </div>
          </div>

          <!-- JOBB: kalkulátor, a HAVIDÍJHOZ mérve. Mindenki a SAJÁT havidíját választja ki
               (eltérő csomagok), így senki nem lát magának idegen árat. A 12 × havidíj nem
               „korábbi ár", ezért áll mellette a címke. A kredit forintértéke az extra
               kreditcsomag ára. JS nélkül a listaáras példa látszik (SSR alapértékek).
               A visszaszámláló nem itt van: a folyamatosan látszó alsó sáv viszi (#bf-sticky). -->
          <div class="bg-card rounded-[16px] border border-border p-6 sm:p-8 shadow-card-hover" id="bf-calc" data-credit-gift={CREDIT_GIFT_HUF} data-consult={CONSULT_HUF} data-audit={AUDIT_HUF}>
            <label for="bf-fee" class="text-primary font-bold text-sm uppercase tracking-widest block mb-4">Számold ki a saját árad</label>
            <select id="bf-fee" aria-label="A mostani havidíjad" class="w-full h-12 rounded-[10px] border-border bg-light text-dark font-semibold text-sm md:text-base focus:border-primary focus:ring-primary mb-5">
              {FEE_OPTIONS.map((o, i) => <option value={o.value} selected={i === 0}>{o.label}</option>)}
            </select>

            <dl class="space-y-3 text-sm md:text-base">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-body">Havidíjjal 12 hónap</dt>
                <dd class="text-muted font-bold line-through decoration-2 whitespace-nowrap"><span data-calc="year">479.880</span> Ft</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-dark font-semibold">Black Friday éves <span class="hidden sm:inline text-muted font-normal">(9 havidíj)</span></dt>
                <dd class="text-dark text-3xl md:text-4xl font-extrabold tracking-[-0.02em] whitespace-nowrap"><span data-calc="bf">359.910</span> Ft</dd>
              </div>

              <div class="border-t border-border pt-3 flex items-baseline justify-between gap-4">
                <dt class="text-body">Megtakarítás <span class="text-muted">(3 hónap)</span></dt>
                <dd class="text-success font-bold whitespace-nowrap">+<span data-calc="save">119.970</span> Ft</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-body">+500 ajándék kredit</dt>
                <dd class="text-success font-bold whitespace-nowrap">+14.990 Ft</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-body">Személyes konzultáció</dt>
                <dd class="text-success font-bold whitespace-nowrap">+20.000 Ft</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-body">Fiók audit</dt>
                <dd class="text-success font-bold whitespace-nowrap">+20.000 Ft</dd>
              </div>

              <div class="bg-success/10 border border-success/30 rounded-[12px] px-4 py-3.5 flex items-center justify-between gap-4">
                <dt class="text-dark font-bold">Összes előnyöd</dt>
                <dd class="text-success text-2xl md:text-3xl font-extrabold whitespace-nowrap"><span data-calc="total">174.960</span> Ft</dd>
              </div>
            </dl>

            <p class="text-muted text-xs md:text-sm mt-4">
              Nettó árak, + ÁFA. Bruttó <span data-calc="gross">457.086</span> Ft / év, kb. <span data-calc="avg">30.000</span> Ft / hó.
            </p>
          </div>
        </div>
      </div>
    </section>

    <TrustBadges locale={locale} />

    <!-- ═══════════════════════════════════════
     MIT KAPSZ
═══════════════════════════════════════ -->
    <section id="mit-kapsz" class="bg-light py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10">
        <div class="text-center max-w-[700px] mx-auto mb-14">
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Mit kapsz?</span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Ezeket mind megkapod az éves csomagban</h2>
          <p class="text-body text-lg">Új ügyfélként és havi előfizetőként is, ha most évesre váltasz.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {offerCards.map((c) => (
            <div class="bg-card rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all">
              <div class="w-12 h-12 rounded-[12px] bg-primary/10 flex items-center justify-center mb-5">
                <span class="material-symbols-outlined text-primary text-[22px]">{c.icon}</span>
              </div>
              <h3 class="text-xl font-bold text-dark mb-2">{c.title}</h3>
              <p class="text-body text-sm leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════
     A TELJES RENDSZER (user-kérés: általános bemutató sok kártyával, a „Mit kapsz?" után)
     A modulrács a `modules.ts`-ből jön (mind a 10 modul). `noLinks`: a kampányoldalról
     ne vigyen el a látogató, csak megmutassa, mennyi mindent tud a rendszer.
═══════════════════════════════════════ -->
    <ModuleGrid
      locale={locale}
      eyebrow="Mit tud a Content Ninja?"
      heading="Ez mind benne van az éves csomagban"
      lead="Nem modulonként fizetsz: minden funkció ugyanannak az előfizetésnek a része, a kreditedet szabadon osztod el közöttük."
      sectionId="funkciok"
      sectionClass="bg-card py-20 md:py-28"
      cardClass="bg-light"
      compact
      noLinks
    />
    <div class="bg-card px-4 md:px-10 pb-20 md:pb-28 -mt-6">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="text-sm font-semibold text-muted mr-1">Támogatott rendszerek:</span>
        <PlatformLogos variant="pill" />
      </div>
    </div>

    <!-- ═══════════════════════════════════════
     VÉLEMÉNYEK
═══════════════════════════════════════ -->
    <section id="velemenyek" class="bg-light py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10">
        <div class="text-center max-w-[700px] mx-auto mb-14">
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Vélemények</span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Webshopok, akik már a Ninjával dolgoznak</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {testimonials.map((t) => (
            <div class="flex flex-col bg-card p-5 sm:p-8 rounded-[16px] border border-border shadow-card">
              <div class="flex gap-0.5 mb-4">
                <span class="text-yellow-400">★</span><span class="text-yellow-400">★</span><span class="text-yellow-400">★</span><span class="text-yellow-400">★</span><span class="text-yellow-400">★</span>
              </div>
              <p class="text-body italic mb-6 leading-relaxed flex-1">„{t.quote}"</p>
              <div class="flex items-center gap-3 mt-auto">
                <div class="w-11 h-11 rounded-full bg-primary flex items-center justify-center text-white font-bold text-sm uppercase">{t.initials}</div>
                <div>
                  <p class="font-bold text-dark text-sm">{t.name}</p>
                  <p class="text-xs text-muted">{t.shop}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
     GYIK
═══════════════════════════════════════ -->
    <section id="faq" class="bg-card py-20 md:py-28">
      <div class="max-w-[800px] mx-auto px-4 md:px-10">
        <div class="text-center mb-14">
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">GYIK</span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Kérdések az akcióról</h2>
        </div>

        <div class="space-y-3" id="faq-list">
          {faqs.map((f) => (
            <div class="faq-item bg-light rounded-[12px] border border-border overflow-hidden">
              <button
                class="w-full flex items-center justify-between p-4 sm:p-5 text-left font-semibold text-dark text-base gap-4"
                onclick="toggleFaq(this)"
              >
                {f.q}
                <span class="material-symbols-outlined faq-icon text-primary shrink-0 text-[20px]">add</span>
              </button>
              <div class="faq-answer px-5 pb-5 text-body text-sm leading-relaxed">{f.a}</div>
            </div>
          ))}
        </div>

        <p class="text-muted text-sm text-center mt-8">
          A teljes szerződéses feltételek az
          <a href="/hu/aszf/" class="text-primary font-semibold underline">ÁSZF-ben</a> olvashatók.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
     ZÁRÓ CTA
═══════════════════════════════════════ -->
    <section id="zaro-cta" class="bg-primary py-16 md:py-20">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">3 hónap ajándék + 500 kredit, november 27. éjfélig</h2>
        <p class="text-white/80 text-lg mb-8 max-w-[640px] mx-auto">
          12 hónap 9 havidíj áráért, ár-garanciával, személyes konzultációval és fiók audittal.
        </p>

        <div class="flex flex-col items-center gap-3" data-bf-cta>
          <a href={OFFER_URL} class="cta-on-primary px-8 h-14 text-base inline-flex w-full sm:w-auto justify-center">
            Kérem az ajánlatot
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
          <p class="text-xs text-white/60 max-w-[520px]">{TERMS_LINE}</p>
          <!-- A habozóknak: halk link, nem versenyez a fő gombbal. -->
          <p class="text-sm text-white/70">
            Kérdésed van? <a href="/hu/kapcsolat/" class="text-white font-semibold underline">Írj nekünk</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} page={page} />

  <!-- Helytartó: a fix alsó sáv ne takarja el a lábléc alját. -->
  <div class="h-[76px] md:h-[96px]" data-bf-cta aria-hidden="true"></div>

  <!-- Folyamatosan látszó alsó sáv, MINDEN nézetben (user-kérés): nagy visszaszámláló
       + gomb, asztalin az ajánlat és az ár is. Ugyanaz a tick frissíti, mint a záró
       számlálót; lejárat után a helytartóval együtt eltűnik (`data-bf-cta`). -->
  <div
    id="bf-sticky"
    class="bf-bar fixed inset-x-0 bottom-0 z-40 bg-dark text-white shadow-[0_-8px_24px_rgba(0,0,0,0.18)] px-4 md:px-10 py-3 transition-colors duration-500"
    data-bf-cta
    data-bf-countdown
    data-start={START_ISO}
    data-end={END_ISO}
  >
    <div class="max-w-[1200px] mx-auto flex items-center gap-3 md:gap-6">
      <div class="hidden lg:block flex-1 min-w-0">
        <p class="text-xs font-bold uppercase tracking-widest text-white/60">Black Friday</p>
        <p class="font-bold leading-snug">3 hónap ajándék + 500 kredit · 12 hónap 9 havidíj áráért</p>
      </div>
      <div class="flex-1 lg:flex-none min-w-0">
        <p class="hidden md:block text-xs font-semibold text-white/60 mb-1 text-center" data-bf-label>Az akció november 27-én éjfélig tart.</p>
        <div class="hidden flex gap-1.5 md:gap-2 md:justify-center" data-bf-clock>
          {[['d', 'nap'], ['h', 'óra'], ['m', 'perc'], ['s', 'mp']].map(([k, l]) => (
            <div class:list={['w-12 md:w-16 bg-white/10 border border-white/15 rounded-[10px] py-1 md:py-1.5 text-center', k === 's' && 'bf-sec']}>
              <span class="bf-digits block text-xl md:text-3xl font-extrabold tabular-nums leading-tight" data-bf-unit={k}><span>00</span></span>
              <span class="block text-[10px] md:text-xs text-white/60 uppercase tracking-wide">{l}</span>
            </div>
          ))}
        </div>
      </div>
      <a href={OFFER_URL} data-bf-bar-btn class="cta-primary px-4 md:px-6 h-12 md:h-14 text-sm md:text-base justify-center shrink-0">
        <span class="md:hidden">Kérem</span>
        <span class="hidden md:inline">Kérem az ajánlatot</span>
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>
  </div>

  <style is:global>
    .bf-digits { position: relative; height: 1.25em; overflow: hidden; }
    .bf-digits > span { position: absolute; inset: 0; transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .35s; }
    .bf-digits > span.bf-enter { transform: translateY(100%); opacity: 0; }
    .bf-digits > span.bf-leave { transform: translateY(-100%); opacity: 0; }
    .bf-s24 .bf-sec { animation: bf-pulse 1s ease-in-out infinite; }
    @keyframes bf-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
    .bf-dot { animation: bf-blink 1s step-end infinite; }
    @keyframes bf-blink { 50% { opacity: .25; } }
    @media (prefers-reduced-motion: reduce) {
      .bf-digits > span { transition: none; }
      .bf-s24 .bf-sec, .bf-dot { animation: none; }
    }
  </style>

  <script is:inline>
    // Hero H1: a középső kifejezés kitörlődik és újragépelődik, a következővel.
    (function () {
      var root = document.getElementById('bf-rotate');
      if (!root) return;
      var out = root.querySelector('[data-rotate-text]');
      var words = JSON.parse(root.dataset.words || '[]');
      if (words.length < 2) return;
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var caret = document.createElement('span');
      caret.className = 'm-caret m-caret-blink';
      root.appendChild(caret);
      var i = 0, inView = true;
      new IntersectionObserver(function (en) { inView = en[0].isIntersecting; }).observe(root);
      function wait(ms, fn) { setTimeout(fn, ms); }
      function cycle() {
        if (!inView || document.hidden) return wait(1000, cycle);
        caret.className = 'm-caret';
        var txt = out.textContent;
        (function del() {
          txt = txt.slice(0, -1);
          out.textContent = txt;
          if (txt.length) return wait(35, del);
          i = (i + 1) % words.length;
          var w = words[i], k = 0;
          wait(250, function type() {
            out.textContent = w.slice(0, ++k);
            if (k < w.length) return wait(65, type);
            caret.className = 'm-caret m-caret-blink';
            wait(2600, cycle);
          });
        })();
      }
      wait(2600, cycle);
    })();

    // Kalkulátor: 12 hónap = 9 × a választott havidíj.
    (function () {
      var root = document.getElementById('bf-calc');
      var sel = document.getElementById('bf-fee');
      if (!root || !sel) return;
      var gift = (Number(root.dataset.creditGift) || 0) + (Number(root.dataset.consult) || 0) + (Number(root.dataset.audit) || 0);
      var fmt = function (n) { return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
      function set(k, v) {
        root.querySelectorAll('[data-calc="' + k + '"]').forEach(function (el) { el.textContent = fmt(v); });
      }
      function calc() {
        var m = Number(sel.value) || 0;
        set('fee', m);
        set('year', 12 * m);
        set('bf', 9 * m);
        set('avg', Math.round((9 * m) / 12 / 100) * 100);
        set('save', 3 * m);
        set('total', 3 * m + gift);
        set('gross', 9 * m * 1.27);
      }
      sel.addEventListener('change', calc);
      calc();
    })();

    function toggleFaq(btn) {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }

    // Visszaszámláló (alsó sáv + hero-jelvény). A user által választott 4 ötlet:
    // (1) fokozatok: az utolsó 48 órában lila sáv + jelvény, az utolsó napon lüktető mp;
    // (2) pörgő számjegyek; (3) emberi felirat; (4) kis számláló a hero gombja fölött.
    // JS nélkül a lejárati dátum látszik. Lejárat után a gombok és a sáv eltűnnek.
    (function () {
      var bar = document.getElementById('bf-sticky');
      if (!bar) return;
      var START = Date.parse(bar.dataset.start), END = Date.parse(bar.dataset.end);
      var DAY = 86400000, HOUR = 3600000;
      var label = bar.querySelector('[data-bf-label]');
      var clock = bar.querySelector('[data-bf-clock]');
      var btn = bar.querySelector('[data-bf-bar-btn]');
      var pill = document.querySelector('[data-bf-pill]');
      var pillText = document.querySelector('[data-bf-pill-text]');
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var pad = function (n) { return String(n).padStart(2, '0'); };
      var first = true; // az első kirajzolás nem animál (ne pörögjön be a 00-ról)

      function setDigit(slot, val) {
        var cur = slot.lastElementChild;
        if (cur && cur.textContent === val) return;
        if (reduce || !cur || first) { slot.innerHTML = '<span>' + val + '</span>'; return; }
        var nx = document.createElement('span');
        nx.textContent = val;
        nx.className = 'bf-enter';
        slot.appendChild(nx);
        requestAnimationFrame(function () { requestAnimationFrame(function () {
          cur.classList.add('bf-leave');
          nx.classList.remove('bf-enter');
        }); });
        setTimeout(function () { if (cur.parentNode) cur.remove(); }, 400);
      }

      function flag(t) {
        return '<span class="inline-block bg-white text-primary font-extrabold rounded-full px-3 py-0.5">' + t + '</span>';
      }

      function tick() {
        var now = Date.now();
        if (now > END) {
          document.querySelectorAll('[data-bf-cta]').forEach(function (el) { el.classList.add('hidden'); });
          document.querySelectorAll('[data-bf-expired]').forEach(function (el) { el.classList.remove('hidden'); });
          clearInterval(timer);
          return;
        }
        var pre = now < START;
        var left = (pre ? START : END) - now;
        var stage = pre ? 'pre' : left <= DAY ? 's24' : left <= 2 * DAY ? 's48' : 'normal';

        // (1) fokozatok
        var hot = stage === 's48' || stage === 's24';
        bar.classList.toggle('bg-dark', !hot);
        bar.classList.toggle('bg-primary', hot);
        bar.classList.toggle('bf-s24', stage === 's24');
        btn.classList.toggle('cta-primary', !hot);
        btn.classList.toggle('cta-on-primary', hot);

        // (3) emberi felirat
        if (stage === 'pre') label.textContent = 'Indul november 16-án. Indulásig:';
        else if (stage === 'normal') label.textContent = 'Már csak ' + Math.floor(left / DAY) + ' nap van hátra!';
        else if (stage === 's48') label.innerHTML = flag('Már csak 2 nap!');
        else label.innerHTML = flag(left <= HOUR ? 'Utolsó óra! Éjfélkor lejár' : 'Utolsó nap! Éjfélkor lejár');

        // (2) pörgő számjegyek
        var sec = Math.floor(left / 1000);
        var u = { d: Math.floor(sec / 86400), h: Math.floor((sec % 86400) / 3600), m: Math.floor((sec % 3600) / 60), s: sec % 60 };
        Object.keys(u).forEach(function (k) {
          var slot = clock.querySelector('[data-bf-unit="' + k + '"]');
          if (slot) setDigit(slot, pad(u[k]));
        });
        clock.classList.remove('hidden');

        // (4) hero-jelvény
        if (pill) {
          pillText.textContent = (pre ? 'Indulásig: ' : 'Még ') + (u.d ? u.d + ' nap ' : '') + pad(u.h) + ':' + pad(u.m) + ':' + pad(u.s);
          pill.classList.remove('hidden');
          pill.classList.add('inline-flex');
        }
        first = false;
      }
      var timer = setInterval(tick, 1000);
      tick();
    })();

  </script>
</BaseLayout>
