    </section>
  </main>

  <Footer locale={locale} page={page} />

  <!-- Választó ablak az egyetlen „Kérem az ajánlatot" gomb mögött. -->
  <dialog
    id="bf-choose"
    class="w-[calc(100%-2rem)] max-w-[480px] rounded-[16px] border border-border bg-card p-0 shadow-card-hover backdrop:bg-dark/60"
    aria-labelledby="bf-choose-title"
  >
    <div class="p-5 sm:p-8">
      <div class="flex items-start justify-between gap-4 mb-5">
        <h2 id="bf-choose-title" class="text-xl font-bold text-dark">Hogyan folytatod?</h2>
        <button type="button" class="text-muted hover:text-dark" data-bf-close aria-label="Bezárás">
          <span class="material-symbols-outlined text-[22px]">close</span>
