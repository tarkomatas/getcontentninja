          <span class="w-11 h-11 rounded-[10px] bg-primary/10 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-primary text-[22px]">add_circle</span>
          </span>
          <span class="flex-1">
            <span class="block font-bold text-dark">Még nem vagyok előfizető</span>
            <span class="block text-sm text-body">Regisztrálsz, az éves csomag már ki lesz választva.</span>
          </span>
          <span class="material-symbols-outlined text-primary text-[20px]">arrow_forward</span>
        </a>
        <a href={SWITCH_URL} class="group flex items-center gap-4 rounded-[12px] border border-border bg-light p-4 hover:border-primary transition-colors">
          <span class="w-11 h-11 rounded-[10px] bg-primary/10 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-primary text-[22px]">login</span>
          </span>
          <span class="flex-1">
            <span class="block font-bold text-dark">Már előfizető vagyok</span>
            <span class="block text-sm text-body">Belépsz, és évesre váltasz. A kedvezményed megmarad: te is 3 hónapot kapsz ajándékba, a saját havidíjadból számolva.</span>
          </span>
          <span class="material-symbols-outlined text-primary text-[20px]">arrow_forward</span>
