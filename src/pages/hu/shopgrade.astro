---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HowItWorksSteps from '../../components/HowItWorksSteps.astro';
import HowItWorksVideo from '../../components/HowItWorksVideo.astro';
import { videos, hasVideo } from '../../data/videos';
import Header from '../../components/Header.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import PlatformLogos from '../../components/PlatformLogos.astro';

const locale = 'hu';
const page = 'shopgrade';
const title = 'Shopgrade – AI tartalomoptimalizálás Unas, Shoprenter és WooCommerce webshopoknak | Content Ninja';
const description =
  'A Shopgrade letölti a webáruházad meglévő termékleírásait és kategóriaoldalait, az AI SEO- és értékesítés-fókuszú szöveggé írja át őket, majd vissza is tölti a webshopodba – akár több ezer terméket egyszerre, az új termékekre pedig magától is. Unas, Shoprenter és WooCommerce integrációval.';
---

<BaseLayout locale={locale} page={page} title={title} description={description} ogImage="/assets/og-shopgrade.jpg" lpEnabled>
  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: transparent;
            border: 1.5px solid #6c5ce7;
            color: #6c5ce7;
            padding: 14px 28px;
            border-radius: 10px;
            transition: background 0.2s ease;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-secondary:hover {
            background-color: rgba(108, 92, 231, 0.08);
        }

        .cta-primary .material-symbols-outlined,
        .cta-secondary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Közös fejléc – ?type=ld (lp-mode) esetén minimálra vált (logó + nyelvváltó) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + Jelentkezési űrlap -->
    <section id="hero" class="hero-gradient py-12 md:py-16 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        AI termék- és kategóriaoldal-író
                        <span class="text-primary">webshopoknak</span>
                    </h1>

                    <!-- Támogatott rendszerek -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Támogatott rendszerek:</span>
                        <PlatformLogos cap="writeBack" variant="pill" />
                    </div>

                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        Letölti a meglévő termékleírásaidat és kategóriaoldalaid szövegét, az AI
                        <span class="font-bold text-primary">SEO- és GEO-barát</span>, eladásra hangolt szöveggé írja át,
                        majd <span class="font-bold text-primary">vissza is tölti</span> a webshopodba.
                    </p>

                    <ul class="space-y-3.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>SEO- és GEO-barát:</strong> a Google és az AI-válaszok (ChatGPT, Gemini) is
                                tudnak a szövegeidből dolgozni</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Csak a boltod saját adataiból</strong> dolgozik – tényt nem talál ki</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span>Akár <strong>több ezer termék</strong> egy menetben – export-import nélkül</span>
                        </li>
                    </ul>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">100+ hazai webshop</span> már használja</p>
                    </div>

                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h3 class="text-2xl font-bold text-center mb-2 text-primary">Jelentkezés online bemutatóra</h3>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">A bemutatón a te saját
                                    termékleírásaidon futtatjuk le</strong> – élőben, a saját katalógusodból vett
                                    termékeken. Önkiszolgáló próbaverzió nincs.</p>
                            </div>
                        </div>

                        <form id="leadForm" class="space-y-4 max-h-[500px] overflow-hidden pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Milyen webshopod van?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="UNAS">UNAS</option>
                                            <option value="Shoprenter">Shoprenter</option>
                                            <option value="WooCommerce">WooCommerce</option>
                                            <option value="Egyéb" data-reject="hard">Egyéb</option>
                                            <option value="Csak tervezek webshopot indítani" data-reject="soft">Csak tervezek webshopot
                                                indítani</option>
                                            <option value="Más típusú vállalkozásom van" data-reject="hard">Más típusú vállalkozásom
                                                van</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Hány terméked van a
                                            webáruházban?</label>
                                        <select name="product_count" id="productCount"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="100 alatt">100 alatt</option>
                                            <option value="100-1.000">100–1.000</option>
                                            <option value="1.000-10.000">1.000–10.000</option>
                                            <option value="10.000 felett">10.000 felett</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Ki írja jelenleg a termék- és
                                            kategóriaoldalak szövegét?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Én, cégvezetőként">Én, cégvezetőként</option>
                                            <option value="Belsős marketing csapat">Belsős marketing csapat</option>
                                            <option value="Külsős ügynökség">Külsős ügynökség</option>
                                            <option value="Senki – a gyártói leírás van fent">Senki – a gyártói leírás van
                                                fent, a kategóriák üresek</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Ha a bemutató alapján
                                            tetszik, mikor tudnád elkezdeni használni a szoftvert?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Azonnal">Azonnal</option>
                                            <option value="1 hónapon belül">1 hónapon belül</option>
                                            <option value="2-3 hónapon belül" data-reject="soft">2-3 hónapon belül</option>
                                            <option value="Még csak érdeklődöm" data-reject="soft">Még csak érdeklődöm</option>
                                        </select>
                                    </div>
                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Tovább
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h4 class="text-xl font-bold text-dark">Köszönjük az érdeklődésedet!</h4>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        A megadott adatok alapján úgy látjuk, hogy nem lenne a platformunk megfelelő
                                        számodra. Így nem is szeretnénk az idődet húzni, megértésed köszönjük!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen (timing not ideal) -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h4 class="text-xl font-bold text-dark">Köszönjük az érdeklődésedet!</h4>
                                        <p class="text-body leading-relaxed text-sm">
                                            A bemutatót csak olyanoknak tudjuk vállalni, akik azonnal használni szeretnék
                                            a rendszert. Maradjunk kapcsolatban addig is – szívesen elküldenénk egy
                                            <strong>videós bemutatót</strong> neked.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email cím</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="pl. janos@ceg.hu">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            Az <a href="/hu/adatkezeles/" target="_blank"
                                                class="underline hover:text-primary">Adatkezelési Tájékoztatóban</a>
                                            foglaltakat elolvastam, megértettem és tudomásul vettem.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            Érdekelnek hasonló izgalmas tartalmak! Feliratkozom a hírlevélre.
                                            (<a href="/hu/adatkezeles/"
                                                class="underline hover:text-primary">Adatkezelési tájékoztató</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject(this)"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Kérem a videót
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h4 class="text-xl font-bold text-dark">Megkaptuk!</h4>
                                    <!-- Két változat: az „újdonságok" csak akkor igaz, ha a hírlevelet is kérte.
                                         A videó minden esetben megy – a script választ közülük. -->
                                    <p data-thanks="plain" class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Néhány percen belül elküldjük a bemutató videót. Köszönjük az érdeklődésedet!
                                    </p>
                                    <p data-thanks="newsletter" class="hidden text-body leading-relaxed max-w-[400px] mx-auto">
                                        Néhány percen belül elküldjük a bemutató videót, és ezentúl az aktuális újdonságokról is hírt adunk. Köszönjük az érdeklődésedet!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Név</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="pl. Kovács János">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Céges email cím</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="pl. janos@ceg.hu">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Telefonszám</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+36 30 123 4567">
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="privacy" required
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="privacy">
                                            Az <a href="/hu/adatkezeles/" target="_blank"
                                                class="underline hover:text-primary">Adatkezelési Tájékoztatóban</a>
                                            foglaltakat elolvastam, megértettem és tudomásul vettem.
                                        </label>
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="newsletter" name="newsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="newsletter">
                                            Érdekelnek hasonló izgalmas tartalmak! Feliratkozom a hírlevélre.
                                            (<a href="/hu/adatkezeles/"
                                                class="underline hover:text-primary">Adatkezelési tájékoztató</a>)
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-4">
                                        <button type="button" onclick="nextStep(1)"
                                            class="flex-shrink-0 hidden md:flex items-center justify-center rounded-[10px] h-12 px-4 border-2 border-border text-body text-base font-bold hover:bg-light transition-all">
                                            <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                                            Vissza
                                        </button>
                                        <button type="submit" id="submitBtn"
                                            class="flex-1 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                            Tovább az időpontfoglaláshoz!
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hitelesitesek: Meta Tech Provider + UNAS partner (kozos komponens) -->
    <TrustBadges locale={locale} />

    <!-- 1/b. Előtte / utána – TERMÉKOLDAL. Bal: a lényeg 3 pontban; jobb: csúszka valósághű DEMÓ-bolt képeivel (kitalált bolt; a képek forrása a scratchpad-generátor, public/assets/shopgrade-demo-*). A „dizájn” pont fedett: app shopgrade-design-html + shopgrade-design-patterns. -->
    <section class="bg-light py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <div>
                    <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Termékoldal – előtte / utána ✍️</span>
                    <h2 class="text-3xl md:text-4xl font-bold mb-8 text-dark leading-tight">Turbózd fel a termékleírásaid</h2>
                    <ul class="space-y-6 mb-10">
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">trending_up</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Növeli az eladásokat</h3>
                                <p class="text-body leading-relaxed">A vevő nem paramétereket keres, hanem választ: mire jó, kinek való, miben más. Ha ezt a leírásban megkapja, nem megy tovább a következő boltba.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">palette</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Nem csak szöveg – dizájn is</h3>
                                <p class="text-body leading-relaxed">A rövid és a hosszú leírás is kaphat dizájnt: kiemelő dobozt, előny-kártyákat, műszaki táblázatot. Négy kész minta közül választhatsz, vagy mutathatsz egy sajátot.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">travel_explore</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">A Google és az AI is rátalál</h3>
                                <p class="text-body leading-relaxed">Alcímek, természetes kulcsszavak, keresőbarát cím és leírás. A ChatGPT és a Gemini is ilyen tényszerű, jól tagolt szövegből dolgozik, amikor terméket ajánl.</p>
                            </div>
                        </li>
                    </ul>
                    <a href="#hero" class="cta-primary px-8 py-4 text-base">Nézzük meg a saját termékeimen</a>
                </div>

                <div class="max-w-[560px] w-full mx-auto">
                    <BeforeAfterSlider media beforeLabel="Előtte" afterLabel="Utána" ariaLabel="Előtte–utána csúszka: termékoldal"
                        hint="Demó bolt. Húzd a vonalat: balra az előtte, jobbra az utána.">
                        <img slot="before" src="/assets/shopgrade-demo-hu-termek-elotte.webp?v=2" alt="Demó webshop termékoldala előtte: a termosz leírása egyetlen sor gyártói adat" width="960" height="1350" loading="lazy" draggable="false" class="block w-full h-auto">
