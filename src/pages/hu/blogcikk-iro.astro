                    <div class="p-4 md:p-5 space-y-3 flex-1">
                        <div class="flex justify-end">
                            <p class="bg-primary text-white text-sm rounded-[14px] rounded-br-[4px] px-4 py-2.5 max-w-[85%]">Melyik régi cikkemet érdemes frissíteni?</p>
                        </div>
                        <div class="flex items-end gap-2">
                            <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[16px]">smart_toy</span></span>
                            <p class="bg-light border border-border text-dark text-sm rounded-[14px] rounded-bl-[4px] px-4 py-2.5 max-w-[85%]">A „Kávébab tárolása” a 12. helyen áll, és havonta 3 400-an látják. Egy frissítéssel feljebb jöhet. Megírjam az új változatot?</p>
                        </div>
                        <div class="flex justify-end">
                            <p class="bg-primary text-white text-sm rounded-[14px] rounded-br-[4px] px-4 py-2.5 max-w-[85%]">Igen, írd meg.</p>
                        </div>
                        <div class="flex items-end gap-2">
                            <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[16px]">smart_toy</span></span>
                            <div class="bg-card border-[1.5px] border-primary/30 rounded-[14px] rounded-bl-[4px] p-3.5 max-w-[85%] shadow-card">
                                <p class="text-[11px] font-semibold text-primary uppercase tracking-wider mb-1">Jóváhagyásra vár</p>
                                <p class="text-sm font-semibold text-dark mb-3">Cikk frissítése: Kávébab tárolása</p>
                                <div class="flex gap-2">
                                    <span class="text-xs font-semibold text-white bg-primary rounded-[8px] px-3 py-1.5">Jóváhagyom</span>
                                    <span class="text-xs font-semibold text-body border border-border rounded-[8px] px-3 py-1.5">Mégse</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 border-t border-border px-4 py-3">
                        <span class="text-sm text-muted flex-1">Írj a Ninja AI-nak…</span>
                        <span class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center"><span class="material-symbols-outlined text-[18px]">arrow_upward</span></span>
                    </div>
                </div>
                <div class="lg:order-4">
                    <h3 class="font-bold text-lg mb-1">Elég megkérdezned</h3>
                    <p class="text-body text-sm leading-relaxed">A Ninja AI chatből kezeli a blogodat. Témát keres, cikket ír, és megmondja, mit érdemes frissíteni. Mielőtt bármit megír vagy publikál, jóváhagyást kér.
                    <a href="/hu/ninja-ai/" class="text-primary font-semibold underline">A Ninja AI-ról →</a></p>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. Modulrács – mennyi extra jár ugyanazért a havidíjért (modules.ts, a Blogcikk író nélkül 9 kártya) -->
    <ModuleGrid
        locale={locale}
        exclude="blogWriter"
        sectionId="modulok"
        sectionClass="bg-card py-20 md:py-28"
        cardClass="bg-light"
        eyebrow="Ráadásul 🎁"
        heading="Ugyanezért a havidíjért még 9 modult kapsz"
        lead="Nem csak blogot írsz vele. A teljes webshop-marketinged egy helyen van, ugyanabból a termékkatalógusból."
        homeCta
    />

    <!-- 7. Árazás – a „teljes rendszer" üzenetet is ez viszi (modulrács nincs az oldalon) -->
    <section id="arazas" class="bg-light py-20 md:py-28">
        <div class="max-w-[900px] mx-auto px-4 md:px-10">
            <div class="text-center mb-10 md:mb-16">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Árazás</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Mindez egy havidíjért</h2>
                <p class="text-body text-lg">Nincs modulonkénti felár. Egy előfizetés tartalmazza mind a 10 modult.</p>
            </div>

            <!-- 1 kulcsszó + 3 szöveg + 3×2 kép = 10 kredit (app: docs/credit-pricing.md) -->
            <div class="bg-card rounded-[16px] border border-border p-6 md:p-8 mb-10 flex flex-col sm:flex-row items-start sm:items-center gap-5">
                <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[22px]">calculate</span>
                </div>
                <p class="text-body leading-relaxed">Egy átlagos cikk körülbelül <strong class="text-dark">10 kredit</strong>. Heti két cikk így nagyjából
                    <strong class="text-dark">90 kredit a havi 500-ból</strong>. A többi posztra, hírlevélre és termékleírásra marad.</p>
            </div>

            <PricingCards locale={locale} ctaHref="#hero" />

            <div class="text-center mt-8">
                <a href="/hu/arak/#kreditek" class="text-primary font-bold text-sm inline-flex items-center gap-1">
                    Részletes kreditdíjak
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>

    <!-- 8. GYIK – ugyanabból a `faqs` tömbből, mint a FAQPage JSON-LD. Ide kerültek a kivett blokkok
         részletei (WordPress-publikálás, mérés, Ninja AI). WordPressnél NE ígérj címkét, szerzőválasztást,
         WPML/Polylangot vagy WordPress.com-ot – az app nem tudja. -->
    <section id="gyik" class="bg-card py-20 md:py-28 px-4 md:px-10">
        <div class="max-w-[800px] mx-auto">
            <div class="text-center mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">GYIK</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Gyakran ismételt kérdések</h2>
            </div>

            <div class="space-y-3">
                {faqs.map((f) => (
                    <div class="faq-item bg-light rounded-[12px] border border-border overflow-hidden">
                        <button class="w-full flex items-center justify-between p-4 sm:p-5 text-left font-semibold text-dark text-base gap-4"
                            onclick="toggleFaq(this)">
                            {f.q}
                            <span class="material-symbols-outlined faq-icon text-primary shrink-0 text-[20px]">add</span>
                        </button>
                        <div class="faq-answer px-5 pb-5 text-body text-sm leading-relaxed">
                            {f.a}
                            {f.link && (
                                <> <a href={f.link.href} class="text-primary font-semibold underline">{f.link.label}</a></>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 9. Záró CTA -->
    <section class="bg-primary py-16 md:py-20">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Nézzük meg, mit hozhat a blogod</h2>
            <p class="text-white/80 text-lg mb-8 max-w-[620px] mx-auto">
                Egy 30 perces bemutatón megmutatjuk, mire keresnek a vásárlóid. Azt is, mely régi cikkeid hozhatnának
                több forgalmat. Az első hónapod fél áron indul, +250 bónusz kredittel.
            </p>
            <a href="#hero" class="cta-on-primary px-8 h-14 text-base inline-flex">
                Bemutatót kérek
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contact" class="py-12 bg-dark text-muted text-sm border-t border-dark/90">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
                <div>
                    <div class="bg-white p-3 rounded-xl inline-block mb-4"><img src="/assets/logo.webp" alt="Logo" class="h-8 md:h-10"></div>
                    <p class="text-muted">Egy rendszer, ami a webshopod nevében készít marketing tartalmakat
                        futószalagon – közvetlenül a webáruházad termékeiből.</p>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-4">Információk</h4>
                    <ul class="space-y-2">
                        <li><a href="https://app.getcontentninja.com/changelog" class="hover:text-white">Újdonságok</a></li>
                        <li><a href="/hu/adatkezeles/" class="hover:text-white">Adatkezelési tájékoztató</a></li>
                        <li><a href="/hu/impresszum/" class="hover:text-white">Impresszum</a></li>
                        <li><a href="/hu/aszf/" class="hover:text-white">ÁSZF</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p>Copyright © getcontentninja.com | 2026</p>
            </div>
        </div>
    </footer>

    <!-- Lead form + GYIK script -->
    <script is:inline>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }

    </script>

    <LeadFormScript locale={locale} source="blogcikk-iro" />

  </div>
</BaseLayout>
