                    <ul class="space-y-3 text-body text-sm leading-relaxed">
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>Termékek: név, ár, készlet, képek, leírások</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>Kategóriák és alkategóriák</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>A WordPress-blogcikkeid és -oldalaid</li>
                    </ul>
                </div>
                <div class="bg-light rounded-[16px] border border-primary/30 p-8 shadow-card">
                    <div class="flex items-center gap-3 mb-5">
                        <span class="material-symbols-outlined text-primary text-[26px]">sync_alt</span>
                        <h3 class="font-bold text-xl">Visszaírja</h3>
                    </div>
                    <ul class="space-y-3 text-body text-sm leading-relaxed">
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>Termékleírás és rövid leírás</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>Kategória-leírás</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>SEO cím és meta leírás (Yoast / Rank Math)</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>Blogcikk – ugyanarra a WordPressre</li>
                    </ul>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card">
                    <div class="flex items-center gap-3 mb-5">
                        <span class="material-symbols-outlined text-muted text-[26px]">block</span>
                        <h3 class="font-bold text-xl">Nem nyúl hozzá</h3>
                    </div>
                    <ul class="space-y-3 text-body text-sm leading-relaxed">
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-muted text-[18px] mt-0.5">remove</span>Árak és készlet (csak olvassa)</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-muted text-[18px] mt-0.5">remove</span>Rendelések és vásárlói adatok</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-muted text-[18px] mt-0.5">remove</span>Termékcímkék (tags)</li>
                        <li class="flex items-start gap-2"><span class="material-symbols-outlined text-muted text-[18px] mt-0.5">remove</span>WPML / Polylang többnyelvű beállítások</li>
                    </ul>
                </div>
            </div>

            <!-- Több bolt – egy sáv, nem külön szekció: a WooCommerce-es látogatónak ez mellékszál. -->
            <div class="bg-light rounded-[16px] border border-border p-5 sm:p-8 shadow-card mt-8 flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
                <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[22px]">add_business</span>
                </div>
                <p class="text-body leading-relaxed flex-1"><strong class="text-dark">Több boltod van?</strong> Egy
                    fiókba több webáruház is beköthető, vegyesen is – mindegyik saját katalógussal és márkahanggal.</p>
                <div class="flex items-center gap-3 flex-wrap shrink-0">
                    <PlatformLogos />
                </div>
            </div>
        </div>
    </section>

    <!-- 8. És amit a rendszer amúgy is tud (közös modulrács) -->
    <ModuleGrid
        locale={locale}
        exclude="storeIntegration"
        sectionId="features-cards"
        sectionClass="bg-light py-20 md:py-28"
        cardClass="bg-card"
        heading="És amit a rendszer amúgy is tud"
        lead="A Content Ninja egy teljes AI marketing platform – minden, ami egy webshop tartalomgyártásához kell."
    />

    <!-- 9. Árazás -->
    <section id="arazas" class="bg-card py-20 md:py-28">
        <div class="max-w-[900px] mx-auto px-4 md:px-10">
            <div class="text-center mb-10 md:mb-16">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Árazás</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Átlátható, fix havidíj</h2>
                <p class="text-body text-lg">Csatlakozz a korai regisztrálók közé és tartsd meg a kedvezményes árat hosszú távon.</p>
            </div>

            <PricingCards locale={locale} ctaHref="#hero" />

            <div class="bg-light rounded-[16px] border border-border p-5 sm:p-8 shadow-card mt-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                    <div>
                        <h3 class="text-xl font-bold text-dark mb-3">Mire elég 500 kredit?</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-body">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">edit_note</span>
                                <span>1 posztszöveg = 1 kredit</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">image</span>
                                <span>1 képgenerálás (Nano Banana) = 2 kredit</span>
                            </div>
                            <div class="flex items-center gap-2 font-bold text-dark">
                                <span class="material-symbols-outlined text-success text-[20px]">check_circle</span>
                                <span>kb. 166 képes poszt havonta</span>
                            </div>
                        </div>
                    </div>
                    <a href="/hu/arak/#kreditek" class="text-primary font-bold text-sm whitespace-nowrap inline-flex items-center gap-1">
                        Részletes kreditdíjak
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- 10. GYIK – ugyanabból a `faqs` tömbből, mint a FAQPage JSON-LD -->
    <section id="gyik" class="bg-light py-20 md:py-28 px-4 md:px-10">
        <div class="max-w-[800px] mx-auto">
            <div class="text-center mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">GYIK</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Gyakran ismételt kérdések a WooCommerce-integrációról</h2>
            </div>

            <div class="space-y-3">
                {faqs.map((f) => (
                    <div class="faq-item bg-card rounded-[12px] border border-border overflow-hidden">
                        <button class="w-full flex items-center justify-between p-4 sm:p-5 text-left font-semibold text-dark text-base gap-4"
                            onclick="toggleFaq(this)">
                            {f.q}
                            <span class="material-symbols-outlined faq-icon text-primary shrink-0 text-[20px]">add</span>
                        </button>
                        <div class="faq-answer px-5 pb-5 text-body text-sm leading-relaxed">
                            {f.a}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- 11. Záró CTA -->
    <section class="bg-primary py-16 md:py-20">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Nézzük meg a te WooCommerce-boltodon</h2>
            <p class="text-white/80 text-lg mb-8 max-w-[620px] mx-auto">
                Egy online bemutatón végigmegyünk a rendszeren – akár a te saját webáruházad termékeivel.
            </p>
            <a href="#hero" class="cta-on-primary px-8 h-14 text-base inline-flex">
                Bemutatót kérek
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
        </div>
    </section>

    <!-- Footer (kampányoldali, minimál – a webshop-integracio mintájára) -->
    <footer id="contact" class="py-12 bg-dark text-muted text-sm border-t border-dark/90">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
                <div>
                    <div class="bg-white p-3 rounded-xl inline-block mb-4"><img src="/assets/logo.webp" alt="Content Ninja logó" class="h-8 md:h-10"></div>
                    <p class="text-muted">Egy rendszer, ami a webshopod nevében készít marketing tartalmakat
                        futószalagon – közvetlenül a webáruházad termékeiből.</p>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-4">Információk</h4>
                    <ul class="space-y-2">
                        <li><a href="https://app.getcontentninja.com/changelog" class="hover:text-white">Újdonságok</a></li>
                        <li><a href="/hu/adatkezeles/" class="hover:text-white">Adatkezelési tájékoztató</a></li>
                        <li><a href="/hu/impresszum/" class="hover:text-white">Impresszum</a></li>
                        <li><a href="/hu/aszf/" class="hover:text-white">ÁSZF</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p>Copyright © getcontentninja.com | 2026</p>
            </div>
        </div>
    </footer>

    <!-- GYIK script -->
    <script is:inline>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
    </script>

    <!-- Lead form script -->
    <LeadFormScript locale={locale} source="woocommerce" />
  </div>
</BaseLayout>
