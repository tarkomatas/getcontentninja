---
/**
 * **Ninja AI — a beépített AI asszisztens oldala.**
 *
 * Nem modul-oldal a `modules.ts` értelmében: a többi oldal egy-egy TARTALOMTÍPUST
 * ad el (poszt, blogcikk, hírlevél, termékleírás), ez viszont a rendszer
 * KEZELŐFELÜLETÉT — azt, hogy a webshopos nem kattintgat, hanem elmondja, mit
 * szeretne, és a Ninja AI a saját munkatere valós adatain elvégzi.
 *
 * A kulcsszó, amire megy: **„Ninja AI"**. Ezért:
 *  - a kifejezés ott van a H1-ben, a `<title>`-ben, az első bekezdésben és a GYIK
 *    első kérdésében is („Mi az a Ninja AI?"),
 *  - a lap **indexelhető** (nem `noindex`, mint a tisztán fizetett landingek): ez a
 *    fogalom definíciós oldala, nem kampány-csali,
 *  - a GYIK **FAQPage JSON-LD**-vel is kimegy, és a szekciók szándékosan
 *    tényszerű, önmagában idézhető bekezdésekkel dolgoznak (GEO): az AI-kereső
 *    egy-egy bekezdést emel ki, nem az egész oldalt.
 *
 * ⚠️ **A tartalom az app tényleges működését írja le**, nem marketing-fantáziát —
 * a forrás az app repó `docs/copilot-mukodes.md`-je, az agentek és a
 * szabálykönyvük a `src/lib/chat/agents.ts`-ben, az eszközlista a
 * `src/lib/chat/registry/`-ben. A számok (12 asszisztens, 160+ művelet) ONNAN
 * jönnek, nem kerekített becslések — ha az app bővül, itt is frissíteni kell.
 * Ami itt „nem tud" szekcióként szerepel, az az app SZÁNDÉKOS korlátja: ezt
 * kimondani hitelesebb, mint elhallgatni, és az AI-keresők is ezt idézik szívesen.
 *
 * A fejlécbe/láblécbe SZÁNDÉKOSAN nincs belinkelve (user-kérés): előbb a
 * keresőforgalom mérése jön. A `routes.ts` `ninjaAi` bejegyzése és a sitemap
 * viszont már él, tehát a kereső és az AI-fetcherek megtalálják.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';

const locale = 'hu';
const page = 'ninjaAi';
const title = 'Ninja AI – a Content Ninja beépített AI asszisztense webshopoknak | Content Ninja';
const description =
  'A Ninja AI a Content Ninja beépített AI asszisztense: chatben kezeli helyetted a rendszert, megválaszolja a kérdéseid, beállítja a bonyolultabb dolgokat (automatizmus, sablon, ütemezés), elemzi a webshopod adatait és javaslatokkal áll elő – minden módosítást te hagysz jóvá.';
const keywords =
  'Ninja AI, Content Ninja AI asszisztens, beépített AI asszisztens webshop, AI copilot marketing, chatből kezelhető marketing rendszer, AI marketing asszisztens magyarul, webshop AI adatelemzés';

/**
 * A 12 szakosodott asszisztens — az app `src/lib/chat/agents.ts` `AGENT_KEYS`
 * sorrendjében, a KÓDBAN lévő névvel és tagline-nal (rövidítve). Új asszisztens
 * felvételekor ezt a tömböt kell bővíteni.
 */
const agents = [
  { icon: 'smart_toy', name: 'Általános', desc: 'Bármiben segít a tartalomkészítéstől az ütemezésig.' },
  { icon: 'menu_book', name: 'Posztolás alapok', desc: 'Végigvezet a beállítástól az első működő automatizmusig.' },
  { icon: 'auto_awesome', name: 'Posztolás haladó', desc: 'A már futó automatizmusaidat emeli minőségben.' },
  { icon: 'mail', name: 'Hírlevél alapok', desc: 'Az első hírleveledtől odáig, hogy magától megy hetente.' },
  { icon: 'article', name: 'Blog alapok', desc: 'Az első cikkedtől odáig, hogy hetente magától megy.' },
  { icon: 'edit_document', name: 'Shopgrade alapok', desc: 'Az első átírt termékadatlaptól a teljes bolt rendbetételéig.' },
  { icon: 'category', name: 'Kategóriaoldal alapok', desc: 'Olyan kategóriaszöveget írat, ami tényleg segít választani.' },
  { icon: 'public', name: 'Nemzetközi terjeszkedés', desc: 'Több nyelv, ország-brandek, automata fordítás.' },
  { icon: 'insights', name: 'Adatelemző', desc: 'Megnézi, mi működik — és át is állítja, ami nem.' },
  { icon: 'edit_note', name: 'Prompt-készítő', desc: 'Jó mentett promptot választ vagy ír — szöveghez, képhez, videóhoz.' },
  { icon: 'build', name: 'Hibakereső', desc: 'Megnézi, mi hasalt el és miért — és megmondja, mit tegyél.' },
  { icon: 'move_down', name: 'Költözés utáni indulás', desc: 'Másik rendszerből jöttél át? Újraindítja a gépezetedet.' },
];

/**
 * FAQPage strukturált adat. **A válaszok szándékosan önmagukban is teljesek** —
 * egy AI-kereső egy-egy `acceptedAnswer`-t emel ki, kontextus nélkül; egy „lásd
 * fentebb" típusú válasz ott értelmezhetetlen lenne.
 */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Mi az a Ninja AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A Ninja AI a Content Ninja beépített AI asszisztense – egy magyar nyelvű chat az appon belül, ami a webshop marketingrendszerét kezeli a tulajdonos helyett. A saját szavaiddal kérheted, ő pedig a te munkatered valós adataival dolgozik: megnézi a posztjaidat, brandjeidet, automatizmusaidat, analitikádat és a hibanaplódat, válaszol a kérdéseidre a súgó alapján, beállítja a bonyolultabb dolgokat (tudásforrás, sablon, automatizmus, ütemezés), elindítja a tartalomgenerálást, sőt publikál is – minden módosítást egy jóváhagyó kártyán te erősítesz meg. Ma 12 szakosodott asszisztens és több mint 160 művelet áll mögötte.',
      },
    },
    {
      '@type': 'Question',
      name: 'Mit tud elvégezni a Ninja AI a webshopom helyett?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nagyjából mindent, amit a felületen kattintva megtennél. Olvas: posztok, média, brandek és social fiókok, tudásforrások, mentett promptok, sablonok, automatizmusok, integrációk, analitika, kredit-egyenleg, hibanapló és a súgó-cikkek. Létrehoz és szerkeszt: posztot a teljes életciklusán át, brandet, social fiókot, tudásforrást, sablont, hirdetés-vázlatot, és felépít egy automatizmust a triggerektől a lépéseken át a bekapcsolásig. Háttérmunkát indít: poszt-szöveg generálása és átírása, képgenerálás, hírlevél- és hirdetés-szöveg, weboldal-elemzés, publikálás és hírlevél-kiküldés. A tartalmat mindig a beépített generáló motor gyártja – ugyanazzal a mentett prompttal, márkahanggal és tudásforrással, mint a felületen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Mit NEM tud a Ninja AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Szándékosan nem tud videót generálni (ezt a felületen indítod, mert ott állíthatók be pontosan a vizuál paraméterei), nem tud integrációt bekötni (Unas, Shoprenter, Meta-belépés – ez biztonsági okból kézi), nem nyúl a fizetéshez, az előfizetéshez és a keretekhez (a kreditet csak olvassa), nem tölt fel médiát, nem küld ki hirdetést a Metára, és soha nem lát más munkatér vagy admin adatot. Ha valamihez nincs eszköze, nem ígéri meg – felajánlja azt az asszisztenst, akinek van.',
      },
    },
    {
      '@type': 'Question',
      name: 'Honnan tudom, hogy a Ninja AI nem talál ki adatokat?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Amit tényként állít, azt eszközzel kérte le a te munkateredből – nem emlékezetből válaszol. Az adatelérést az adatbázis szintjén garantáljuk (sorszintű jogosultság), nem csak kérésre: más webshop adata elérhetetlen. A „hogyan csináljak valamit” típusú kérdéseknél előbb a saját súgó-cikkeinkben keres, és aszerint válaszol – menüneveket és gombokat nem talál ki. A beolvasott szöveget (termékoldal, tudásforrás, RSS) adatként kezeli, nem utasításként: ha egy ilyen tartalom próbálná eltéríteni, figyelmen kívül hagyja és szól neked.',
      },
    },
    {
      '@type': 'Question',
      name: 'Elemzi a Ninja AI a webshopom adatait?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Igen, erre külön Adatelemző asszisztens van. Megnézi a posztjaid teljesítményét, a hírleveleid megnyitási és kattintási számait, valamint a Google Search Console adataidat (mire keresnek rád, mely oldalaid javíthatók a legolcsóbban), és megmondja, mit állíts át – majd fel is ajánlja, hogy megcsinálja. A statisztikát a rendszer számolja, nem a chat-modell, és az asszisztens kimondja a mérési korlátokat is: a Facebookon nem látunk megtekintést, a vásárlást nem mérjük, kevés adatból pedig nem csinál szabályt. Helyezés-javulást soha nem ígér.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kerül extra pénzbe a Ninja AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nem, a Ninja AI a 34.990 Ft + ÁFA / hó előfizetés része, nincs külön díja. A beszélgetésre munkaterenként havi keret jár, ami az első számlázási ciklusban dupla – ezt a chat-ablak folyamatosan mutatja. Ami a beszélgetés nyomán ténylegesen elkészül (poszt-szöveg, kép, blogcikk, hírlevél), az a szokásos kreditárak szerint fogyaszt a havi 500 megújuló AI kreditedből – ugyanannyit, mintha a felületen indítottad volna.',
      },
    },
    {
      '@type': 'Question',
      name: 'Emlékszik a Ninja AI arra, amit korábban mondtam neki?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Igen. A beszélgetéseken átívelően megjegyzi a tartós működési preferenciáidat („mindig tegezz”, „ne használj emojit”), és te is kérheted, hogy jegyezzen meg valamit. Az elmentett emlékeket a Ninja AI emlékei panelen bármikor megnézheted és törölheted. Titkot – jelszót, API-kulcsot, bankkártya-adatot – soha nem ment el. Egy hosszú beszélgetés régebbi részét magától összefoglalja, így nem esik ki a lényeg.',
      },
    },
    {
      '@type': 'Question',
      name: 'Magyarul beszél a Ninja AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Igen, a Ninja AI magyarul, tegező, közvetlen hangon beszél – nem fejlesztőnek, hanem a webshop gazdájának. A súgó-cikkek, amikből a válaszait építi, szintén magyarul készültek. Ettől függetlenül a rendszer több nyelven gyárt tartalmat: külön asszisztens segít a nemzetközi terjeszkedésben, ország-brandekkel és automata fordítással.',
      },
    },
  ],
};
---

<BaseLayout
  locale={locale}
  page={page}
  title={title}
  description={description}
  keywords={keywords}
  ogImage="/assets/og-fooldal.jpg"
  lpEnabled
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-primary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }

        /* Chat-buborékok a „példa-kérések” szekcióban. Nem képernyőkép: sima HTML,
           így a kereső és az AI-fetcher is OLVASSA a példa-mondatokat – pont azokat
           a kifejezéseket, amikre a látogató is keresne. */
        .chat-ask {
            background-color: #6c5ce7;
            color: #ffffff;
            border-radius: 14px 14px 4px 14px;
        }

        .chat-reply {
            background-color: #ffffff;
            border: 1px solid #e8e8ef;
            border-radius: 14px 14px 14px 4px;
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Közös fejléc – ?type=ld (lp-mode) esetén minimálra vált (logó + nyelvváltó) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + jelentkezési űrlap -->
    <section id="hero" class="hero-gradient py-12 md:py-16 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">
                    <span class="text-primary font-bold text-sm uppercase tracking-widest">Ninja AI · beépített asszisztens</span>

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        A <span class="text-primary">Ninja AI</span> a Content Ninja beépített asszisztense, ami
                        <span class="text-primary">helyetted kezeli a rendszert</span>
                    </h1>

                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        Írd le a saját szavaiddal, mit szeretnél – a Ninja AI megnézi a webshopod valós adatait,
                        elkészíti, amit kértél, és a <strong class="text-dark">jóváhagyásod után</strong> élesíti is.
                    </p>

                    <ul class="space-y-3.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Megválaszolja a kérdéseid</strong> – a saját súgónkból és a te adataidból, nem találgat</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Beállítja a bonyolultabb dolgokat</strong> – sablon, tudásforrás, automatizmus, ütemezés</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Elemzi az adataid</strong> – megmondja, mit állíts át, és át is állítja helyetted</span>
                        </li>
                    </ul>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ hazai webshop</span> már használja</p>
                    </div>
                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h3 class="text-2xl font-bold text-center mb-2 text-primary">Jelentkezés online bemutatóra</h3>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">Közvetlen kipróbálásra
                                    nincs lehetőség</strong> – de egy online megbeszélésen élőben megmutatjuk, mit
                                    kérdezünk a Ninja AI-tól, és mit csinál meg magától.</p>
                            </div>
                        </div>

                        <form id="leadForm" class="space-y-4 max-h-[500px] overflow-hidden pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: minősítő kérdések -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Milyen webshopod van?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="UNAS">UNAS</option>
                                            <option value="Shoprenter">Shoprenter</option>
                                            <option value="Egyéb" data-reject="hard">Egyéb</option>
                                            <option value="Csak tervezek webshopot indítani" data-reject="soft">Csak tervezek webshopot
                                                indítani</option>
                                            <option value="Más típusú vállalkozásom van" data-reject="hard">Más típusú vállalkozásom
                                                van</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Hány terméked van a
                                            webshopban?</label>
                                        <select name="product_count" id="productCount"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="100 alatt">100 alatt</option>
                                            <option value="100-1.000">100–1.000</option>
                                            <option value="1.000-10.000">1.000–10.000</option>
                                            <option value="10.000 felett">10.000 felett</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Ki kezeli most a webshopod
                                            marketingjét?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Én, cégvezetőként">Én, cégvezetőként</option>
                                            <option value="Belsős marketing csapat">Belsős marketing csapat</option>
                                            <option value="Külsős ügynökség">Külsős ügynökség</option>
                                            <option value="Senki – jelenleg nincs rá kapacitás">Senki – jelenleg nincs rá
                                                kapacitás</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Ha a bemutató alapján
                                            tetszik, mikor tudnád elkezdeni használni a szoftvert?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Válassz...</option>
                                            <option value="Azonnal">Azonnal</option>
