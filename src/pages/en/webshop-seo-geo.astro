---
/**
 * The `/hu/webshop-seo-geo/` page's English twin — the search-content hub that sells
 * the Shopgrade (product + category copy) and blog writer modules as ONE thing.
 *
 * Keep it structurally identical to the Hungarian original (same sections, same
 * highlights); the ad traffic goes to the HU page, this exists so the hreflang
 * pair and the English nav stay complete.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';

const locale = 'en';
const page = 'webshopSeoGeo';
const title = 'Webshop SEO and GEO in one system – category, product copy, blog | Content Ninja';
const description =
  'Content Ninja writes your category pages, product descriptions and blog posts – SEO- and GEO-friendly – then uploads them back to your webshop. With Unas and Shoprenter integration.';
---

<BaseLayout locale={locale} page={page} title={title} description={description} ogImage="/assets/og-webshop-seo-geo.jpg" lpEnabled>
  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-primary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }

        .compare-table th,
        .compare-table td {
            border-bottom: 1px solid #e8e8f0;
            padding: 14px 16px;
            text-align: left;
            vertical-align: top;
        }

        .compare-table tr:last-child td {
            border-bottom: none;
        }

        .cmp-icon {
            display: inline-block;
            margin-right: 6px;
            font-size: 1.05em;
            line-height: 1;
            vertical-align: -0.08em;
        }

        .compare-table tr.cmp-win td {
            background-color: rgba(108, 92, 231, 0.07);
        }

        .compare-table tr.cmp-win td:first-child {
            box-shadow: inset 3px 0 0 #6c5ce7;
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <Header locale={locale} page={page} />

    <!-- 1. Hero + lead form -->
    <section id="hero" class="hero-gradient py-12 md:py-24 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <!-- No jargon in the H1 (see the HU twin): "SEO" and "GEO" only appear further
                         down, and there we explain first and name second. -->
                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        It's time your <span class="text-primary">webshop</span> entered the
                        <span class="text-primary">AI era</span>
                    </h1>

                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Supported platforms:</span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/unas_logo.png" alt="Unas" class="h-[18px] w-auto" loading="lazy" />
                        </span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/shoprenter-logo.png" alt="Shoprenter" class="h-[18px] w-auto" loading="lazy" />
                        </span>
                    </div>

                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        It writes <span class="font-bold text-primary">category pages</span>,
                        <span class="font-bold text-primary">product descriptions</span> and
                        <span class="font-bold text-primary">blog posts</span> that both ChatGPT and Google will
                        love ❤️
                    </p>

                    <ul class="space-y-3.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>It checks what people search for:</strong> real search data, not
                                guesswork</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>For Google and for ChatGPT:</strong> neither recommends anything that isn't
                                written the way it likes to read</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Fully automatic:</strong> it researches, pulls in, writes and uploads – you
                                just approve it (if you want to)</span>
                        </li>
                    </ul>

                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ webshops</span> already use it</p>
                    </div>

                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h3 class="text-2xl font-bold text-center mb-2 text-primary">Book an online demo</h3>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">There is no self-serve
                                    trial</strong> – but on a live call we'll show you, on your own webshop, where your
                                    content stands today and what the system would write instead.</p>
                            </div>
                        </div>

                        <form id="leadForm" class="space-y-4 max-h-[500px] overflow-hidden pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">What kind of webshop do you have?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="UNAS">UNAS</option>
                                            <option value="Shoprenter">Shoprenter</option>
                                            <option value="Egyéb" data-reject="hard">Other</option>
                                            <option value="Csak tervezek webshopot indítani" data-reject="soft">I'm only planning to start one</option>
                                            <option value="Más típusú vállalkozásom van" data-reject="hard">I run a different kind of business</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">How many products do you have?</label>
                                        <select name="product_count" id="productCount"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="100 alatt">Under 100</option>
                                            <option value="100-1.000">100–1,000</option>
                                            <option value="1.000-10.000">1,000–10,000</option>
                                            <option value="10.000 felett">Over 10,000</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Who writes your store's copy today?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Én, cégvezetőként">Me, as the owner</option>
                                            <option value="Belsős marketing csapat">In-house marketing team</option>
                                            <option value="Külsős ügynökség">External agency</option>
                                            <option value="Senki – a gyártói leírás van fent">Nobody – the manufacturer's text is up, categories are empty</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">If you like what you see on the demo, when could you start using it?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Azonnal">Right away</option>
                                            <option value="1 hónapon belül">Within 1 month</option>
                                            <option value="2-3 hónapon belül" data-reject="soft">In 2–3 months</option>
                                            <option value="Még csak érdeklődöm" data-reject="soft">Just browsing for now</option>
                                        </select>
                                    </div>
                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Next
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h4 class="text-xl font-bold text-dark">Thank you for your interest!</h4>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Based on your answers, our platform would not be a good fit for you. We don't
                                        want to take up your time – thanks for your understanding!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h4 class="text-xl font-bold text-dark">Thank you for your interest!</h4>
                                        <p class="text-body leading-relaxed text-sm">
                                            We only run demos for people who want to start using the system right away.
                                            Let's stay in touch – we'd gladly send you a <strong>recorded walkthrough</strong>.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email address</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            I have read, understood and acknowledged the
                                            <a href="/en/privacy-policy/" target="_blank" class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            I'm interested in content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy/" class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject(this)"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Send me the video
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h4 class="text-xl font-bold text-dark">Got it!</h4>
                                    <p data-thanks="plain" class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send the walkthrough video within a few minutes. Thanks for your interest!
                                    </p>
                                    <p data-thanks="newsletter" class="hidden text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send the walkthrough video within a few minutes, and we'll keep you posted
                                        on what's new. Thanks for your interest!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Name</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. John Smith">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Business email</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Phone number</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+36 30 123 4567">
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="privacy" required
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="privacy">
                                            I have read, understood and acknowledged the
                                            <a href="/en/privacy-policy/" target="_blank" class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="newsletter" name="newsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="newsletter">
                                            I'm interested in content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy/" class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-4">
                                        <button type="button" onclick="nextStep(1)"
                                            class="flex-shrink-0 hidden md:flex items-center justify-center rounded-[10px] h-12 px-4 border-2 border-border text-body text-base font-bold hover:bg-light transition-all">
                                            <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                                            Back
                                        </button>
                                        <button type="submit" id="submitBtn"
                                            class="flex-1 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                            Continue to booking
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. The problem -->
    <section class="bg-card py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center max-w-[760px] mx-auto mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">The problem 🕳️</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">AI and Google aren't skipping your webshop because your
                    products are bad</h2>
                <p class="text-body text-lg">It's because your copy is thin and weak. Google and ChatGPT can only work
                    with what's readable on your webshop.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">category</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Category page copy isn't written well</h3>
                    <p class="text-body text-sm leading-relaxed">There's usually something there – two throwaway
                        sentences, or a paragraph from years ago. It just wasn't written for the phrase shoppers type,
                        and it doesn't help them choose.</p>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">content_copy</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Product copy comes from the manufacturer</h3>
                    <p class="text-body text-sm leading-relaxed">The same few sentences sit on ten other stores too.
                        Google has no reason to rank you higher, and the shopper has no reason to buy from you.</p>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">event_busy</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">The blog is missing, or frozen for years</h3>
                    <p class="text-body text-sm leading-relaxed">Most shoppers don't search for product names – they ask
                        questions: "which one should I pick", "what should I watch out for". If you have no answer, they
                        go to your competitor.</p>
                </div>
            </div>

            <div class="mt-10 bg-light border border-primary/20 rounded-[16px] px-6 py-6 md:px-8 flex items-start gap-4">
                <span class="material-symbols-outlined text-primary text-[26px] shrink-0 mt-0.5">payments</span>
                <p class="text-body leading-relaxed">
                    <strong class="text-dark">It always ends the same way: ads are all that's left.</strong> While you
                    pay, traffic comes; the moment you stop, it's gone. Organic traffic works the other way around – it
                    builds slower, but then it keeps working. It just needs text on your pages.
                </p>
            </div>
        </div>
    </section>

    <!-- 3. Why all three together -->
    <section id="miert-egyben" class="bg-light py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center max-w-[760px] mx-auto mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Why together? 🔗</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">The three page types form one system – separately, each
                    is worth less</h2>
                <p class="text-body text-lg">Search engines don't score a single page, they look at the whole store. So
                    blogging alone isn't enough, and swapping product descriptions alone isn't either. Your customer goes
                    through all three, too:</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mb-6 shadow-primary-glow">1</div>
                    <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-2">Blog post</span>
                    <h3 class="font-bold text-lg mb-3">"Which one should I pick?"</h3>
                    <p class="text-body text-sm leading-relaxed">This is where they meet you first, while they still only
                        have a question. It's also the content AI search engines quote – and it lifts how your whole
                        store is judged.</p>
                </div>
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mb-6 shadow-primary-glow">2</div>
                    <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-2">Category page</span>
                    <h3 class="font-bold text-lg mb-3">"Show me what you've got"</h3>
                    <p class="text-body text-sm leading-relaxed">This is the page that ranks for the big, ready-to-buy
                        phrases. From a throwaway paragraph, though, Google can't tell what makes your version of this
                        category different.</p>
                </div>
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mb-6 shadow-primary-glow">3</div>
                    <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-2">Product description</span>
                    <h3 class="font-bold text-lg mb-3">"Is this really right for me?"</h3>
                    <p class="text-body text-sm leading-relaxed">This is where the sale is decided – and where AI learns
                        who your product is for, what it goes with, how it differs. Two lines won't tell it that.</p>
                </div>
            </div>

