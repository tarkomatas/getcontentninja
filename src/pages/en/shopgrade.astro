---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HowItWorksSteps from '../../components/HowItWorksSteps.astro';
import Header from '../../components/Header.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import PlatformLogos from '../../components/PlatformLogos.astro';

const locale = 'en';
const page = 'shopgrade';
const title = 'Shopgrade – AI content optimization for Unas, Shoprenter & WooCommerce stores | Content Ninja';
const description =
  'Shopgrade pulls your existing product descriptions and category pages, rewrites them with AI into SEO-friendly, sales-focused copy, then uploads them back to your store – thousands of products at once, and new products automatically. Works with Unas, Shoprenter and WooCommerce.';
---

<BaseLayout locale={locale} page={page} title={title} description={description} ogImage="/assets/og-shopgrade.jpg" lpEnabled>
  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: transparent;
            border: 1.5px solid #6c5ce7;
            color: #6c5ce7;
            padding: 14px 28px;
            border-radius: 10px;
            transition: background 0.2s ease;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-secondary:hover {
            background-color: rgba(108, 92, 231, 0.08);
        }

        .cta-primary .material-symbols-outlined,
        .cta-secondary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Shared header – collapses to logo + language switcher in lp-mode (?type=ld) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + lead form -->
    <section id="hero" class="hero-gradient py-12 md:py-16 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        AI product and category page writer
                        <span class="text-primary">for webshops</span>
                    </h1>

                    <!-- Supported platforms -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Supported platforms:</span>
                        <PlatformLogos cap="writeBack" variant="pill" />
                    </div>

                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        It pulls your existing product descriptions and category page copy, rewrites them into
                        <span class="font-bold text-primary">SEO- and GEO-friendly</span>, sales-focused copy, then
                        <span class="font-bold text-primary">uploads them back</span> to your store.
                    </p>

                    <ul class="space-y-3.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>SEO- and GEO-friendly:</strong> Google and AI answers (ChatGPT, Gemini) can
                                both work from your copy</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Works only from your store's own data</strong> – it doesn't invent facts</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span>Up to <strong>thousands of products</strong> in one run – no export-import</span>
                        </li>
                    </ul>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark"><span data-count="100" data-count-ms="3000">100</span>+ webshops</span> already use it</p>
                    </div>

                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h3 class="text-2xl font-bold text-center mb-2 text-primary">Book an online demo</h3>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">In the demo we run it
                                    on your own product descriptions</strong> – live, on products from your real
                                    catalog. There's no self-service trial.</p>
                            </div>
                        </div>

                        <form id="leadForm" class="space-y-4 max-h-[500px] overflow-hidden pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Which store platform do you
                                            use?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="UNAS">UNAS</option>
                                            <option value="Shoprenter">Shoprenter</option>
                                            <option value="WooCommerce">WooCommerce</option>
                                            <option value="Egyéb" data-reject="hard">Other</option>
                                            <option value="Csak tervezek webshopot indítani" data-reject="soft">I'm only planning to
                                                launch a store</option>
                                            <option value="Más típusú vállalkozásom van" data-reject="hard">I run a different type of
                                                business</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">How many products do you
                                            have in your store?</label>
                                        <select name="product_count" id="productCount"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Under 100">Under 100</option>
                                            <option value="100-1,000">100–1,000</option>
                                            <option value="1,000-10,000">1,000–10,000</option>
                                            <option value="Over 10,000">Over 10,000</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Who writes your product and
                                            category page copy today?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Me, as the business owner">Me, as the business owner</option>
                                            <option value="In-house marketing team">In-house marketing team</option>
                                            <option value="External agency">External agency</option>
                                            <option value="Nobody – we use the manufacturer's text">Nobody – manufacturer
                                                text on products, empty categories</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">If you like what you see in
                                            the demo, when could you start using the software?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Right away">Right away</option>
                                            <option value="Within 1 month">Within 1 month</option>
                                            <option value="Within 2-3 months" data-reject="soft">Within 2-3 months</option>
                                            <option value="Just exploring for now" data-reject="soft">Just exploring for now</option>
                                        </select>
                                    </div>
                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Continue
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h4 class="text-xl font-bold text-dark">Thanks for your interest!</h4>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Based on your answers, it looks like our platform wouldn't be the right fit for
                                        you. We don't want to take up your time – thank you for understanding!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen (timing not ideal) -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h4 class="text-xl font-bold text-dark">Thanks for your interest!</h4>
                                        <p class="text-body leading-relaxed text-sm">
                                            We can only offer live demos to those who want to start using the system
                                            right away. Let's stay in touch in the meantime – we'd be happy to send you a
                                            <strong>video demo</strong>.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email address</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            I have read, understood and accept the
                                            <a href="/en/privacy-policy/" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            I'm interested in content like this! Sign me up for the newsletter.
                                            (<a href="/en/privacy-policy/"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject(this)"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Send me the video
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h4 class="text-xl font-bold text-dark">Got it!</h4>
                                    <!-- Two variants: the "updates" half is only true if they also asked for the
                                         newsletter. The video goes out either way – the script picks one. -->
                                    <p data-thanks="plain" class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send over the demo video within a few minutes. Thanks for your interest!
                                    </p>
                                    <p data-thanks="newsletter" class="hidden text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send over the demo video within a few minutes, and we'll keep you posted on the latest updates. Thanks for your interest!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Name</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. John Smith">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Business email
                                            address</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Phone number</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+1 555 123 4567">
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="privacy" required
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="privacy">
                                            I have read, understood and accept the
                                            <a href="/en/privacy-policy/" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="newsletter" name="newsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="newsletter">
                                            I'm interested in content like this! Sign me up for the newsletter.
                                            (<a href="/en/privacy-policy/"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-4">
                                        <button type="button" onclick="nextStep(1)"
                                            class="flex-shrink-0 hidden md:flex items-center justify-center rounded-[10px] h-12 px-4 border-2 border-border text-body text-base font-bold hover:bg-light transition-all">
                                            <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                                            Back
                                        </button>
                                        <button type="submit" id="submitBtn"
                                            class="flex-1 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                            Continue to booking!
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hitelesitesek: Meta Tech Provider + UNAS partner (kozos komponens) -->
    <TrustBadges locale={locale} />

    <!-- 1/b. Before / after – PRODUCT PAGE. Left: the point in 3 bullets; right: slider with realistic DEMO-store images (fictional store, public/assets/shopgrade-demo-*). The "design" bullet is backed by app shopgrade-design-html + shopgrade-design-patterns. -->
    <section class="bg-light py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <div>
                    <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Product page – before / after ✍️</span>
                    <h2 class="text-3xl md:text-4xl font-bold mb-8 text-dark leading-tight">Turbocharge your product descriptions</h2>
                    <ul class="space-y-6 mb-10">
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">trending_up</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Boosts sales</h3>
                                <p class="text-body leading-relaxed">Buyers aren't looking for parameters but for answers: what it's for, who it suits, how it differs. If the description gives them that, they don't move on to the next store.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">palette</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Not just copy – design too</h3>
                                <p class="text-body leading-relaxed">Both the short and the long description can get a design: a highlight box, benefit cards, a spec table. Pick one of four ready-made patterns, or show us your own.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">travel_explore</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Google and AI find you</h3>
                                <p class="text-body leading-relaxed">Subheadings, natural keywords, an SEO title and description. ChatGPT and Gemini work from exactly this kind of factual, well-structured copy when they recommend products.</p>
                            </div>
                        </li>
                    </ul>
                    <a href="#hero" class="cta-primary px-8 py-4 text-base">See it on my own products</a>
                </div>

                <div class="max-w-[560px] w-full mx-auto">
                    <BeforeAfterSlider media beforeLabel="Before" afterLabel="After" ariaLabel="Before–after slider: product page"
                        hint="Demo store. Drag the line: before on the left, after on the right.">
                        <img slot="before" src="/assets/shopgrade-demo-en-termek-elotte.webp?v=2" alt="Demo store product page before: the thermos description is a single line of manufacturer data" width="960" height="1350" loading="lazy" draggable="false" class="block w-full h-auto">
                        <img slot="after" src="/assets/shopgrade-demo-en-termek-utana.webp?v=2" alt="The same product page after Shopgrade: a designed short description next to the cart button, then a highlight header, four benefit cards and a spec table" width="960" height="1350" loading="lazy" draggable="false" class="block w-full h-auto">
                    </BeforeAfterSlider>
                </div>
            </div>
        </div>
    </section>

    <!-- 1/c. Before / after – CATEGORY PAGE. Same layout as the product page. -->
    <section class="bg-card py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <div class="lg:order-2">
                    <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Category page – before / after 📁</span>
                    <h2 class="text-3xl md:text-4xl font-bold mb-8 text-dark leading-tight">Your category page finally helps people choose</h2>
                    <ul class="space-y-6 mb-10">
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">trending_up</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Boosts sales</h3>
                                <p class="text-body leading-relaxed">Someone who can't decide which one to buy doesn't buy. The copy tells them what to choose by – so they decide in your store, not somewhere else.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">article</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Short and long description</h3>
                                <p class="text-body leading-relaxed">The short one goes above the product list: the gist in two or three sentences. The long one goes below it: with subheadings, answering what buyers ask with real numbers from your range.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-4">
                            <div class="w-11 h-11 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-primary text-[22px]">travel_explore</span>
                            </div>
                            <div class="pt-0.5">
                                <h3 class="font-bold text-dark text-lg leading-snug">Google and AI find you</h3>
                                <p class="text-body leading-relaxed">Your category page is one of the most visited pages in your store. It also gets an SEO title and description, written for what buyers actually search for.</p>
                            </div>
                        </li>
                    </ul>
