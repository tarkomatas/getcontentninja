---
/*
 * ARCHÍV PÉLDÁNY — az ÁSZF 1.1. verziójának befagyasztott másolata.
 *
 * A <BaseLayout> alatti szöveget SOHA ne szerkeszd: ennek az a célja, hogy egy
 * későbbi vitában megállapítható legyen, mit fogadott el a Felhasználó (az app
 * a profiles.terms_version mezőben ezt a verziószámot tárolja).
 * Új verzió = ÚJ fájl (v1-2.astro), nem ennek az átírása.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { pathFor } from '../../../i18n/routes';

const locale = 'en';
const page = 'terms';
const title = 'Terms of Service – Content Ninja · 1.1';
const description =
  'Terms of Service governing the business use of the Content Ninja AI content generation, publishing and newsletter service, including the Annex on data processing.';

// Kereszthivatkozások MINDIG az azonos nyelvű dokumentumra (brief §6.6).
const privacy = pathFor('privacy', locale);
const dataDeletion = pathFor('dataDeletion', locale);
const termsHu = '/hu/aszf/v1-1/';
const archiveCanonical = new URL('/en/terms/v1-1/', Astro.site!).href;
---

<BaseLayout locale={locale} page={page} title={title} description={description}
  noindex canonical={archiveCanonical}>
  <Header locale={locale} page={page} />

  <main class="py-20 md:py-28 px-4 md:px-10">
        <div class="max-w-[760px] mx-auto">

            <div class="rounded-[12px] border border-primary/30 bg-primary/5 px-5 py-4 mb-8">
                <p class="text-sm text-dark font-bold">Permanent copy of version 1.1 of the Terms.</p>
                <p class="text-sm text-body mt-1 leading-relaxed">This text is
                    <strong class="text-dark">effective from 15 September 2026</strong>. The copy is preserved as a
                    permanent reference so that a later version cannot overwrite it. The Terms currently in force
                    are available at <a href="/en/terms/" class="text-primary underline">/en/terms/</a>.</p>
            </div>

            <a href="/en/"
                class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-primary transition-colors mb-8">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                Back to homepage
            </a>

            <div class="mb-10">
                <h1 class="text-3xl md:text-4xl font-extrabold mb-2">Terms of Service</h1>
                <p class="text-sm text-muted">Version 1.1 · Published: 29 August 2026 · Effective: 15 September
                    2026</p>
                <p class="text-sm text-muted mt-1">Version 1.1 adds the fee, term and AI credit allowance of the
                    annual subscription plan, the rules on coupon discounts and the trial period, the rules on
                    cancellation and changing plans, and the exclusion of refunds (Sections 4 and 5). The previous version 1.0 was in force from 20 August 2026 to 14 September 2026.</p>
                <p class="text-sm text-muted mt-2">
                    These Terms are drawn up in Hungarian and English. In case of any discrepancy, the
                    <a href={termsHu} class="text-primary underline">Hungarian text</a> prevails.
                </p>
            </div>

            <div class="bg-card rounded-[16px] border border-border shadow-card divide-y divide-border">

                <!-- 1. -->
                <div class="p-8 doc-section">
                    <h2>1. Service Provider details</h2>
                    <dl class="space-y-2 text-sm">
                        <div class="flex flex-col sm:flex-row sm:gap-4">
                            <dt class="text-muted w-44 shrink-0">Company name</dt>
                            <dd class="text-dark font-medium">Digitallwork.hu Kft.</dd>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:gap-4">
                            <dt class="text-muted w-44 shrink-0">Registered office</dt>
                            <dd class="text-dark font-medium">1118 Budapest, Pálinkás Antal u. 3/A FSZ/8, Hungary</dd>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:gap-4">
                            <dt class="text-muted w-44 shrink-0">Company registration no.</dt>
                            <dd class="text-dark font-medium">01-09-426906</dd>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:gap-4">
                            <dt class="text-muted w-44 shrink-0">Tax number</dt>
                            <dd class="text-dark font-medium">32489819-2-43</dd>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:gap-4">
                            <dt class="text-muted w-44 shrink-0">E-mail</dt>
                            <dd><a href="mailto:support@getcontentninja.com">support@getcontentninja.com</a></dd>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:gap-4">
                            <dt class="text-muted w-44 shrink-0">Phone</dt>
                            <dd><a href="tel:+36202838831">+36 20 283 8831</a></dd>
                        </div>
                    </dl>
                    <p class="mt-4">These Terms of Service (the “Terms”) govern the use of the Content Ninja service
                        (the “Service”) provided by Digitallwork.hu Kft. (the “Provider”, “we”). By registering for or
                        using the Service, you (the “User”) agree to be bound by these Terms.</p>
                </div>

                <!-- 2. -->
                <div class="p-8 doc-section">
                    <h2>2. Description of the Service</h2>
                    <p>2.1. Content Ninja is a software-as-a-service (SaaS) product that uses artificial intelligence
                        to create marketing content for online stores and publishes it, on the schedule set by the
                        User, to the channels the User has connected. In particular, the Service allows the User to:</p>
                    <ul>
                        <li>a) create <strong class="text-dark">social media content</strong> (text, images, animation,
                            video, narrated video) and publish it — on a schedule or immediately — to the Facebook
                            Pages and Instagram business accounts connected by the User;</li>
                        <li>b) create and send <strong class="text-dark">newsletters</strong> through the User’s
                            <strong class="text-dark">own newsletter provider account</strong> (currently MailerLite or
                            SalesAutopilot);</li>
                        <li>c) create and publish <strong class="text-dark">blog articles</strong> to the blog of the
                            User’s <strong class="text-dark">own webshop</strong> (currently UNAS or Shoprenter);</li>
                        <li>d) <strong class="text-dark">rewrite product descriptions and category page copy</strong>
                            and, upon the User’s approval, write them back to the User’s webshop;</li>
                        <li>e) create <strong class="text-dark">advertising creatives</strong> (copy and visuals);
                            placing the advertisement on the ad platform is the User’s task — the Service does not
                            publish advertisements;</li>
                        <li>f) perform <strong class="text-dark">keyword and topic research</strong>, manage knowledge
                            sources, use the marketing calendar, and view the performance statistics and comments of
                            published content;</li>
                        <li>g) use the <strong class="text-dark">AI assistant (“Ninja AI”)</strong>, which performs
                            operations inside the Service on the User’s instruction and stores the information needed
                            for that work.</li>
                    </ul>
                    <p class="mt-2">2.2. The features under points b)–d) <strong class="text-dark">write into the
                        User’s own external systems</strong> (webshop, newsletter provider). The Provider performs
                        these operations solely on the User’s instruction and with the User’s approval.</p>
                    <p class="mt-2">2.3. The Service is provided exclusively online, through the web interface made
                        available by the Provider at <a href="https://app.getcontentninja.com" target="_blank"
                            rel="noopener">app.getcontentninja.com</a>.</p>
                    <p class="mt-2">2.4. The Provider may improve, extend or otherwise modify individual features of
                        the Service over time, provided that the essential character of the Service is preserved
                        during a paid subscription period.</p>
                </div>

                <!-- 3. -->
                <div class="p-8 doc-section">
                    <h2>3. Registration and user account</h2>
                    <p>3.1. Use of the Service requires registration. The contract between the Provider and the User
                        is concluded when the User registers and starts a subscription, thereby accepting these
                        Terms.</p>
                    <p class="mt-2">3.2. The Service may be used <strong class="text-dark">for business purposes
                        only</strong>. Only a <strong class="text-dark">legal entity, sole proprietor or other
                        organisation</strong> using the Service within its trade, business, craft or profession may be
                        a User. The Service is not available to consumers.</p>
                    <p class="mt-2">3.3. By registering, the User <strong class="text-dark">declares that it is not
                        acting as a consumer</strong> and that it is authorised to conclude a contract on behalf of
                        the business it represents. The User must provide the business details required for invoicing
                        (business name, registered address, tax number).</p>
                    <p class="mt-2">3.4. If it later transpires that the User does not meet the conditions of Section
                        3.2, the Provider may terminate the contract with immediate effect and close the account. This
                        does not affect any rights the User has under mandatory law.</p>
                    <p class="mt-2">3.5. The User must provide accurate and up-to-date information during registration
                        and keep it current.</p>
                    <p class="mt-2">3.6. The User is responsible for the security of their account and for all
                        activity carried out through it. Login credentials must be kept confidential and must not be
                        shared with third parties. The User must notify the Provider without delay if they suspect
                        unauthorised access to their account.</p>
                </div>

                <!-- 4. -->
                <div class="p-8 doc-section">
                    <h2>4. Subscription, fees and payment</h2>
                    <p>4.1. The Service is offered on a subscription basis in several tiers and in
                        <strong class="text-dark">two billing cycles — as a monthly or as an annual
                        subscription</strong>. Each subscription includes access to the system and the allowance
                        of AI credits belonging to the chosen tier.</p>
                    <p class="mt-2">4.2. The subscription fees are:</p>
                    <ul>
                        <li>a) <strong class="text-dark">monthly subscription</strong>: HUF 34,990 + VAT per month;</li>
                        <li>b) <strong class="text-dark">annual subscription</strong>: HUF 349,900 + VAT per year
                            (HUF 444,373 gross).</li>
                    </ul>
                    <p class="mt-2">The amounts above reflect the Provider’s list price in force from time to time.
                        The Provider may also agree an individual monthly fee; in that case the fee for the annual
                        subscription is <strong class="text-dark">ten times</strong> the individually agreed monthly
                        fee.</p>
                    <p class="mt-2">4.3. The <strong class="text-dark">annual subscription covers a single,
                        uninterrupted subscription term of 12 months</strong>, the fee for which the Provider invoices
                        <strong class="text-dark">in one lump sum, in advance</strong>, at the start of the term and
                        upon each renewal. The fee for the monthly subscription is likewise invoiced in advance, on a
                        monthly basis.</p>
                    <p class="mt-2">4.4. The applicable fees are shown on the pricing page and at checkout. As the
                        Service is available to businesses only, prices are indicated as
                        <strong class="text-dark">net amounts</strong> plus VAT at the applicable rate. The Provider
                        issues an <strong class="text-dark">electronic invoice</strong> for each payment and sends it
                        by e-mail.</p>
                    <p class="mt-2">4.5. The subscription <strong class="text-dark">renews automatically</strong> at
                        the end of each subscription term — monthly subscriptions every month, annual subscriptions
                        every twelve months — unless the User cancels it before the end of the term (see Section 5).</p>
                    <p class="mt-2">4.6. Payment is processed by the payment provider Stripe. The Provider does not
                        store or process card or payment data; such data is handled exclusively by Stripe.</p>
                    <p class="mt-2">4.7. <strong class="text-dark">Coupon codes.</strong> From time to time the
                        Provider may offer coupon-code discounts that reduce the fee for the first subscription
                        period. A coupon code grants a <strong class="text-dark">discount fixed in Hungarian
                        forints</strong>, the value of which the Provider calculates from
                        <strong class="text-dark">the monthly list price</strong> — or, where an individual price
                        applies, from the individually agreed monthly fee; that amount is
                        <strong class="text-dark">the same</strong> for a monthly and for an annual subscription. The
                        conditions, amount and validity of coupon codes are determined by the Provider, and a discount
                        can only be claimed by entering a valid coupon code.</p>
                    <p class="mt-2"><strong class="text-dark">Trial period.</strong> The Provider may also issue a
                        coupon code granting a trial period. The trial period lasts
                        <strong class="text-dark">7 days</strong>, during which the User may use
                        <strong class="text-dark">100 credits</strong>, and it is available for both billing cycles.
                        At the end of the trial period the subscription starts according to the cycle chosen and the
                        Provider <strong class="text-dark">invoices the full fee</strong> for that cycle — in the case
                        of an annual subscription, therefore, the full annual fee — unless the User cancels the
                        subscription before the trial period ends. A trial period starts only with a valid trial
                        coupon code.</p>
                    <p class="mt-2">4.8. <strong class="text-dark">The AI credit allowance included in the
                        subscription fee.</strong> The allowance is made available differently depending on the
                        billing cycle:</p>
                    <ul>
                        <li>a) under a <strong class="text-dark">monthly subscription</strong> the allowance is
                            <strong class="text-dark">replenished every month</strong>; unused monthly credits do not
                            roll over to the next month unless the Provider provides otherwise. Exception: switching
                            to an annual subscription, see Section 5.3 a);</li>
                        <li>b) under an <strong class="text-dark">annual subscription</strong> the Provider grants the
                            allowance <strong class="text-dark">in a single lump sum</strong> at the start of the
                            subscription term. The allowance granted is
                            <strong class="text-dark">6,000 credits</strong>, or
                            <strong class="text-dark">6,250 credits</strong> where the subscription was started with a
                            coupon code, which figure includes the 100 credits granted during the trial period. This
                            allowance is <strong class="text-dark">valid for 12 months from the date it is granted,
                            i.e. until the end of the subscription term</strong>, and within that term the User may
                            use it freely, at their own pace, with no monthly cap. Credits left unused from the
                            allowance expire at the end of the subscription term and do not roll over into the
                            renewed term.</li>
                    </ul>
                    <p class="mt-2">Where an individual monthly allowance has been agreed, the annual allowance is
                        <strong class="text-dark">twelve times</strong> that monthly allowance.</p>
                    <p class="mt-2">4.9. The User may purchase extra credits in addition to the allowance included in
                        the subscription fee. Extra credits are valid for 365 days from the date of purchase and
                        expire unused thereafter. If the subscription is cancelled, unused extra credits are also
                        forfeited at the end of the subscription period.</p>
                    <p class="mt-2">4.10. The User can review their current credit balance, credit usage history and
                        the expiry date of credits at any time in the Usage section of the Content Ninja
                        interface.</p>
                    <p class="mt-2">4.11. If the User has used up the allowance included in the subscription fee and
                        does not purchase extra credits, the AI-based content generation features are unavailable
                        until the next allowance becomes available — until the start of the next month under a monthly
                        subscription, and until the renewal of the subscription term under an annual subscription.
                        Other, non-AI features of the system remain available.</p>
                    <p class="mt-2">4.12. The Provider may change the subscription fee and the content of the
                        subscription tiers. Such a change does not affect a billing period that has already started
                        and been paid for. The Provider will notify the User by e-mail
                        <strong class="text-dark">at least 30 days</strong> before the change takes effect. If the
                        User does not accept the change, they may cancel their subscription before it takes effect;
                        failing to cancel and paying the fee for the next period constitutes acceptance of the
                        change.</p>
                </div>

                <!-- 5. -->
                <div class="p-8 doc-section">
                    <h2>5. Cancellation, changing plans and refunds</h2>
                    <p>5.1. The User may <strong class="text-dark">cancel their subscription at any time</strong>,
                        without giving reasons, from the Content Ninja interface.</p>
                    <p class="mt-2">5.2. Cancellation <strong class="text-dark">takes effect on the last day of the
                        subscription term already paid for</strong>. Until that date the User’s account remains active
                        and the Service may be used in full and without restriction. In the case of an annual
                        subscription this means that the cancellation takes effect at the end of the 12-month term
                        paid for.</p>
                    <p class="mt-2">5.3. <strong class="text-dark">Changing plans.</strong> The User may switch between
                        the monthly and the annual subscription as follows:</p>
                    <ul>
                        <li>a) a switch <strong class="text-dark">from a monthly to an annual subscription</strong>
                            takes effect immediately; the Provider credits the unused, pro-rata portion of the fee for
                            the month already started against the fee of the annual subscription. Any
                            <strong class="text-dark">monthly credit allowance left unused</strong> at the time of the
                            switch <strong class="text-dark">is not forfeited</strong>: the Provider extends its
                            expiry to the end of the new annual subscription term, so that it is available to the User
                            in addition to the annual allowance under Section 4.8 b);</li>
                        <li>b) a switch <strong class="text-dark">from an annual to a monthly subscription</strong>
                            takes effect only from the next renewal date, i.e. upon expiry of the 12-month term paid
                            for; no pro-rata portion of the annual fee is credited or refunded.</li>
                    </ul>
                    <p class="mt-2">5.4. <strong class="text-dark">Exclusion of refunds.</strong> Subscription fees
                        already paid are <strong class="text-dark">non-refundable, in whole or in part</strong>. This
                        also applies to the fee for an annual subscription paid in one lump sum in advance, including
                        where the User cancels before the end of the subscription term or does not use, or only partly
                        uses, the Service during that term.</p>
                    <p class="mt-2">5.5. <strong class="text-dark">Legal basis for the exclusion of refunds.</strong>
                        Under Section 3.2 the Service may be used for business purposes only: the User is a legal
                        entity, sole proprietor or other organisation using the Service within its trade, business,
                        craft or profession. The User therefore <strong class="text-dark">does not qualify as a
                        consumer</strong> within the meaning of Section 8:1 (1) point 3 of Act V of 2013 on the Civil
                        Code, and consequently <strong class="text-dark">is not entitled to the fourteen-day right of
                        withdrawal and termination available to consumers</strong> under
                        <strong class="text-dark">Government Decree 45/2014 (II. 26.)</strong> on the detailed rules of
                        contracts between consumers and businesses. That decree does not apply to this contract.</p>
                    <p class="mt-2">5.6. This Section 5 does not affect any rights the User has under mandatory
                        law.</p>
                </div>

                <!-- 6. -->
                <div class="p-8 doc-section">
                    <h2>6. Acceptable use</h2>
                    <p>6.1. The User must use the Service lawfully, for its intended purpose and in compliance with
                        all applicable legislation.</p>
                    <p class="mt-2">6.2. It is prohibited to generate, upload or publish through the Service any
                        content that is unlawful, misleading or deceptive, constitutes spam, infringes the
                        intellectual property or other rights of third parties, or violates the policies of the
                        platforms to which content is published — in particular the Meta Terms of Service, Community
                        Standards, Advertising Standards and Platform Terms applicable to Facebook and Instagram.</p>
                    <p class="mt-2">6.3. The User is solely responsible for the content they generate, approve and
                        publish through the Service, including its accuracy and legal compliance.</p>
                    <p class="mt-2">6.4. It is prohibited to reverse-engineer, copy or resell the Service, to
                        circumvent its technical limitations (including credit limits), or to abuse it in any other
                        way. The Provider may suspend or restrict accounts engaged in such conduct.</p>
                    <p class="mt-2">6.5. <strong class="text-dark">Sending newsletters.</strong> Where the User sends
                        newsletters or other electronic marketing through the Service,
                        <strong class="text-dark">the User is solely responsible</strong> for ensuring that recipients
                        are on the list with valid, demonstrable consent, that an unsubscribe option is provided, and
                        that the sending complies with the GDPR, Hungarian Act XLVIII of 2008 on the basic conditions
                        of commercial advertising and Act CVIII of 2001 on electronic commerce services. The Provider
                        does not verify, and is not obliged to verify, the origin of mailing lists. Abusive sending
                        constitutes a material breach of these Terms.</p>
                    <p class="mt-2">6.6. <strong class="text-dark">Writing to external systems.</strong> Publishing
                        blog articles and updating product descriptions and category pages
                        <strong class="text-dark">modify data in the User’s own webshop</strong>. These operations are
                        triggered solely by the User’s approval; the User is responsible for the content written back
                        or published, for its accuracy and for its legal compliance. The Provider recommends that the
                        User back up their webshop before any large-scale modification.</p>
                    <p class="mt-2">6.7. <strong class="text-dark">Third-party personal data.</strong> Where the User
                        uploads material containing personal data (e.g. photographs, mailing lists, customer data) to
                        the Service or connects it from an external system, the User
                        <strong class="text-dark">warrants that it has an appropriate legal basis and
                        authorisation</strong> to do so and that it has properly informed the data subjects.</p>
                </div>

                <!-- 7. -->
                <div class="p-8 doc-section">
                    <h2>7. Third-party platforms</h2>
                    <p>7.1. Publishing to Facebook and Instagram requires the User to connect their own social media
                        accounts or pages to the Service. Use of these platforms is additionally subject to the
                        respective platform operator’s own terms and policies (in the case of Facebook and Instagram,
                        those of Meta Platforms), which the User must accept and comply with independently of these
                        Terms. Certain features of the Service connect to further external accounts of the User: the
                        webshop platform (currently UNAS or Shoprenter) and the newsletter provider (currently
                        MailerLite or SalesAutopilot). The use of these systems is also subject to the respective
                        provider’s own terms, which the User accepts and complies with independently. The Provider is
                        not liable for the availability, operation or interface changes of these systems.</p>
                    <p class="mt-2">7.2. The Provider is not affiliated with, endorsed by or sponsored by Meta
                        Platforms or any other platform operator.</p>
                    <p class="mt-2">7.3. The Provider assumes no responsibility for the availability of third-party
                        platforms, for changes to their interfaces, APIs, terms or policies, or for any restriction
                        or suspension of the User’s platform accounts. Such events do not constitute a defect of the
                        Service.</p>
                </div>

                <!-- 8. -->
                <div class="p-8 doc-section">
                    <h2>8. Intellectual property and generated content</h2>
                    <p>8.1. The Content Ninja software, its interface, source code, design and trademarks are the
                        exclusive intellectual property of the Provider. The subscription grants the User a limited,
                        non-exclusive, non-transferable right to use the Service; no other rights are transferred.</p>
                    <p class="mt-2">8.2. Content generated with the Service (texts, images, posts) belongs to the
                        User. The User may use the generated content for any purpose without restriction, including
                        commercial use.</p>
                    <p class="mt-2">8.3. The Provider claims no ownership of content uploaded by the User or generated
                        with the help of the Service. The Provider processes such content solely to the extent
                        necessary to provide the Service.</p>
                    <p class="mt-2">8.4. <strong class="text-dark">Marking of AI-generated content.</strong> The
                        Provider marks outputs generated by artificial intelligence in a machine-readable format, as
                        far as technically feasible, in accordance with Article 50 of Regulation (EU) 2024/1689 on
                        artificial intelligence. The User acknowledges that, as the publisher of the content,
                        <strong class="text-dark">the User may also be subject to disclosure obligations</strong> (in
                        particular for images or videos that deceptively depict real persons or events, and for text
                        published on matters of public interest), and that complying with those obligations is the
                        User’s responsibility.</p>
                    <p class="mt-2">8.5. <strong class="text-dark">No AI training.</strong> The Provider does
                        <strong class="text-dark">not use the User’s content or data to train artificial intelligence
                        models</strong>, and under the contractual terms applicable to the AI providers used by the
                        Service, those providers do not train on the data submitted by the User either.</p>
                </div>

                <!-- 9. -->
                <div class="p-8 doc-section">
                    <h2>9. Warranties and limitation of liability</h2>
                    <p>9.1. The Provider strives to keep the Service continuously and reliably available but does not
                        undertake an availability guarantee (SLA). The Service is provided “as is” and “as
                        available”, to the extent permitted by applicable law.</p>
                    <p class="mt-2">9.2. The Provider does not warrant the accuracy, completeness or legal compliance
                        of AI-generated content. Reviewing, using and lawfully applying the generated content is the
                        sole responsibility of the User. The Provider is not liable if the User uses generated
                        content for unlawful purposes or in a manner that infringes third-party rights.</p>
                    <p class="mt-2">9.3. The Provider is not liable for errors or outages arising from the operation
                        of third-party services (Stripe, social media platforms, AI providers).</p>
                    <p class="mt-2">9.4. To the extent permitted by law, the Provider’s aggregate liability is in all
                        cases limited to the amount of the subscription fee paid by the affected User in the last one
                        month. Nothing in these Terms excludes or limits liability that cannot be excluded or limited
