                  <td class="px-4 py-3 text-dark font-medium border-l border-r border-border">DataForSEO</td>
                  <td class="px-4 py-3 text-muted border-r border-border">Third country</td>
                  <td class="px-4 py-3 text-body border-r border-border">Retrieving keyword and search data</td>
                </tr>
                <tr class="border-b border-border hover:bg-light/60 transition-colors">
                  <td class="px-4 py-3 text-dark font-medium border-l border-r border-border">MailerLite (UAB MailerLite)</td>
                  <td class="px-4 py-3 text-muted border-r border-border">Lithuania, EU</td>
                  <td class="px-4 py-3 text-body border-r border-border">Newsletter delivery (in the customer's account), managing our own prospect list</td>
                </tr>
                <tr class="border-b border-border hover:bg-light/60 transition-colors">
                  <td class="px-4 py-3 text-dark font-medium border-l border-r border-border">SalesAutopilot Kft.</td>
                  <td class="px-4 py-3 text-muted border-r border-border">Hungary</td>
                  <td class="px-4 py-3 text-body border-r border-border">Newsletter delivery in the customer's account</td>
                </tr>
                <tr class="border-b border-border hover:bg-light/60 transition-colors">
                  <td class="px-4 py-3 text-dark font-medium border-l border-r border-border">Mailjet (Sinch Email)</td>
                  <td class="px-4 py-3 text-muted border-r border-border">France, EU</td>
                  <td class="px-4 py-3 text-body border-r border-border">Transactional e-mail delivery (account, billing and system notifications)</td>
                </tr>
                <tr class="border-b border-border hover:bg-light/60 transition-colors">
                  <td class="px-4 py-3 text-dark font-medium border-l border-r border-border">Fillout, Inc.</td>
