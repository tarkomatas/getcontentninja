                  <td class="px-4 py-3 text-body border-r border-border">Demo booking form</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-dark font-medium border-l border-r border-b border-border rounded-bl-[8px]">Sentry (Functional Software, Inc.)</td>
                  <td class="px-4 py-3 text-muted border-r border-b border-border">EU region</td>
                  <td class="px-4 py-3 text-body border-r border-b border-border rounded-br-[8px]">Error logging</td>
                </tr>
