    <!-- FAQ accordion (global, because we call it from an `onclick` attribute) -->
    <script is:inline>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
    </script>

    <!-- Joins the module checkboxes into a single hidden field so the one-value-per-field
         collector in `LeadFormScript` keeps working unchanged. Above three ticks the
         remaining checkboxes are disabled – so "select everything" isn't an option and the
         answer really states a priority. -->
    <script is:inline>
        (function () {
            var MAX = 3;
            var box = document.getElementById('moduleInterest');
            var field = document.getElementById('moduleInterestValue');
            if (!box || !field) return;

            var boxes = Array.prototype.slice.call(box.querySelectorAll('input[type="checkbox"]'));

            box.addEventListener('change', function () {
                var picked = boxes.filter(function (cb) {
                    return cb.checked;
                });
                field.value = picked
                    .map(function (cb) {
                        return cb.value;
                    })
                    .join(', ');

                var full = picked.length >= MAX;
                boxes.forEach(function (cb) {
                    cb.disabled = full && !cb.checked;
                    var row = cb.closest('label');
                    if (row) row.classList.toggle('opacity-40', cb.disabled);
                });
            });
        })();
    </script>

    <LeadFormScript locale={locale} source="teljes-rendszer" />
