---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';

/**
 * The "all-in-one" campaign landing – English counterpart of /hu/teljes-rendszer/.
 *
 * The OFFER is identical to /en/book-demo/ (free online demo, same form, same
 * qualifying questions, same thank-you page) – on purpose, so the two pages stay
 * comparable. What differs is the HOOK above the fold: not the demo as an event,
 * but the "one system for your whole webshop marketing" promise.
 *
 * Do NOT change the qualifying questions relative to the book-demo page – if they
 * drift apart, the lead quality of the two angles is no longer comparable.
 *
 * The form still sends the Hungarian `lead_forras` key ('teljes-rendszer'); the
 * language travels in the separate `nyelv` field (see `src/data/forms.ts`).
 *
 * `noindex`: same promise as the homepage and same offer as book-demo – it would
 * cannibalise both organically. Paid traffic only; robots.txt disallows it too.
 */
const locale = 'en';
const page = 'allInOne';
const title = 'All-in-one AI marketing system for webshops | Content Ninja';
const description =
  'Posts, blog articles, newsletters and product descriptions in one system: connect your webshop and the AI writes, designs and publishes the content from your own store data. Book a free online demo.';
---

<BaseLayout
  locale={locale}
  page={page}
  title={title}
  description={description}
  ogImage="/assets/og-teljes-rendszer.webp"
  noindex
  lpEnabled
>
  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-primary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Shared header – collapses to logo + language switcher on ?type=ld (lp-mode) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + demo request form -->
    <section id="hero" class="hero-gradient py-12 md:py-24 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        An all-in-one AI marketing system <span class="text-primary">for webshops</span>
                    </h1>
                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        Connect your webshop, and the AI writes, designs and publishes your content from your own
                        store data.
                    </p>

                    <!-- The four content types as chips – the "platform chip" element of the hero
                         formula. The icons match the module icons in `modules.ts` so the same
                         symbols guide the eye down in the module grid. -->
                    <div class="flex flex-wrap gap-2">
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">auto_awesome</span>
                            Post
                        </span>
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">article</span>
                            Blog article
                        </span>
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">mail</span>
                            Newsletter
                        </span>
                        <span class="inline-flex items-center gap-2 bg-card border border-border rounded-[10px] px-3 py-2 shadow-card text-sm font-semibold text-dark">
                            <span class="material-symbols-outlined text-primary text-[18px]">edit_document</span>
                            Product description
                        </span>
                    </div>

                    <!-- Pain point + desire, not a feature list: the features live in the chips
                         and in the module grid below. The check mark still works, because every
                         point states the solved state, not the problem. -->
                    <ul class="space-y-2.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Your Facebook page and blog never go quiet</strong> – the content keeps coming even when you have no time for it</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>No more hopping between five apps</strong> – the post, the article, the newsletter and the product description are made in one place</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Your marketing spend stops growing</strong> – one fixed monthly fee instead of separate tools and a freelance copywriter</span>
                        </li>
                    </ul>

                    <!-- Deep store integration – same as the homepage hero: the connection itself
                         is the proof that every module works from the same data. -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Deep store integration:</span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/unas_logo.png" alt="Unas" class="h-[18px] w-auto" />
                        </span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/shoprenter-logo.png" alt="Shoprenter" class="h-[18px] w-auto" />
                        </span>
                    </div>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ webshops</span> already use it</p>
                    </div>

                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h2 class="text-2xl font-bold text-center mb-2 text-primary">Book an online demo</h2>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">There's no direct
                                    self-trial</strong> – but in an online meeting we'll walk you through the whole
                                    system, even with your own products.</p>
                            </div>
                        </div>

                        <!-- The DISQUALIFYING questions are deliberately identical to /en/book-demo/
                             so the lead quality of the two angles stays comparable. The module
                             question is on top of that: it carries no `data-reject`, so it does not
                             affect qualification – it only tells sales what to focus the demo on. -->
                        <!-- The other campaign pages cap the form with `max-h-[500px] overflow-hidden`,
                             because four questions fit in step 1 there. Here there are five plus the
                             module checkboxes, and the cap cut off the "Continue" button – hence NO
                             height limit: the card follows its content. -->
                        <form id="leadForm" class="space-y-4 pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Do you have a webshop /
                                            online store?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Yes, I have a webshop">Yes, I have a webshop</option>
                                            <option value="Yes, planning to launch soon" data-reject="soft">Yes, planning to launch
                                                soon</option>
                                            <option value="No, I run a different type of business" data-reject="hard">No, I run a different
                                                type of business</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">How advanced is your
                                            company in marketing?</label>
                                        <select name="marketing_level" id="marketingLevel"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="We know nothing about the topic" data-reject="hard">We know nothing about the
                                                topic</option>
                                            <option value="Beginner, minimal knowledge">Beginner, minimal
                                                knowledge</option>
                                            <option value="Intermediate">Intermediate</option>
                                            <option value="Pro">Pro</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Who currently handles your
                                            marketing?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Me, as the business owner">Me, as the business owner</option>
                                            <option value="In-house marketing team">In-house marketing team</option>
                                            <option value="External agency">External agency</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">If you like what you see in
                                            the demo, when could you start using the software?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Right away">Right away</option>
                                            <option value="Within 1 month">Within 1 month</option>
                                            <option value="Within 2-3 months" data-reject="soft">Within 2-3 months</option>
                                            <option value="Just exploring for now" data-reject="soft">Just exploring for now</option>
                                        </select>
                                    </div>
                                    <!-- Module interest: multiple choice. The collector reads ONE value per
                                         field, so the checkboxes are joined into a hidden `module_interest`
                                         field – that keeps the `LeadFormScript` contract untouched. The
                                         hidden field stays empty until something is ticked, so the
                                         "answer every question" check makes it mandatory by itself.
                                         The VALUES are Hungarian on purpose: they land in the same admin
                                         column as the /hu/ page's answers, so both can be filtered as one. -->
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Which module interests you
                                            most? <span class="font-normal text-muted">(up to 3)</span></label>
                                        <div id="moduleInterest"
                                            class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 rounded-[10px] border border-border bg-light p-3 shadow-card">
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Automata posztolás"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Automated posting</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Blogcikk író"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Blog writer</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Termékleírás írás (Shopgrade)"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Product descriptions</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="AI hírlevél"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>AI newsletter</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Kép- és videógenerálás"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>Image and video generation</span>
                                            </label>
                                            <label class="flex items-start gap-2 text-sm text-body cursor-pointer">
                                                <input type="checkbox" value="Nemzetközi terjeszkedés"
                                                    class="mt-0.5 rounded text-primary focus:ring-primary">
                                                <span>International expansion</span>
                                            </label>
                                        </div>
                                        <input type="hidden" name="module_interest" id="moduleInterestValue">
                                    </div>

                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Continue
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h3 class="text-xl font-bold text-dark">Thanks for your interest!</h3>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Based on your answers, it looks like our platform wouldn't be the right fit for
                                        you. We don't want to take up your time – thank you for understanding!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen (timing not ideal) -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h3 class="text-xl font-bold text-dark">Thanks for your interest!</h3>
                                        <p class="text-body leading-relaxed text-sm">
                                            We can only offer demos to people who want to start using the system right
                                            away. Let's stay in touch in the meantime – we'd be happy to send you a
                                            <strong>video walkthrough</strong>.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email address</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            I have read, understood and accepted the
                                            <a href="/en/privacy-policy/" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            I'm interested in more content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy/"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject(this)"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Send me the video
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h3 class="text-xl font-bold text-dark">Got it!</h3>
                                    <!-- Two variants: the "updates" half is only true if they also asked for the
                                         newsletter. The video goes out either way – the script picks one. -->
                                    <p data-thanks="plain" class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send over the demo video within a few minutes. Thanks for your interest!
                                    </p>
                                    <p data-thanks="newsletter" class="hidden text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send over the demo video within a few minutes, and we'll keep you posted
                                        on the latest updates. Thanks for your interest!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Name</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. John Smith">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Company email</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Phone number</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+1 555 123 4567">
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="privacy" required
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="privacy">
                                            I have read, understood and accepted the
                                            <a href="/en/privacy-policy/" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="newsletter" name="newsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="newsletter">
                                            I'm interested in more content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy/"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-4">
                                        <button type="button" onclick="nextStep(1)"
                                            class="flex-shrink-0 hidden md:flex items-center justify-center rounded-[10px] h-12 px-4 border-2 border-border text-body text-base font-bold hover:bg-light transition-all">
                                            <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                                            Back
                                        </button>
                                        <button type="submit" id="submitBtn"
                                            class="flex-1 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                            Continue to booking!
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. The scattered stack – the backbone of the campaign: this is what makes the
         word "all-in-one" MEAN something. Without it the promise is empty marketing. -->
    <section class="bg-card py-20 md:py-28 px-4 md:px-10">
        <div class="max-w-[1000px] mx-auto">
            <div class="text-center max-w-[700px] mx-auto mb-12">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">The situation</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">At ten in the evening, you are your webshop's marketer</h2>
                <p class="text-body text-lg">A separate tool for the copy, the image, the scheduling and the
                    newsletter – and stitching them together is your time.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
                <!-- Today -->
                <div class="bg-red-50/60 rounded-[16px] border-2 border-red-200 p-6 sm:p-8 shadow-card flex flex-col">
                    <h3 class="text-xl font-bold text-dark mb-5 flex items-center gap-2">
                        <span class="material-symbols-outlined text-red-400 text-[24px]">sentiment_dissatisfied</span>
                        How it goes today
                    </h3>
                    <ul class="space-y-3.5 flex-1">
                        <li class="flex items-start gap-3 text-body">
                            <span class="material-symbols-outlined text-red-400 text-[20px] mt-0.5">close</span>
                            <span>You write the post copy in one app</span>
                        </li>
                        <li class="flex items-start gap-3 text-body">
                            <span class="material-symbols-outlined text-red-400 text-[20px] mt-0.5">close</span>
                            <span>You edit an image for it in another, hunting down the product photo by hand</span>
                        </li>
                        <li class="flex items-start gap-3 text-body">
                            <span class="material-symbols-outlined text-red-400 text-[20px] mt-0.5">close</span>
                            <span>You copy it into a third one so it goes out on schedule</span>
