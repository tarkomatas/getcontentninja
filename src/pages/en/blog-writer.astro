---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HowItWorksSteps from '../../components/HowItWorksSteps.astro';
import Header from '../../components/Header.astro';
import HoneypotField from '../../components/HoneypotField.astro';
import LeadFormScript from '../../components/LeadFormScript.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';
import PricingCards from '../../components/PricingCards.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import PlatformLogos from '../../components/PlatformLogos.astro';

const locale = 'en';
const page = 'blogWriter';
const title = 'AI blog writer for webshops – buyers from Google and ChatGPT | Content Ninja';
const description =
  "No time to write a blog? Content Ninja writes about topics people actually search for, and every article leads readers to your products. Free traffic from Google and AI search (ChatGPT, Gemini). Unas, Shoprenter, WooCommerce and WordPress.";

// Positioning, sources and do-not-promise list: see the header comment in src/pages/hu/blogcikk-iro.astro.
const faqs: { q: string; a: string; link?: { href: string; label: string } }[] = [
  {
    q: "How does it know what's worth writing about?",
    a: 'From real search data. The system looks at what people search for on Google in your category – with monthly search volume, a 12-month trend and difficulty – and matches it against your own catalogue. So it suggests topics that have demand and that you have something to sell for. You pick from the suggestions, or hand over your own topic.',
  },
  {
    q: 'Where does the search data come from?',
    a: "From Google search data for your market: monthly search volume, trend, difficulty, Google's \"People also ask\" questions and whether an AI Overview appears for the query. These are measured figures, not AI estimates. If you also connect your Google Search Console, the system takes your own store's searches into account too.",
  },
  {
    q: "Why doesn't it write an article every day, like other AI blog writers?",
    a: "Because a blog isn't made strong by the number of articles. A webshop category has a finite number of questions people genuinely search for; publish a new article every day and you soon get filler articles competing with each other for the same search. Content Ninja starts at two articles a week by default, doesn't even suggest topics with fewer than 10 monthly searches, and skips what you've already covered. You set the pace, of course.",
  },
  {
    q: 'What about my existing articles?',
    a: "It brings those up too. It finds your weakening older articles – ones sitting in Google's positions 8–20, seen by many but clicked by few, losing traffic, or carrying an outdated year in the title – and writes a new version. When published, the refreshed article stays on the same URL, and the previous version can be restored. It works on Unas, Shoprenter and WordPress blogs; most signals need Google Search Console connected.",
  },
  {
    q: 'Can I see which article brings traffic?',
    a: "Yes. Once Google Search Console is connected, the Search view under Analytics shows clicks, impressions, click-through rate and average position, your top queries and top pages – your blog articles included – plus a list of the pages sitting \"almost on page one\". Search analytics doesn't use any credits.",
  },
  {
    q: 'Can I run the blog from a chat?',
    a: 'Yes. The built-in AI assistant, Ninja AI, researches keywords, writes, edits and publishes articles from a chat. It also tells you which old article is worth refreshing. It asks for your approval before it writes or publishes anything.',
  },
  {
    q: 'How is it different from having ChatGPT write an article?',
    a: "ChatGPT writes what you ask for – it doesn't know what your customers search for, what products you have, or where to publish. Content Ninja picks topics from real search data, links your webshop's real product and category pages in the article (made-up links can't get in), writes in your brand voice and publishes to your blog in one click. Then it measures what works and refreshes the articles that weaken.",
  },
  {
    q: 'Which platforms can it publish to? Does it work with WordPress?',
    a: 'It publishes directly to Unas and Shoprenter store blogs, and to any self-hosted WordPress site – with or without a webshop, including sites running WooCommerce. WordPress is connected with the Content Ninja plugin: you install it, click "Connect", then approve in your WordPress admin – no passwords to copy. The post arrives with its featured image, category and filled-in Yoast / Rank Math SEO fields. It can go live now, scheduled or as a draft. Sites hosted on WordPress.com can\'t be connected. If you use another platform, we\'ll look at the options on the demo.',
    link: { href: '/en/store-integration/', label: 'More on deep store integration.' },
  },
  {
    q: 'What is GEO, and why does it matter?',
    a: "GEO (Generative Engine Optimization) means optimizing for AI search engines – ChatGPT, Gemini, Perplexity, Google AI Overviews. They don't return ten blue links; they compose an answer, and they quote factual, well-structured, question-and-answer style content. The articles are built that way so your webshop shows up in those answers too.",
  },
  {
    q: 'Do articles go live automatically?',
    a: 'Only if you want them to. By default you review and approve the finished article before it reaches your blog – and you can edit it. You stay in control throughout.',
  },
  {
    q: 'Do I need SEO knowledge?',
    a: 'No. Keyword research, article structure, meta data and internal linking are all part of the process – you just set the brand voice and target audience once, and approve the topics.',
  },
  {
    q: 'Does the blog writer cost extra?',
    a: "No, it's included in the same 39,990 HUF + VAT / month subscription as the other modules – posting, newsletters, Shopgrade – with 500 renewing AI credits per month. An average article with keyword research, text and three images is about 10 credits, so two articles a week use roughly a fifth of the monthly allowance.",
    link: { href: '/en/pricing/#credits', label: 'Detailed credit rates.' },
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout locale={locale} page={page} title={title} description={description} ogImage="/assets/og-blogcikk.jpg" lpEnabled>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-primary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Shared header – collapses to logo + language switcher on ?type=ld (lp-mode) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + lead form -->
    <section id="hero" class="hero-gradient py-12 md:py-16 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        An AI blog writer <span class="text-primary">for webshops</span> that <span class="text-primary">writes what
                        people search for</span> – and <span class="text-primary">brings buyers</span>
                    </h1>

                    <!-- Supported platforms -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Supported platforms:</span>
                        <PlatformLogos cap="blog" variant="pill" />
                    </div>

                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        You don't have to figure out what to write about, or write it. It writes the article
                        <span class="font-bold text-primary">for Google and ChatGPT</span> alike and publishes it to your blog.
                        All you do is <span class="font-bold text-primary">approve</span>.
                    </p>

                    <ul class="space-y-3.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Topics people search for:</strong> picked from real search data</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Brings old articles back up:</strong> refreshes the weakening ones</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>You see what works:</strong> analytics and a built-in AI assistant</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>9 more modules, one fee:</strong> posting, newsletters and more</span>
                        </li>
                    </ul>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ webshops</span> already use it</p>
                    </div>

                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h3 class="text-2xl font-bold text-center mb-2 text-primary">Free demo on your own webshop</h3>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">A personal demo instead of a trial.</strong> We show you what your
                                    customers search for, and which articles would bring you traffic.</p>
                            </div>
                        </div>

                        <form id="leadForm" class="space-y-4 max-h-[500px] overflow-hidden pr-2 custom-scrollbar relative">
                            <HoneypotField />

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">What webshop or website do you have?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="UNAS">UNAS</option>
                                            <option value="Shoprenter">Shoprenter</option>
                                            <option value="WooCommerce">WooCommerce</option>
                                            <option value="WordPress (webshop nélkül)">WordPress site (no webshop)</option>
                                            <option value="Egyéb" data-reject="hard">Other</option>
                                            <option value="Csak tervezek webshopot indítani" data-reject="soft">I'm only planning to launch
                                                a webshop</option>
                                            <option value="Más típusú vállalkozásom van" data-reject="hard">I have a different type of
                                                business</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Do you publish blog
                                            articles today?</label>
                                        <select name="blog_frequency" id="blogFrequency"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Rendszeresen, havi több cikk">Regularly, several articles a
                                                month</option>
                                            <option value="Ritkán, alkalomszerűen">Rarely, occasionally</option>
                                            <option value="Van blog, de nem frissül">We have a blog, but it is not
                                                updated</option>
                                            <option value="Nincs blogunk">We have no blog</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Who writes your content
                                            today?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Én, cégvezetőként">Me, as the owner</option>
                                            <option value="Belsős marketing csapat">In-house marketing team</option>
                                            <option value="Külsős ügynökség">External agency</option>
                                            <option value="Senki – nem készül tartalom">Nobody – no content is
                                                produced</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">If you like what you see on
                                            the demo, when could you start using the software?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Azonnal">Right away</option>
                                            <option value="1 hónapon belül">Within 1 month</option>
                                            <option value="2-3 hónapon belül" data-reject="soft">Within 2-3 months</option>
                                            <option value="Még csak érdeklődöm" data-reject="soft">Just browsing for now</option>
                                        </select>
                                    </div>
                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Next
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h4 class="text-xl font-bold text-dark">Thanks for your interest!</h4>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Based on your answers, our platform would not be the right fit for you. We don't
                                        want to take up your time – thanks for your understanding!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen (timing not ideal) -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h4 class="text-xl font-bold text-dark">Thanks for your interest!</h4>
                                        <p class="text-body leading-relaxed text-sm">
                                            We can only take demo calls with companies that want to start using the
                                            system right away. Let's stay in touch – we'd be happy to send you a
                                            <strong>video walkthrough</strong> instead.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email address</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            I have read, understood and accepted the
                                            <a href="/en/privacy-policy/" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            I'm interested in content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy/"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject(this)"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Send me the video
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h4 class="text-xl font-bold text-dark">Got it!</h4>
                                    <!-- Two variants: the "updates" half is only true if they also asked for the
                                         newsletter. The video goes out either way – the script picks one. -->
                                    <p data-thanks="plain" class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send over the demo video within a few minutes. Thanks for your interest!
                                    </p>
                                    <p data-thanks="newsletter" class="hidden text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send over the demo video within a few minutes, and we'll keep you posted on the latest updates. Thanks for your interest!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Name</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. John Smith">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Business email</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Phone number</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+36 30 123 4567">
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="privacy" required
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="privacy">
                                            I have read, understood and accepted the
                                            <a href="/en/privacy-policy/" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="newsletter" name="newsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="newsletter">
                                            I'm interested in content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy/"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-4">
                                        <button type="button" onclick="nextStep(1)"
                                            class="flex-shrink-0 hidden md:flex items-center justify-center rounded-[10px] h-12 px-4 border-2 border-border text-body text-base font-bold hover:bg-light transition-all">
                                            <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                                            Back
                                        </button>
                                        <button type="submit" id="submitBtn"
                                            class="flex-1 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                            Continue to booking!
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hitelesitesek: Meta Tech Provider + UNAS partner (kozos komponens) -->
    <TrustBadges locale={locale} />

    <!-- 2. Today vs. with Content Ninja – pain point → desired future. The "article a day" AI blog
         writers are intentionally UNNAMED. Short sentences that make sense on their own. -->
    <section class="bg-card py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center max-w-[720px] mx-auto mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Sound familiar? 🤔</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">You write and write – and still no buyers</h2>
                <p class="text-body text-lg">Most webshop blogs bring no traffic because nobody searches for their topics. AI tools that promise an article a day don't fix that. More articles don't mean more buyers.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-[1000px] mx-auto">
                <div class="bg-light rounded-[16px] border border-border p-6 md:p-8">
                    <h3 class="font-bold text-lg mb-5 text-muted">Today</h3>
                    <ul class="space-y-4 text-sm text-body leading-relaxed">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-red-400 text-[20px] shrink-0">close</span>
                            <span><strong class="text-dark block">The blog is idle</strong>No time to write, no new article for months</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-red-400 text-[20px] shrink-0">close</span>
                            <span><strong class="text-dark block">Guessed topics</strong>Nobody reads them</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-red-400 text-[20px] shrink-0">close</span>
                            <span><strong class="text-dark block">The AI content mill repeats itself</strong>It writes daily, but brings no buyers</span>
                        </li>
