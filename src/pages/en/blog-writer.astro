---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ModuleGrid from '../../components/ModuleGrid.astro';

const locale = 'en';
const page = 'blogWriter';
const title = 'AI blog writer for webshops – keyword research, writing, publishing | Content Ninja';
const description =
  "Content Ninja's Blog writer module researches what your customers search for, writes the SEO- and GEO-friendly article, and publishes it straight to your webshop blog. With Unas and Shoprenter integration.";
---

<BaseLayout locale={locale} page={page} title={title} description={description} lpEnabled>
  <Fragment slot="head">
    <style is:inline>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }

        body {
            margin: 0;
            background-color: #f8f9fb;
            color: #4a4a68;
            letter-spacing: -0.01em;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            color: #1e1e2f;
            letter-spacing: -0.02em;
            font-weight: 700;
        }

        .cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #6c5ce7;
            color: white;
            font-weight: 600;
            padding: 14px 28px;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }

        .cta-primary:hover {
            background-color: #5a4bd6;
        }

        .cta-primary .material-symbols-outlined {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1em;
            height: 1em;
            line-height: 1;
            flex-shrink: 0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

        .form-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero-gradient {
            background: linear-gradient(135deg, #f0eeff 0%, #f8f9fb 60%, #eef6ff 100%);
        }

        .hero-form-card {
            background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
            border: 1.5px solid rgba(108, 92, 231, 0.24);
            box-shadow: 0 18px 55px rgba(30, 30, 47, 0.12), 0 0 0 6px rgba(108, 92, 231, 0.06);
        }

        .hero-form-card:hover {
            border-color: rgba(108, 92, 231, 0.36);
            box-shadow: 0 22px 65px rgba(30, 30, 47, 0.15), 0 0 0 6px rgba(108, 92, 231, 0.08);
        }
    </style>
  </Fragment>

  <div class="relative flex min-h-screen w-full flex-col">
    <!-- Shared header – collapses to logo + language switcher on ?type=ld (lp-mode) -->
    <Header locale={locale} page={page} />

    <!-- 1. Hero + lead form -->
    <section id="hero" class="hero-gradient py-12 md:py-24 px-4 md:px-10 overflow-hidden">
        <div class="max-w-[1200px] mx-auto w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-12 lg:gap-20 items-center">

                <!-- Content -->
                <div class="flex flex-col gap-4 md:gap-7 text-left">

                    <h1 class="text-4xl md:text-[2.85rem] lg:text-5xl font-extrabold leading-[1.08] tracking-[-0.03em] text-dark">
                        An AI blog writer <span class="text-primary">for webshops</span>
                    </h1>

                    <!-- Supported platforms -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-sm font-semibold text-muted">Supported platforms:</span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/unas_logo.png" alt="Unas" class="h-[18px] w-auto" loading="lazy" />
                        </span>
                        <span class="inline-flex items-center bg-card border border-border rounded-[10px] px-3 py-2 shadow-card">
                            <img src="/assets/shoprenter-logo.png" alt="Shoprenter" class="h-[18px] w-auto" loading="lazy" />
                        </span>
                    </div>

                    <p class="text-body text-[1.1rem] font-medium leading-relaxed max-w-[520px]">
                        It researches <span class="font-bold text-primary">what your customers actually search for</span>,
                        writes the SEO- and GEO-friendly article, then
                        <span class="font-bold text-primary">publishes it</span> straight to your webshop blog.
                    </p>

                    <ul class="space-y-3.5 text-body">
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>Keyword research:</strong> the content plan is built from real search data –
                                not guesswork</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>SEO + GEO:</strong> Google and the AI search engines (ChatGPT, Gemini,
                                Perplexity) find and cite you</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[20px] mt-0.5" style="font-variation-settings:'FILL' 1">check_circle</span>
                            <span><strong>One-click publishing</strong> to your webshop blog – linked to your own
                                products</span>
                        </li>
                    </ul>

                    <!-- Social proof mini -->
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-xs font-bold border-2 border-white">Sz</div>
                            <div class="w-8 h-8 rounded-full bg-primary/70 flex items-center justify-center text-white text-xs font-bold border-2 border-white">L</div>
                            <div class="w-8 h-8 rounded-full bg-primary/50 flex items-center justify-center text-white text-xs font-bold border-2 border-white">ÁK</div>
                        </div>
                        <p class="text-sm text-muted"><span class="font-semibold text-dark">50+ webshops</span> already use it</p>
                    </div>

                </div>

                <!-- Form Container -->
                <div class="w-full relative">
                    <div class="hero-form-card relative w-full rounded-[16px] transition-all py-6 px-4 md:py-8 md:px-5">
                        <div id="formIntro">
                            <h3 class="text-2xl font-bold text-center mb-2 text-primary">Book an online demo</h3>
                            <div class="flex items-center gap-2.5 justify-center bg-light border border-primary/15 rounded-[10px] px-4 py-3 mb-3">
                                <span class="material-symbols-outlined text-primary text-[20px] shrink-0">info</span>
                                <p class="text-sm text-body"><strong class="font-bold text-dark">There is no self-serve
                                    trial</strong> – but on an online call we show you exactly which keywords and which
                                    articles the system would write for your webshop.</p>
                            </div>
                        </div>

                        <form id="leadForm" class="space-y-4 max-h-[500px] overflow-hidden pr-2 custom-scrollbar relative">

                            <!-- Step 1: Qualifying Questions -->
                            <div class="form-step active" data-step="1">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">What webshop do you have?</label>
                                        <select name="has_webshop" id="hasWebshop"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="UNAS">UNAS</option>
                                            <option value="Shoprenter">Shoprenter</option>
                                            <option value="Egyéb">Other</option>
                                            <option value="Csak tervezek webshopot indítani">I'm only planning to launch
                                                a webshop</option>
                                            <option value="Más típusú vállalkozásom van">I have a different type of
                                                business</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Do you publish blog
                                            articles today?</label>
                                        <select name="blog_frequency" id="blogFrequency"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Rendszeresen, havi több cikk">Regularly, several articles a
                                                month</option>
                                            <option value="Ritkán, alkalomszerűen">Rarely, occasionally</option>
                                            <option value="Van blog, de nem frissül">We have a blog, but it is not
                                                updated</option>
                                            <option value="Nincs blogunk">We have no blog</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Who writes your content
                                            today?</label>
                                        <select name="marketing_role" id="marketingRole"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Én, cégvezetőként">Me, as the owner</option>
                                            <option value="Belsős marketing csapat">In-house marketing team</option>
                                            <option value="Külsős ügynökség">External agency</option>
                                            <option value="Senki – nem készül tartalom">Nobody – no content is
                                                produced</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">If you like what you see on
                                            the demo, when could you start using the software?</label>
                                        <select name="timing" id="timing"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all">
                                            <option value="" disabled selected>Choose...</option>
                                            <option value="Azonnal">Right away</option>
                                            <option value="1 hónapon belül">Within 1 month</option>
                                            <option value="2-3 hónapon belül">Within 2-3 months</option>
                                            <option value="Még csak érdeklődöm">Just browsing for now</option>
                                        </select>
                                    </div>
                                    <button type="button" onclick="qualifyAndNext()"
                                        class="w-full mt-4 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Next
                                    </button>
                                </div>
                            </div>

                            <!-- Disqualification Screen (hard reject) -->
                            <div class="form-step" data-step="rejected">
                                <div class="text-center py-6 space-y-4">
                                    <h4 class="text-xl font-bold text-dark">Thanks for your interest!</h4>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        Based on your answers, our platform would not be the right fit for you. We don't
                                        want to take up your time – thanks for your understanding!
                                    </p>
                                </div>
                            </div>

                            <!-- Soft Reject Screen (timing not ideal) -->
                            <div class="form-step" data-step="soft-reject">
                                <div class="space-y-5">
                                    <div class="text-center space-y-3">
                                        <h4 class="text-xl font-bold text-dark">Thanks for your interest!</h4>
                                        <p class="text-body leading-relaxed text-sm">
                                            We can only take demo calls with companies that want to start using the
                                            system right away. Let's stay in touch – we'd be happy to send you a
                                            <strong>video walkthrough</strong> instead.
                                        </p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Email address</label>
                                        <input type="email" id="softRejectEmail"
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectPrivacy"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectPrivacy">
                                            I have read, understood and accepted the
                                            <a href="/en/privacy-policy" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>
                                    <div class="flex items-start gap-2 text-xs text-muted ml-1">
                                        <input type="checkbox" id="softRejectNewsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="softRejectNewsletter">
                                            I'm interested in content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>
                                    <button type="button" onclick="submitSoftReject()"
                                        class="w-full flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                        Send me the video
                                    </button>
                                </div>
                            </div>

                            <!-- Soft Reject Thank You Screen -->
                            <div class="form-step" data-step="soft-reject-thanks">
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
                                        <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
                                    </div>
                                    <h4 class="text-xl font-bold text-dark">Got it!</h4>
                                    <p class="text-body leading-relaxed max-w-[400px] mx-auto">
                                        We'll send you the walkthrough video and our latest updates shortly. Thanks for
                                        your interest!
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2: Contact Info & Privacy -->
                            <div class="form-step" data-step="2">
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Name</label>
                                        <input type="text" name="name" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. John Smith">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Business email</label>
                                        <input type="email" name="email" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="e.g. john@company.com">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-bold text-body mb-1">Phone number</label>
                                        <input type="tel" name="phone" required
                                            class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card hover:shadow-card-hover transition-all"
                                            placeholder="+36 30 123 4567">
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="privacy" required
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="privacy">
                                            I have read, understood and accepted the
                                            <a href="/en/privacy-policy" target="_blank"
                                                class="underline hover:text-primary">Privacy Policy</a>.
                                        </label>
                                    </div>

                                    <div class="flex items-start gap-2 text-xs text-muted my-2 ml-1">
                                        <input type="checkbox" id="newsletter" name="newsletter"
                                            class="mt-1 rounded text-primary focus:ring-primary">
                                        <label for="newsletter">
                                            I'm interested in content like this! Subscribe me to the newsletter.
                                            (<a href="/en/privacy-policy"
                                                class="underline hover:text-primary">Privacy Policy</a>)
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-4">
                                        <button type="button" onclick="nextStep(1)"
                                            class="flex-shrink-0 hidden md:flex items-center justify-center rounded-[10px] h-12 px-4 border-2 border-border text-body text-base font-bold hover:bg-light transition-all">
                                            <span class="material-symbols-outlined text-base mr-1">arrow_back</span>
                                            Back
                                        </button>
                                        <button type="submit" id="submitBtn"
                                            class="flex-1 flex items-center justify-center rounded-[10px] h-12 cta-primary transition-all hover:brightness-95">
                                            Continue to booking!
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Why blog -->
    <section class="bg-card py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center max-w-[720px] mx-auto mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Why blog? 🔍</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Your product pages only attract people who already know
                    what they want</h2>
                <p class="text-body text-lg">Most shoppers don't search for a product name – they ask a question, on
                    Google and increasingly in ChatGPT. Blog articles are how you show up there too.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">help</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">You answer the questions</h3>
                    <p class="text-body text-sm leading-relaxed">"Which one is better if…", "how long does it last",
                        "what to look out for when buying" – these searches go to your competitor if you have no article
                        on them.</p>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">smart_toy</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">AI search engines quote articles</h3>
                    <p class="text-body text-sm leading-relaxed">ChatGPT and Gemini don't read out spec sheets – they
                        compose answers from detailed, factual content, and they name the source.</p>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">trending_up</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">You don't have to pay for every visit</h3>
                    <p class="text-body text-sm leading-relaxed">Ads bring traffic only while you pay. A good article
                        keeps working for years – and every new one adds to the last.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. How it works -->
    <section id="hogyan-mukodik" class="bg-light py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">How it works 🛠️</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">From keyword research to publishing – in one place</h2>
                <p class="text-body text-lg">No separate keyword tool, no Google Doc, no copy-pasting into your webshop
                    admin.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card text-center">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mx-auto mb-6 shadow-primary-glow">1</div>
                    <h3 class="font-bold text-lg mb-3">Connect your webshop</h3>
                    <p class="text-body text-sm leading-relaxed">Unas or Shoprenter – a few clicks, and the system sees
                        your products, categories and existing blog.</p>
                </div>
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card text-center">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mx-auto mb-6 shadow-primary-glow">2</div>
                    <h3 class="font-bold text-lg mb-3">Keyword research</h3>
                    <p class="text-body text-sm leading-relaxed">The AI looks at what people search for in your market
                        and suggests topics – ones you actually have products for.</p>
                </div>
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card text-center">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mx-auto mb-6 shadow-primary-glow">3</div>
                    <h3 class="font-bold text-lg mb-3">It writes the article</h3>
                    <p class="text-body text-sm leading-relaxed">A detailed, SEO- and GEO-friendly article in your brand
                        voice, linking to your own products.</p>
                </div>
                <div class="bg-card rounded-[16px] border border-border p-8 shadow-card text-center">
                    <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center text-white text-2xl font-extrabold mx-auto mb-6 shadow-primary-glow">4</div>
                    <h3 class="font-bold text-lg mb-3">Publishing</h3>
                    <p class="text-body text-sm leading-relaxed">You review, you approve – and the article goes live on
                        your webshop blog. No manual copy-paste.</p>
                </div>
            </div>

            <div class="text-center mt-10">
                <a href="#hero" class="cta-primary px-8 py-4 text-base">
                    Book a demo – free
                </a>
            </div>
        </div>
    </section>

    <!-- 4. Keyword research -->
    <section class="bg-card py-20 md:py-28">
        <div class="max-w-[1200px] mx-auto px-4 md:px-10">
            <div class="text-center max-w-[720px] mx-auto mb-14">
                <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Keyword research 🎯</span>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Writing isn't the hard part – deciding what to write
                    about is</h2>
                <p class="text-body text-lg">Most webshop blogs bring no traffic because they cover topics nobody
                    searches for. That's why the system starts with topic selection.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-[900px] mx-auto">
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">query_stats</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Real search data</h3>
                    <p class="text-body text-sm leading-relaxed">No guesswork: the system looks at what people actually
                        search for in your category.</p>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-5">
                        <span class="material-symbols-outlined text-[22px]">forum</span>
                    </div>
                    <h3 class="font-bold text-lg mb-2">Question-based searches</h3>
                    <p class="text-body text-sm leading-relaxed">Exactly the longer, question-shaped queries that AI
                        search engines build their answers from.</p>
                </div>
                <div class="bg-light rounded-[16px] border border-border p-8 shadow-card">
