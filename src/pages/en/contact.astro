---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { pathFor } from '../../i18n/routes';

const locale = 'en';
const page = 'contact';
const title = 'Contact – Content Ninja';
const description =
  'Get in touch with the Content Ninja team: support@getcontentninja.com, company details and a contact form. We reply within 1 business day.';

const bookDemo = pathFor('bookDemo', locale);
const imprint = pathFor('imprint', locale);
const SUPPORT_EMAIL = 'support@getcontentninja.com';
---

<BaseLayout locale={locale} page={page} title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Content Ninja',
      legalName: 'Digitallwork.hu Kft.',
      url: 'https://getcontentninja.com/',
      email: 'support@getcontentninja.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Pálinkás Antal u. 3/A FSZ/8',
        addressLocality: 'Budapest',
        postalCode: '1118',
        addressCountry: 'HU',
      },
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'support@getcontentninja.com',
        availableLanguage: ['hu', 'en'],
      }],
    })} />
  </Fragment>

  <Header locale={locale} page={page} />

  <section class="hero-gradient py-12 md:py-20 px-4 md:px-10">
    <div class="max-w-[1200px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-start">

        <!-- Left: contact details + company data -->
        <div>
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Contact</span>
          <h1 class="text-4xl md:text-[2.6rem] font-extrabold leading-[1.1] tracking-[-0.03em] text-dark mb-4">
            Write to us – we reply <span class="text-primary">within 1 business day</span>
          </h1>
          <p class="text-body leading-relaxed mb-7">We're available on business days, 9:00–17:00 CET.</p>

          <a href={`mailto:${SUPPORT_EMAIL}`} class="flex items-center gap-4 bg-card rounded-[16px] border border-border p-5 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5 mb-4">
            <span class="w-11 h-11 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[20px]">mail</span>
            </span>
            <span class="min-w-0">
              <span class="block text-xs uppercase tracking-wide text-muted font-semibold">Email</span>
              <span class="block text-primary font-bold break-words">{SUPPORT_EMAIL}</span>
            </span>
          </a>

          <div class="bg-card rounded-[16px] border border-border p-5 shadow-card">
            <h2 class="text-sm font-bold text-dark mb-3">Company details</h2>
            <dl class="space-y-1.5 text-sm">
              <div class="flex flex-col sm:flex-row sm:gap-4">
                <dt class="text-muted w-44 shrink-0">Company name</dt>
                <dd class="text-dark font-medium">Digitallwork.hu Kft.</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:gap-4">
                <dt class="text-muted w-44 shrink-0">Registered office</dt>
                <dd class="text-dark font-medium">1118 Budapest, Pálinkás Antal u. 3/A FSZ/8, Hungary</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:gap-4">
                <dt class="text-muted w-44 shrink-0">Company reg. number</dt>
                <dd class="text-dark font-medium">01-09-426906</dd>
              </div>
              <div class="flex flex-col sm:flex-row sm:gap-4">
                <dt class="text-muted w-44 shrink-0">Tax number</dt>
                <dd class="text-dark font-medium">32489819-2-43</dd>
              </div>
            </dl>
            <p class="text-xs text-muted mt-3">
              Further details in the <a href={imprint} class="underline hover:text-primary">imprint</a>.
            </p>
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-card rounded-[16px] border border-border p-5 sm:p-8 shadow-card-hover">
          <h2 class="text-2xl font-bold text-dark mb-5">Send us a message</h2>

          <form id="contactForm" class="space-y-4">
            <div>
              <label for="contactName" class="block text-sm font-bold text-body mb-1">Name</label>
              <input type="text" id="contactName" name="name" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="e.g. John Smith" />
            </div>

            <div>
              <label for="contactEmail" class="block text-sm font-bold text-body mb-1">Email address</label>
              <input type="email" id="contactEmail" name="email" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="e.g. john@company.com" />
            </div>

            <div>
              <label for="contactTopic" class="block text-sm font-bold text-body mb-1">Topic</label>
              <select id="contactTopic" name="topic" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all">
                <option value="" disabled selected>Choose...</option>
                <option value="General product question">General product question</option>
                <option value="Pricing, billing">Pricing, billing</option>
                <option value="Technical support">Technical support</option>
                <option value="Partnership, reselling">Partnership, reselling</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div>
              <label for="contactMessage" class="block text-sm font-bold text-body mb-1">Message</label>
              <textarea id="contactMessage" name="message" rows="4" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="How can we help?"></textarea>
            </div>

            <div class="flex items-start gap-2 text-xs text-muted ml-1">
              <input type="checkbox" id="contactPrivacy" required class="mt-1 rounded text-primary focus:ring-primary" />
              <label for="contactPrivacy">
                I have read and acknowledged the
                <a href="/en/privacy-policy" target="_blank" class="underline hover:text-primary">Privacy Policy</a>.
              </label>
            </div>

            <p id="contactError" class="hidden text-sm text-red-600 leading-relaxed"></p>

            <button type="submit" id="contactSubmit" class="w-full cta-primary h-12 text-base">
              <span class="material-symbols-outlined text-[18px]">send</span>
              Send message
            </button>
          </form>

          <div id="contactSuccess" class="hidden text-center py-8 space-y-3">
            <div class="w-14 h-14 bg-success/10 rounded-full flex items-center justify-center mx-auto">
              <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
            </div>
            <h3 class="text-xl font-bold text-dark">We got your message!</h3>
            <p class="text-body leading-relaxed">We'll reply by email within 1 business day.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-primary py-14 md:py-16 px-4 md:px-10">
    <div class="max-w-[800px] mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Would you rather see the system live?</h2>
      <a href={bookDemo} class="cta-on-primary px-8 py-4 text-base">
        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
        Book a demo
      </a>
    </div>
  </section>

  <Footer locale={locale} page={page} />

  <script is:inline>
    (function () {
      var form = document.getElementById('contactForm');
      if (!form) return;

      var btn = document.getElementById('contactSubmit');
      var errorBox = document.getElementById('contactError');
      var successBox = document.getElementById('contactSuccess');
      var WEBHOOK = 'https://hook.eu1.make.com/ihohtlulor66lvhouyoty9azbut7lzx7';

      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        var privacy = document.getElementById('contactPrivacy');
        if (!privacy.checked) {
          alert('Please accept the privacy policy!');
          return;
        }

        errorBox.classList.add('hidden');
        btn.disabled = true;
        btn.innerHTML = 'Sending...';

        var name = document.getElementById('contactName').value.trim();
        var payload = {
          statusz: 'kapcsolat',
          lead_forras: 'kapcsolat',
          submission_date: new Date().toISOString(),
          nev: name,
          email: document.getElementById('contactEmail').value.trim(),
          tema: document.getElementById('contactTopic').value,
          uzenet: document.getElementById('contactMessage').value.trim(),
          nyelv: 'en',
          subject: '✉️ Contact form: ' + name,
          source_url: window.location.href
        };

        try {
          await fetch(WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        } catch (err) {
          btn.disabled = false;
          btn.innerHTML = 'Try again';
          errorBox.textContent = 'We could not send your message. Please try again, or write to support@getcontentninja.com.';
          errorBox.classList.remove('hidden');
        }
      });
    })();
  </script>
</BaseLayout>
</content>
