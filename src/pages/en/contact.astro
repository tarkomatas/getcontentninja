---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { pathFor } from '../../i18n/routes';

const locale = 'en';
const page = 'contact';
const title = 'Contact – Content Ninja';
const description =
  'Get in touch with the Content Ninja team: email (support@getcontentninja.com), phone, company details and a contact form. We reply within 1 business day.';

const bookDemo = pathFor('bookDemo', locale);
const imprint = pathFor('imprint', locale);
const SUPPORT_EMAIL = 'support@getcontentninja.com';
const SUPPORT_PHONE = '+36 20 283 8831';
---

<BaseLayout locale={locale} page={page} title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Content Ninja',
      legalName: 'Digitallwork.hu Kft.',
      url: 'https://getcontentninja.com/',
      email: 'support@getcontentninja.com',
      telephone: '+36202838831',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Pálinkás Antal u. 3/A FSZ/8',
        addressLocality: 'Budapest',
        postalCode: '1118',
        addressCountry: 'HU',
      },
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'support@getcontentninja.com',
        telephone: '+36202838831',
        availableLanguage: ['hu', 'en'],
      }],
    })} />
  </Fragment>

  <Header locale={locale} page={page} />

  <!-- 1. Hero + contact form -->
  <section class="hero-gradient py-12 md:py-24 px-4 md:px-10">
    <div class="max-w-[1200px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Left: intro + direct contact details -->
        <div>
          <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Contact</span>
          <h1 class="text-4xl md:text-[2.85rem] font-extrabold leading-[1.08] tracking-[-0.03em] text-dark mb-5">
            Got a question? <span class="text-primary">Write to us</span> – we reply within 1 business day
          </h1>
          <p class="text-body text-[1.1rem] leading-relaxed max-w-[520px] mb-8">
            Tell us what your webshop sells and how we can help – by email, by phone or through the form.
            We're available on business days between 9:00 and 17:00 CET.
          </p>

          <div class="space-y-4 max-w-[520px]">
            <a href={`mailto:${SUPPORT_EMAIL}`} class="flex items-start gap-4 bg-card rounded-[16px] border border-border p-5 sm:p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
              <span class="w-12 h-12 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[22px]">mail</span>
              </span>
              <span class="min-w-0">
                <span class="block font-bold text-lg text-dark mb-1">Email</span>
                <span class="block text-primary font-semibold break-words">{SUPPORT_EMAIL}</span>
                <span class="block text-body text-sm leading-relaxed mt-1">Customer support, technical questions, billing.</span>
              </span>
            </a>

            <a href="tel:+36202838831" class="flex items-start gap-4 bg-card rounded-[16px] border border-border p-5 sm:p-8 shadow-card hover:shadow-card-hover transition-all hover:-translate-y-0.5">
              <span class="w-12 h-12 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[22px]">call</span>
              </span>
              <span class="min-w-0">
                <span class="block font-bold text-lg text-dark mb-1">Phone</span>
                <span class="block text-primary font-semibold">{SUPPORT_PHONE}</span>
                <span class="block text-body text-sm leading-relaxed mt-1">Available on business days, 9:00–17:00 CET.</span>
              </span>
            </a>

            <div class="flex items-start gap-4 bg-card rounded-[16px] border border-border p-5 sm:p-8 shadow-card">
              <span class="w-12 h-12 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[22px]">business</span>
              </span>
              <span class="min-w-0">
                <span class="block font-bold text-lg text-dark mb-1">Office</span>
                <span class="block text-body">1118 Budapest, Pálinkás Antal u. 3/A FSZ/8, Hungary</span>
                <span class="block text-body text-sm leading-relaxed mt-1">In-person meetings by prior appointment only.</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-card rounded-[16px] border border-border p-5 sm:p-8 shadow-card-hover">
          <h2 class="text-2xl font-bold text-dark mb-2">Send us a message</h2>
          <p class="text-body text-sm leading-relaxed mb-6">Fill in the form and our team will get back to you by email.</p>

          <form id="contactForm" class="space-y-4">
            <div>
              <label for="contactName" class="block text-sm font-bold text-body mb-1">Name</label>
              <input type="text" id="contactName" name="name" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="e.g. John Smith" />
            </div>

            <div>
              <label for="contactEmail" class="block text-sm font-bold text-body mb-1">Email address</label>
              <input type="email" id="contactEmail" name="email" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="e.g. john@company.com" />
            </div>

            <div>
              <label for="contactPhone" class="block text-sm font-bold text-body mb-1">Phone <span class="font-medium text-muted">(optional)</span></label>
              <input type="tel" id="contactPhone" name="phone"
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="+36 30 123 4567" />
            </div>

            <div>
              <label for="contactTopic" class="block text-sm font-bold text-body mb-1">How can we help?</label>
              <select id="contactTopic" name="topic" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all">
                <option value="" disabled selected>Choose...</option>
                <option value="General product question">General product question</option>
                <option value="Pricing, plans, billing">Pricing, plans, billing</option>
                <option value="Technical support (existing customer)">Technical support (existing customer)</option>
                <option value="Partnership, reselling">Partnership, reselling</option>
                <option value="Press, other">Press, other</option>
              </select>
            </div>

            <div>
              <label for="contactMessage" class="block text-sm font-bold text-body mb-1">Message</label>
              <textarea id="contactMessage" name="message" rows="5" required
                class="w-full rounded-[10px] border-border focus:border-primary focus:ring-primary shadow-card transition-all"
                placeholder="Briefly describe what you need. If you have a webshop, a link helps a lot."></textarea>
            </div>

            <div class="flex items-start gap-2 text-xs text-muted ml-1">
              <input type="checkbox" id="contactPrivacy" required class="mt-1 rounded text-primary focus:ring-primary" />
              <label for="contactPrivacy">
                I have read, understood and acknowledged the
                <a href="/en/privacy-policy" target="_blank" class="underline hover:text-primary">Privacy Policy</a>.
              </label>
            </div>

            <p id="contactError" class="hidden text-sm text-red-600 leading-relaxed"></p>

            <button type="submit" id="contactSubmit" class="w-full cta-primary h-12 text-base">
              <span class="material-symbols-outlined text-[18px]">send</span>
              Send message
            </button>
          </form>

          <div id="contactSuccess" class="hidden text-center py-8 space-y-4">
            <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto">
              <span class="material-symbols-outlined text-success text-3xl">check_circle</span>
            </div>
            <h3 class="text-xl font-bold text-dark">We got your message!</h3>
            <p class="text-body leading-relaxed max-w-[400px] mx-auto">
              Thanks for writing. We'll reply to the email address you provided within 1 business day.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Company details -->
  <section class="bg-card py-20 md:py-28 px-4 md:px-10">
    <div class="max-w-[900px] mx-auto">
      <div class="text-center max-w-[700px] mx-auto mb-12">
        <span class="text-primary font-bold text-sm uppercase tracking-widest block mb-3">Company details</span>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Who is behind Content Ninja?</h2>
        <p class="text-body text-lg">Content Ninja is built and operated by Digitallwork.hu Kft. in Budapest, Hungary.</p>
      </div>

      <div class="bg-light rounded-[16px] border border-border p-5 sm:p-8 shadow-card">
        <dl class="space-y-2.5 text-sm">
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Company name</dt>
            <dd class="text-dark font-medium">Digitallwork.hu Kft.</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Registered office</dt>
            <dd class="text-dark font-medium">1118 Budapest, Pálinkás Antal u. 3/A FSZ/8, Hungary</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Company reg. number</dt>
            <dd class="text-dark font-medium">01-09-426906</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Tax number</dt>
            <dd class="text-dark font-medium">32489819-2-43</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Email</dt>
            <dd><a href={`mailto:${SUPPORT_EMAIL}`} class="text-primary font-medium hover:underline">{SUPPORT_EMAIL}</a></dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Phone</dt>
            <dd><a href="tel:+36202838831" class="text-primary font-medium hover:underline">{SUPPORT_PHONE}</a></dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:gap-4">
            <dt class="text-muted w-44 shrink-0">Support hours</dt>
            <dd class="text-dark font-medium">Business days, 9:00–17:00 CET</dd>
          </div>
        </dl>
        <p class="text-xs text-muted mt-5 leading-relaxed">
          Hosting and domain provider details, along with further mandatory disclosures, are available in the
          <a href={imprint} class="underline hover:text-primary">imprint</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Closing CTA -->
  <section class="bg-primary py-16 md:py-20 px-4 md:px-10">
    <div class="max-w-[800px] mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Would you rather see the system live?</h2>
      <p class="text-white/80 text-lg mb-8">
        Book a free, ~20-minute online demo – we'll show you how it works with your own products.
      </p>
      <a href={bookDemo} class="cta-on-primary px-8 py-4 text-base">
        <span class="material-symbols-outlined text-[18px]">calendar_month</span>
        Book a demo
      </a>
    </div>
  </section>

  <Footer locale={locale} page={page} />

  <script is:inline>
    (function () {
      var form = document.getElementById('contactForm');
      if (!form) return;

      var btn = document.getElementById('contactSubmit');
      var errorBox = document.getElementById('contactError');
      var successBox = document.getElementById('contactSuccess');
      var WEBHOOK = 'https://hook.eu1.make.com/ihohtlulor66lvhouyoty9azbut7lzx7';

      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        var privacy = document.getElementById('contactPrivacy');
        if (!privacy.checked) {
          alert('Please accept the privacy policy!');
          return;
        }

        errorBox.classList.add('hidden');
        btn.disabled = true;
        btn.innerHTML = 'Sending...';

        var name = document.getElementById('contactName').value.trim();
        var payload = {
          statusz: 'kapcsolat',
          lead_forras: 'kapcsolat',
          submission_date: new Date().toISOString(),
          nev: name,
          email: document.getElementById('contactEmail').value.trim(),
          telefonszam: document.getElementById('contactPhone').value.trim(),
          tema: document.getElementById('contactTopic').value,
          uzenet: document.getElementById('contactMessage').value.trim(),
          nyelv: 'en',
          subject: '✉️ Contact form: ' + name,
          source_url: window.location.href
        };

        try {
          await fetch(WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
          successBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
        } catch (err) {
          btn.disabled = false;
          btn.innerHTML = 'Try again';
          errorBox.textContent = 'We could not send your message. Please try again, or write directly to support@getcontentninja.com.';
          errorBox.classList.remove('hidden');
        }
      });
    })();
  </script>
</BaseLayout>
</content>
